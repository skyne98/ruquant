+                                            const int32_t * __restrict__ rows, float * __restrict__ dst, int64_t dst_nb1) {
+    const int r = blockIdx.y;
+    const int w = r % n_w, seq = r / n_w;
+    const char * win = src + w * nb2 + seq * nb3;
