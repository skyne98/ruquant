+    for (int e = blockIdx.x * blockDim.x + threadIdx.x; e < ne0 * ne1; e += gridDim.x * blockDim.x) {
+        const int c = e / ne0, k = e - c * ne0;
+        out[e] = *(const float *) (win + c * nb1 + k * nb0);
+    }
+}
