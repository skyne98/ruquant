+        }
+        ((float4 *) result)[2*idx]     = make_float4(sum[0], sum[1], sum[2], sum[3]);
+        ((float4 *) result)[2*idx + 1] = make_float4(sum[4], sum[5], sum[6], sum[7]);
+    }
