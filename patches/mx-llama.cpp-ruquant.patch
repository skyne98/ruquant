+    __threadfence_system();
+    barrier_start<NRANKS>(sg, self_sg, rank);
+
+    const uint4 * own = (const uint4 *) dp.ptrs[rank];
+    for (int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; idx < n8; idx += (int64_t) gridDim.x * blockDim.x) {
