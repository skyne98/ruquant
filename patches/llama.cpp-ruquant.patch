diff --git a/ggml/src/ggml-cuda/rq-w4a4-gemm.cuh b/ggml/src/ggml-cuda/rq-w4a4-gemm.cuh
new file mode 100644
index 0000000..eb4b9d1
--- /dev/null
+++ b/ggml/src/ggml-cuda/rq-w4a4-gemm.cuh
@@ -0,0 +1,193 @@
+#pragma once
+// ruquant W4A4 GEMM for prefill widths, shaped for gfx906 (no matrix unit: v_dot8_i32_i4 on VGPRs).
+// A workgroup of 256 threads owns 128 channels x 64 tokens and runs its slice of K one tile of 8 code words (64
+// inputs, the smallest activation group) at a time. Everything a tile needs goes through LDS, double buffered and
+// fetched a tile ahead: the code words, and the group terms already decoded (8 - z and m per token, colsum and the
+// block multiplier k per channel). Each thread multiplies 4 channels by 8 tokens from registers (per word one 16 B
+// weight read and two 16 B activation reads for 32 dot8s). The integer math is the skinny kernel's
+// (rq-w4a4-skinny.cuh): per activation group sum = (8 - z) colsum + code products, tot += (k m sum) >> RQ_TERM_SHIFT,
+// so the result is bit-exact with the CPU reference. Split-K (gridDim.z > 1) adds int32 partials atomically
+// (exact in any order) and the last workgroup of a tile writes it out.
+#include "rq-w4a4-skinny.cuh"
+
+constexpr int RQ_GEMM_BN      = 128; // channels per workgroup
+constexpr int RQ_GEMM_BT      = 64;  // tokens per workgroup
+constexpr int RQ_GEMM_KT      = 8;   // code words per K tile
+constexpr int RQ_GEMM_THREADS = 256;
+
+// pins 8 values in registers at this point of the program (an empty volatile asm that reads and writes them)
+static __device__ __forceinline__ void rq_keep8(int (&x)[8]) {
+#if defined(GGML_USE_HIP) && defined(__HIP_DEVICE_COMPILE__)
+    asm volatile("" : "+v"(x[0]), "+v"(x[1]), "+v"(x[2]), "+v"(x[3]), "+v"(x[4]), "+v"(x[5]), "+v"(x[6]), "+v"(x[7]));
+#else
+    asm volatile("" : "+r"(x[0]), "+r"(x[1]), "+r"(x[2]), "+r"(x[3]), "+r"(x[4]), "+r"(x[5]), "+r"(x[6]), "+r"(x[7]));
+#endif
+}
+
+struct rq_gemm_stage {
+    int32_t w[RQ_GEMM_KT][RQ_GEMM_BN]; // code words, word-major
+    int32_t a[RQ_GEMM_KT][RQ_GEMM_BT];
+    int32_t zc[RQ_GEMM_BT];            // 8 - z_g per token
+    int32_t m[RQ_GEMM_BT];             // m_g per token
+    int32_t cs[RQ_GEMM_BN];            // colsum_g per channel
+    int32_t kb[RQ_GEMM_BN];            // k_b per channel
+};
+
+// Aq [Mp][Kw] token-major codes, mz [K / G][Mp] (m_g | z_g << 8), sa [Mp]: Mp a multiple of RQ_GEMM_BT, rows past M
+// are read but never written out. Wt in the rq_wt_index layout, sw [N], colsum [K / G][N], wk [K / 64][N], D [M][ldd].
+// GSH: log2 of the K tiles per activation group (G / 64); kz: K tiles per split (a multiple of a group). N a
+// multiple of RQ_GEMM_BN;
+// grid (N / RQ_GEMM_BN, Mp / RQ_GEMM_BT, splits). With splits, acc [Mp][N] and cnt [tiles] start at zero.
+template <int GSH>
+static __global__ void __launch_bounds__(RQ_GEMM_THREADS)
+rq_gemm_kernel(const int32_t * __restrict__ Aq, const int32_t * __restrict__ mz, const float * __restrict__ sa,
+               const int32_t * __restrict__ Wt, const float * __restrict__ sw, const int16_t * __restrict__ colsum,
+               const int8_t * __restrict__ wk, float * __restrict__ D, int ldd, int N, int M, int Mp, int Kw, int kz,
+               int32_t * __restrict__ acc, int32_t * __restrict__ cnt) {
+    __shared__ rq_gemm_stage st[2];
+    constexpr int gt = 1 << GSH;
+    const int tid = threadIdx.x, wid = rq_wave_id();
+    const int n0 = blockIdx.x * RQ_GEMM_BN, t0 = blockIdx.y * RQ_GEMM_BT;
+    const int cq = tid % 32, tq = tid / 32; // this thread's outputs: channels n0 + 4 cq + c, tokens t0 + 8 tq + t
+    const int k_lo = blockIdx.z * kz, k_hi = min(k_lo + kz, Kw / RQ_GEMM_KT);
+
+    // per tile, each thread fetches 4 weight words (channel group gi, step si, lane li of the rq_wt_index layout),
+    // 2 activation words (token at, words aw, aw + 1) and one group term: threads 0..127 a channel's colsum and k,
+    // 128..191 a token's m | z << 8 (split by wave, so the addresses stay scalar)
+    const int li = tid % RQ_WAVE, si = (tid / RQ_WAVE) % 2, gi = tid / (2 * RQ_WAVE);
+    const rq_words<RQ_KW> * wsrc = reinterpret_cast<const rq_words<RQ_KW> *>(Wt) +
+                                   ((size_t) (n0 / RQ_WAVE + gi) * (Kw / RQ_KW) + si) * RQ_WAVE + li;
+    const int wn = gi * RQ_WAVE + li;
+    const int at = tid / 4, aw = 2 * (tid % 4);
+    const int2 * asrc = reinterpret_cast<const int2 *>(Aq + (size_t) (t0 + at) * Kw + aw);
+
+    rq_words<RQ_KW> wv;
+    int2 av;
+    int p0 = 0, p1 = 0;
+#define RQ_GEMM_FETCH(kt_)                                                          \
+    do {                                                                            \
+        wv = wsrc[(size_t) (kt_) * 2 * RQ_WAVE];                                    \
+        av = asrc[(kt_) * RQ_GEMM_KT / 2];                                          \
+        if (wid < RQ_GEMM_BN / RQ_WAVE) {                                           \
+            p0 = colsum[(size_t) ((kt_) >> GSH) * N + n0 + tid];                    \
+            p1 = wk[(size_t) (kt_) * N + n0 + tid];                                 \
+        } else if (wid < (RQ_GEMM_BN + RQ_GEMM_BT) / RQ_WAVE) {                     \
+            p0 = mz[(size_t) ((kt_) >> GSH) * Mp + t0 + tid - RQ_GEMM_BN];          \
+        }                                                                           \
+    } while (0)
+#define RQ_GEMM_STASH(s_)                                                           \
+    do {                                                                            \
+        _Pragma("unroll") for (int i = 0; i < 4; ++i) (s_).w[si * 4 + i][wn] = wv.v[i]; \
+        (s_).a[aw][at] = av.x;                                                      \
+        (s_).a[aw + 1][at] = av.y;                                                  \
+        if (wid < RQ_GEMM_BN / RQ_WAVE) {                                           \
+            (s_).cs[tid] = p0;                                                      \
+            (s_).kb[tid] = p1;                                                      \
+        } else if (wid < (RQ_GEMM_BN + RQ_GEMM_BT) / RQ_WAVE) {                     \
+            (s_).zc[tid - RQ_GEMM_BN] = 8 - (p0 >> 8);                              \
+            (s_).m[tid - RQ_GEMM_BN] = p0 & 0xff;                                   \
+        }                                                                           \
+    } while (0)
+
+    int sum[4][8], tot[4][8];
+#pragma unroll
+    for (int c = 0; c < 4; ++c)
+#pragma unroll
+        for (int t = 0; t < 8; ++t) sum[c][t] = tot[c][t] = 0;
+
+    if (k_lo < k_hi) {
+        RQ_GEMM_FETCH(k_lo);
+        RQ_GEMM_STASH(st[0]);
+    }
+    __syncthreads();
+    for (int kt = k_lo; kt < k_hi; ++kt) {
+        const rq_gemm_stage & s = st[(kt - k_lo) & 1];
+        const bool more = kt + 1 < k_hi;
+        if (more) RQ_GEMM_FETCH(kt + 1); // in flight while this tile runs
+        if ((kt & (gt - 1)) == 0) { // a group starts: its zero-point term
+            const int4 c4 = *reinterpret_cast<const int4 *>(&s.cs[4 * cq]);
+            const int4 z0 = *reinterpret_cast<const int4 *>(&s.zc[8 * tq]);
+            const int4 z1 = *reinterpret_cast<const int4 *>(&s.zc[8 * tq + 4]);
+            const int cs[4] = { c4.x, c4.y, c4.z, c4.w };
+            const int zc[8] = { z0.x, z0.y, z0.z, z0.w, z1.x, z1.y, z1.z, z1.w };
+#pragma unroll
+            for (int c = 0; c < 4; ++c)
+#pragma unroll
+                for (int t = 0; t < 8; ++t) sum[c][t] = __mul24(zc[t], cs[c]);
+        }
+        // one word ahead: word j + 1's LDS reads are in flight during word j's dot8s. The fences keep the compiler
+        // from hoisting all of them and sinking the dot8s to the fold (it did, at G = 64: 200 VGPRs, one wave per
+        // SIMD): the sums pinned per word, sched_barrier for the machine scheduler, the empty asm for the IR passes
+        int4 w = *reinterpret_cast<const int4 *>(&s.w[0][4 * cq]);
+        int4 a0 = *reinterpret_cast<const int4 *>(&s.a[0][8 * tq]);
+        int4 a1 = *reinterpret_cast<const int4 *>(&s.a[0][8 * tq + 4]);
+#pragma unroll
+        for (int j = 0; j < RQ_GEMM_KT; ++j) {
+            const int jn = j + 1 < RQ_GEMM_KT ? j + 1 : j;
+            const int4 wn  = *reinterpret_cast<const int4 *>(&s.w[jn][4 * cq]);
+            const int4 a0n = *reinterpret_cast<const int4 *>(&s.a[jn][8 * tq]);
+            const int4 a1n = *reinterpret_cast<const int4 *>(&s.a[jn][8 * tq + 4]);
+            const int wc[4] = { w.x, w.y, w.z, w.w };
+            const int a8[8] = { a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w };
+#pragma unroll
+            for (int c = 0; c < 4; ++c)
+#pragma unroll
+                for (int t = 0; t < 8; ++t) sum[c][t] = rq_dot8(a8[t], wc[c], sum[c][t]);
+#pragma unroll
+            for (int c = 0; c < 4; ++c) rq_keep8(sum[c]);
+            rq_block_fence();
+            asm volatile("" ::: "memory");
+            w = wn;
+            a0 = a0n;
+            a1 = a1n;
+        }
+        if (((kt + 1) & (gt - 1)) == 0) { // the group ends: fold it in
+            const int4 k4 = *reinterpret_cast<const int4 *>(&s.kb[4 * cq]);
+            const int4 m0 = *reinterpret_cast<const int4 *>(&s.m[8 * tq]);
+            const int4 m1 = *reinterpret_cast<const int4 *>(&s.m[8 * tq + 4]);
+            // narrowed (k 1..15, m 1..255), so k m is a known 24-bit product: unnarrowed, the outer __mul24 cost a
+            // quarter-rate multiply (an inline-asm fold without the compiler's extra shift per output was slower)
+            const int kb[4] = { k4.x & 0x7fff, k4.y & 0x7fff, k4.z & 0x7fff, k4.w & 0x7fff };
+            const int m[8] = { m0.x & 0xff, m0.y & 0xff, m0.z & 0xff, m0.w & 0xff, m1.x & 0xff, m1.y & 0xff, m1.z & 0xff, m1.w & 0xff };
+#pragma unroll
+            for (int c = 0; c < 4; ++c)
+#pragma unroll
+                for (int t = 0; t < 8; ++t) tot[c][t] += __mul24(kb[c] * m[t], sum[c][t]) >> RQ_TERM_SHIFT;
+        }
+        if (more) RQ_GEMM_STASH(st[(kt + 1 - k_lo) & 1]);
+        __syncthreads();
+    }
+
+    if (gridDim.z > 1) { // split-K: add the partial sums; the last workgroup of the tile writes them out
+        int32_t * at_ = acc + (size_t) (t0 + 8 * tq) * N + n0 + 4 * cq;
+#pragma unroll
+        for (int t = 0; t < 8; ++t)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) atomicAdd(at_ + (size_t) t * N + c, tot[c][t]);
+        __threadfence();
+        __shared__ int last;
+        __syncthreads();
+        if (tid == 0) last = atomicAdd(&cnt[blockIdx.y * gridDim.x + blockIdx.x], 1) == (int) gridDim.z - 1;
+        __syncthreads();
+        if (!last) return;
+        __threadfence();
+#pragma unroll
+        for (int t = 0; t < 8; ++t)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) tot[c][t] = rq_load_l2(at_ + (size_t) t * N + c);
+    }
+#pragma unroll
+    for (int t = 0; t < 8; ++t) {
+        const int tok = t0 + 8 * tq + t;
+        if (tok >= M) break;
+        const float u = sa[tok];
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            const int n = n0 + 4 * cq + c;
+            D[(size_t) tok * ldd + n] =
+                __fmul_rn(__fmul_rn(__fmul_rn(__int2float_rn(tot[c][t]), (float) (1 << RQ_TERM_SHIFT)), u), sw[n]);
+        }
+    }
+#undef RQ_GEMM_FETCH
+#undef RQ_GEMM_STASH
+}
diff --git a/ggml/src/ggml-cuda/rq-w4a4-skinny.cuh b/ggml/src/ggml-cuda/rq-w4a4-skinny.cuh
new file mode 100644
index 0000000..ef2eea0
--- /dev/null
+++ b/ggml/src/ggml-cuda/rq-w4a4-skinny.cuh
@@ -0,0 +1,315 @@
+#pragma once
+// ruquant skinny W4A4 GEMM for decode / speculative-verify widths (T = 1..64 tokens), shaped for gfx906
+// (from ruquant's gfx906/w4a4_skinny.h, measured on MI50).
+//
+// gfx906 has no matrix unit, so every instruction that is not v_dot8_i32_i4 takes a VALU slot that could
+// have done 8 multiply-adds. The inner loop is therefore weight loads + dot8 only:
+//   - each lane owns one output channel per channel group (R groups per wave): no cross-lane reduction;
+//   - activations are wave-uniform, so they come in through scalar loads and feed dot8 from SGPRs. They are
+//     stored step-major so one step's T*KA words are contiguous;
+//   - weights are repacked (once, in place, on first use) so a wave's load is one contiguous 16 B/lane run;
+//   - split-K in two levels: the waves of a workgroup reduce through LDS, workgroups add int32 partials
+//     atomically. Integer adds are exact, so the result is bit-exact with the CPU reference.
+// On CUDA (wave = 32, dot8 emulated) the same source runs on the 3090 to check the indexing (RQ_SKINNY=1).
+#include <stddef.h>
+#include <stdint.h>
+
+#if defined(GGML_USE_HIP)
+#define RQ_WAVE 64
+static __device__ __forceinline__ int rq_dot8(int a, int b, int c) {
+#if defined(__gfx906__)
+    return __builtin_amdgcn_sdot8(a, b, c, false); // v_dot8_i32_i4
+#else
+#pragma unroll
+    for (int j = 0; j < 8; ++j) c += ((a << (28 - 4 * j)) >> 28) * ((b << (28 - 4 * j)) >> 28);
+    return c;
+#endif
+}
+// Without this the scheduler hoists every token block's s_loads to the top of the step, which needs more
+// SGPRs than a wave has and spills them through v_writelane/v_readlane.
+static __device__ __forceinline__ void rq_block_fence() {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_amdgcn_sched_barrier(0);
+#endif
+}
+// wave index in an SGPR, so per-wave K offsets keep the activation loads scalar
+static __device__ __forceinline__ int rq_wave_id() {
+#if defined(__HIP_DEVICE_COMPILE__)
+    return __builtin_amdgcn_readfirstlane(threadIdx.x / RQ_WAVE);
+#else
+    return threadIdx.x / RQ_WAVE;
+#endif
+}
+#else
+#define RQ_WAVE 32
+static __device__ __forceinline__ int rq_dot8(int a, int b, int c) {
+#pragma unroll
+    for (int j = 0; j < 8; ++j) c += ((a << (28 - 4 * j)) >> 28) * ((b << (28 - 4 * j)) >> 28);
+    return c;
+}
+static __device__ __forceinline__ void rq_block_fence() {}
+static __device__ __forceinline__ int rq_wave_id() { return threadIdx.x / RQ_WAVE; }
+#endif
+
+// a load that skips the (non-coherent) L1, for data other workgroups just wrote
+static __device__ __forceinline__ int32_t rq_load_l2(const int32_t * p) {
+#if defined(GGML_USE_HIP)
+    return __builtin_nontemporal_load(p);
+#else
+    return __ldcg(p);
+#endif
+}
+
+template <int N> struct alignas(16) rq_words {
+    int32_t v[N];
+};
+
+// Weights, 4 k-words (32 int4) per lane per step: Wt[group][step][lane][4], group = channel / RQ_WAVE
+constexpr int RQ_KW = 4;
+static __host__ __device__ __forceinline__ size_t rq_wt_index(int channel, int k_word, int Kw) {
+    const int group = channel / RQ_WAVE, lane = channel % RQ_WAVE;
+    return (((size_t) group * (Kw / RQ_KW) + k_word / RQ_KW) * RQ_WAVE + lane) * RQ_KW + k_word % RQ_KW;
+}
+
+// Verify-width presets: R channel groups per wave, KA activation words per token per chunk, TB tokens per
+// scalar load. Picked from the gfx906 asm: fewest instructions per dot8 without SGPR spills.
+template <int T> struct rq_cfg;
+template <> struct rq_cfg<1>  { static constexpr int R = 4, KA = 4, TB = 1; };
+template <> struct rq_cfg<2>  { static constexpr int R = 4, KA = 4, TB = 2; };
+template <> struct rq_cfg<4>  { static constexpr int R = 4, KA = 4, TB = 4; };
+template <> struct rq_cfg<8>  { static constexpr int R = 2, KA = 4, TB = 8; };
+template <> struct rq_cfg<16> { static constexpr int R = 2, KA = 4, TB = 16; };
+template <> struct rq_cfg<24> { static constexpr int R = 1, KA = 1, TB = 24; };
+template <> struct rq_cfg<32> { static constexpr int R = 1, KA = 1, TB = 32; };
+template <> struct rq_cfg<48> { static constexpr int R = 1, KA = 1, TB = 24; };
+template <> struct rq_cfg<64> { static constexpr int R = 1, KA = 1, TB = 32; };
+
+// Activations, step-major: Ac[chunk][t][KA], chunk = k_word / KA
+static __host__ __device__ __forceinline__ size_t rq_act_index(int t, int k_word, int T, int KA) {
+    return ((size_t) (k_word / KA) * T + t) * KA + k_word % KA;
+}
+
+// Activation groups (ggml-quants.c, rq_quantize_row_a): each G activations of a token (G = 32 << gsh: 256, 128 or 64)
+// have a zero point z_g and a scale m_g * u, m_g an integer, so the dot product is the exact integer total =
+// sum_g k_b * m_g * (acc_g + (8 - z_g) * colsum_g), k_b the integer multiplier of the weight block (256 inputs)
+// holding group g. The spec epilogue, fused:
+// y = ((fp32(total) * 16) * u) * s_w into D [M][ldd], for the M real tokens. Each group's term k m S fits int32
+// (|S| <= 2^15, k m <= 3825) and goes into the total as term >> RQ_TERM_SHIFT, so the total stays in int32 for any
+// input (rotated massive activations against aligned rows passed 2^31 unshifted). With split-K (gridDim.y > 1) the workgroups add into acc [M][N] in L2 (integers: any order is exact) and bump
+// cnt[blockIdx.x]; the last one to arrive reads the totals and writes D. acc and cnt start at zero (the activation
+// quantizer clears them).
+struct rq_epi {
+    const float * s_a;      // u per token
+    const int32_t * mul;    // m_g | z_g << 8, [K / 256][T]
+    const float * sw;
+    const int16_t * colsum; // [K / G][N]
+    const int8_t * wk;      // weight multipliers k per 64 inputs, [K / 64][N]
+    float * D;
+    int ldd;
+    int M;
+    int32_t * cnt;
+};
+
+static __device__ __forceinline__ float rq_epi_value(const rq_epi & e, int32_t acc, int t, int n) {
+    return __fmul_rn(__fmul_rn(__fmul_rn(__int2float_rn(acc), (float) (1 << RQ_TERM_SHIFT)), e.s_a[t]), e.sw[n]);
+}
+
+// One weight matrix of a launch. Up to three matrices that read the same activation (gate and up, ...) share a
+// launch, each over its own range of workgroups along x, so a workgroup's job is uniform.
+struct rq_job {
+    const int32_t * Wt;
+    int32_t * acc; // split-K sums [M][N]
+    int N;
+    int nblk;      // workgroups along x: N / (RQ_WAVE * R)
+    rq_epi epi;
+};
+struct rq_jobs {
+    rq_job j[3];
+    int n;
+    int gsh; // steps (of RQ_KW words) per activation group, log2
+};
+
+template <int T, int R> constexpr size_t rq_lds_bytes(int W) {
+    return W > 1 ? (size_t) R * T * RQ_WAVE * sizeof(int32_t) : 0;
+}
+
+// Ac: activation words (element 8w+j in bits [4j+3:4j], stored as q-8), rq_act_index
+// per job: Wt weight words (rq_wt_index), acc [M][N] int32 split-K sums (gridDim.y > 1), epi the fused epilogue.
+// grid (sum of the jobs' nblk, ceil(Kw / kw_split)), block RQ_WAVE*W (W <= 8), rq_lds_bytes<T, R>(W) dynamic
+// LDS; Kw and kw_split multiples of an activation group (RQ_KW << jobs.gsh words).
+// PF: activations one token block ahead, from T = 24 where a block is only 32 dot8s.
+template <int T, int R, int KA = rq_cfg<T>::KA, int TB = rq_cfg<T>::TB, bool PF = (T >= 24 && TB * KA <= 32)>
+static __global__ void __launch_bounds__(RQ_WAVE * 8)
+rq_skinny_kernel(const int32_t * __restrict__ Ac, const rq_jobs jobs, int Kw, int kw_split) {
+    static_assert(RQ_KW % KA == 0 && T % TB == 0, "bad preset");
+    int bx = blockIdx.x, ji = 0;
+    if (bx >= jobs.j[0].nblk) {
+        bx -= jobs.j[0].nblk;
+        ji = 1;
+        if (bx >= jobs.j[1].nblk) {
+            bx -= jobs.j[1].nblk;
+            ji = 2;
+        }
+    }
+    // field by field with uniform selects: indexing the argument array would copy it to scratch
+#define RQ_JOB(f) (ji == 0 ? jobs.j[0].f : ji == 1 ? jobs.j[1].f : jobs.j[2].f)
+    const int32_t * __restrict__ Wt = RQ_JOB(Wt);
+    int32_t * __restrict__ acc = RQ_JOB(acc);
+    const int N = RQ_JOB(N);
+    const rq_epi epi = { RQ_JOB(epi.s_a), RQ_JOB(epi.mul), RQ_JOB(epi.sw), RQ_JOB(epi.colsum), RQ_JOB(epi.wk),
+                         RQ_JOB(epi.D), RQ_JOB(epi.ldd), RQ_JOB(epi.M), RQ_JOB(epi.cnt) };
+#undef RQ_JOB
+    constexpr int CHUNKS = RQ_KW / KA;
+    constexpr int NB = CHUNKS * (T / TB); // token blocks per step
+    const int lane = threadIdx.x % RQ_WAVE;
+    const int wave = rq_wave_id(), W = blockDim.x / RQ_WAVE;
+    const int g0 = bx * R;
+    const int wg_begin = blockIdx.y * kw_split;
+    const int wg_steps = (min(wg_begin + kw_split, Kw) - wg_begin) / RQ_KW;
+    const int per_wave = (((wg_steps >> jobs.gsh) + W - 1) / W) << jobs.gsh; // whole activation groups
+    const int s_lo = min(wave * per_wave, wg_steps);
+    const int steps = min(s_lo + per_wave, wg_steps) - s_lo;
+    const int w_begin = wg_begin + s_lo * RQ_KW;
+
+    const rq_words<RQ_KW> * wp[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        wp[r] = reinterpret_cast<const rq_words<RQ_KW> *>(Wt) +
+                ((size_t) (g0 + r) * (Kw / RQ_KW) + w_begin / RQ_KW) * RQ_WAVE + lane;
+    }
+    const rq_words<TB * KA> * ap = reinterpret_cast<const rq_words<TB * KA> *>(Ac) + (size_t) (w_begin / KA) * (T / TB);
+
+    // sum: the current activation group's code products; tot: the groups so far, each times its multipliers.
+    // Every factor fits 24 bits, so the products are __mul24 (gfx906: v_mul_lo_u32 is quarter rate).
+    int sum[R][T], tot[R][T];
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int t = 0; t < T; ++t) sum[r][t] = tot[r][t] = 0;
+    const int gstep0 = w_begin / RQ_KW; // a group is 1 << gsh steps
+    const int gsh = jobs.gsh, gmask = (1 << gsh) - 1;
+    int kw[R]; // the current weight block's multiplier, per channel group (a block is 8 steps)
+#pragma unroll
+    for (int r = 0; r < R; ++r) kw[r] = steps > 0 ? epi.wk[(size_t) (gstep0 >> 1) * N + (g0 + r) * RQ_WAVE + lane] : 0;
+
+    // software pipeline: the next step's weights are in flight while this step's dot8s run
+    rq_words<RQ_KW> cur[R], nxt[R];
+    if (steps > 0)
+#pragma unroll
+        for (int r = 0; r < R; ++r) cur[r] = wp[r][0];
+
+    const int nblocks = steps * NB;
+    rq_words<TB * KA> a_cur;
+    if (PF && steps > 0) a_cur = ap[0];
+
+    for (int s = 0; s < steps; ++s) {
+        if (((gstep0 + s) & gmask) == 0) { // a group starts: its zero-point term
+            const int g = (gstep0 + s) >> gsh;
+            const int32_t * mz = epi.mul + (size_t) g * T;
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                const int cs = epi.colsum[(size_t) g * N + (g0 + r) * RQ_WAVE + lane];
+                kw[r] = epi.wk[(size_t) ((gstep0 + s) >> 1) * N + (g0 + r) * RQ_WAVE + lane];
+#pragma unroll
+                for (int t = 0; t < T; ++t) sum[r][t] = __mul24(8 - (mz[t] >> 8), cs);
+            }
+        }
+        const int s_next = s + 1 < steps ? s + 1 : s; // last step re-reads, no branch
+#pragma unroll
+        for (int r = 0; r < R; ++r) nxt[r] = wp[r][(size_t) s_next * RQ_WAVE];
+
+#pragma unroll
+        for (int q = 0; q < NB; ++q) {
+            const int c = q / (T / TB), b = q % (T / TB);
+            const int qi = s * NB + q;
+            rq_words<TB * KA> a, a_nxt;
+            if (PF) {
+                a = a_cur;
+                sum[0][b * TB] = rq_dot8(a.v[0], cur[0].v[c * KA], sum[0][b * TB]);
+                rq_block_fence();
+                a_nxt = ap[qi + 1 < nblocks ? qi + 1 : qi]; // last block re-reads, no branch
+            } else {
+                a = ap[qi];
+            }
+#pragma unroll
+            for (int tt = 0; tt < TB; ++tt)
+#pragma unroll
+                for (int r = 0; r < R; ++r)
+#pragma unroll
+                    for (int j = 0; j < KA; ++j) {
+                        if (PF && tt == 0 && r == 0 && j == 0) continue; // done above
+                        const int t = b * TB + tt;
+                        sum[r][t] = rq_dot8(a.v[tt * KA + j], cur[r].v[c * KA + j], sum[r][t]);
+                    }
+            rq_block_fence();
+            if (PF) a_cur = a_nxt;
+        }
+#pragma unroll
+        for (int r = 0; r < R; ++r) cur[r] = nxt[r];
+        if (s == steps - 1 || ((gstep0 + s + 1) & gmask) == 0) { // a group ends here (or this wave's part of it)
+            const int32_t * mg = epi.mul + (size_t) ((gstep0 + s) >> gsh) * T;
+#pragma unroll
+            for (int t = 0; t < T; ++t) {
+                const int m = mg[t] & 0xff;
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    // full-rate 24-bit ops: k * m <= 15 * 255, |sum| <= 2^15
+                    tot[r][t] += __mul24(__mul24(kw[r], m), sum[r][t]) >> RQ_TERM_SHIFT;
+                    sum[r][t] = 0;
+                }
+            }
+        }
+    }
+
+    // reduce the workgroup's K slices in one LDS buffer: wave 0 stores, the other waves add atomically
+    extern __shared__ int32_t rq_lds[];
+    if (W > 1) {
+        if (wave == 0)
+#pragma unroll
+            for (int r = 0; r < R; ++r)
+#pragma unroll
+                for (int t = 0; t < T; ++t) rq_lds[(r * T + t) * RQ_WAVE + lane] = tot[r][t];
+        __syncthreads();
+        if (wave > 0)
+#pragma unroll
+            for (int r = 0; r < R; ++r)
+#pragma unroll
+                for (int t = 0; t < T; ++t) atomicAdd(&rq_lds[(r * T + t) * RQ_WAVE + lane], tot[r][t]);
+        __syncthreads();
+        if (wave == 0)
+#pragma unroll
+            for (int r = 0; r < R; ++r)
+#pragma unroll
+                for (int t = 0; t < T; ++t) tot[r][t] = rq_lds[(r * T + t) * RQ_WAVE + lane];
+    }
+    if (wave != 0) return;
+    if (gridDim.y == 1) {
+#pragma unroll
+        for (int r = 0; r < R; ++r)
+#pragma unroll
+            for (int t = 0; t < T; ++t) {
+                const int n = (g0 + r) * RQ_WAVE + lane;
+                if (t < epi.M) epi.D[(size_t) t * epi.ldd + n] = rq_epi_value(epi, tot[r][t], t, n);
+            }
+        return;
+    }
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int t = 0; t < T; ++t) {
+            if (t < epi.M) atomicAdd(&acc[(size_t) t * N + (g0 + r) * RQ_WAVE + lane], tot[r][t]);
+        }
+    __threadfence();
+    int prev = 0;
+    if (lane == 0) prev = atomicAdd(&epi.cnt[bx], 1);
+    prev = __shfl_sync(0xffffffff, prev, 0, RQ_WAVE);
+    if (prev != (int) gridDim.y - 1) return;
+    __threadfence();
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int t = 0; t < T; ++t) {
+            const int n = (g0 + r) * RQ_WAVE + lane;
+            if (t < epi.M) epi.D[(size_t) t * epi.ldd + n] = rq_epi_value(epi, rq_load_l2(&acc[(size_t) t * N + n]), t, n);
+        }
+}
diff --git a/ggml/src/ggml-cuda/rq-w4a4.cu b/ggml/src/ggml-cuda/rq-w4a4.cu
new file mode 100644
index 0000000..9c11a85
--- /dev/null
+++ b/ggml/src/ggml-cuda/rq-w4a4.cu
@@ -0,0 +1,689 @@
+#include "rq-w4a4.cuh"
+#if defined(GGML_USE_HIP)
+#pragma clang fp contract(off) // the _rn intrinsics below are plain ops on HIP: keep mul + add unfused
+#endif
+#include "rq-w4a4-skinny.cuh"
+#include "rq-w4a4-gemm.cuh"
+
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+extern "C" float ggml_rq_act_clip_for(float tensor_clip, bool hadamard); // ggml-quants.c
+extern "C" int   ggml_rq_act_group(void);                                // ggml-quants.c
+extern "C" int64_t ggml_rq_rot_check(int32_t n, int64_t k);              // ggml-quants.c
+
+// ruquant W4A4 on CUDA and HIP. Numerics follow the CPU reference in ggml-quants.c op for op (explicit _rn
+// intrinsics, same Hadamard summation order, exact integer accumulation over the activation groups), so CPU and GPU
+// give identical outputs. The GEMM is the skinny kernel (rq-w4a4-skinny.cuh) at verify widths and the tiled one
+// (rq-w4a4-gemm.cuh) at prefill widths.
+
+// same factorization as ggml_rq_hadamard_factor (ggml-quants.c)
+static bool rq_factor(int64_t n, int & p, int & m) {
+    for (int pp = 1; pp <= 128 && pp <= n; ++pp) {
+        if (pp > 1) {
+            if (pp % 4 != 0 || (pp - 1) % 4 != 3) continue;
+            bool prime = pp - 1 >= 2;
+            for (int d = 2; d * d <= pp - 1; ++d) if ((pp - 1) % d == 0) { prime = false; break; }
+            if (!prime) continue;
+        }
+        if (n % pp != 0) continue;
+        const int64_t mm = n / pp;
+        if (mm & (mm - 1)) continue;
+        p = pp;
+        m = (int) mm;
+        return true;
+    }
+    return false;
+}
+
+// ---------------------------------------------------------------------------- online Hadamard
+// Sylvester over each chunk of m, from src (row stride lds) into x (row stride ldx), then x *= scale if there is
+// no Paley stage
+static __global__ void rq_fwht_kernel(const float * __restrict__ src, int lds, float * __restrict__ x, int ldx, int m, int p,
+                                      float scale) {
+    extern __shared__ float buf[];
+    const float * in = src + (size_t) blockIdx.x * lds + (size_t) blockIdx.y * m;
+    float * row = x + (size_t) blockIdx.x * ldx + (size_t) blockIdx.y * m;
+    for (int i = threadIdx.x; i < m; i += blockDim.x) buf[i] = in[i];
+    for (int h = 1; h < m; h <<= 1) {
+        __syncthreads();
+        for (int t = threadIdx.x; t < m / 2; t += blockDim.x) {
+            const int j = (t / h) * 2 * h + (t % h);
+            const float a = buf[j], b = buf[j + h];
+            buf[j]     = __fadd_rn(a, b);
+            buf[j + h] = __fsub_rn(a, b);
+        }
+    }
+    __syncthreads();
+    for (int i = threadIdx.x; i < m; i += blockDim.x) row[i] = p == 1 ? __fmul_rn(buf[i], scale) : buf[i];
+}
+
+// Paley across the p chunks: y[a] = sum_i x[i] A[i][a], i ascending from 0, then *= scale.
+// A = I + S with S[0][j>0] = 1, S[i>0][0] = -1, S[i][j] = chi(j - i mod q). One thread per column j.
+static __global__ void rq_paley_kernel(float * __restrict__ x, int ldx, int m, int p, float scale) {
+    __shared__ int8_t chi[128];
+    const int q = p - 1;
+    for (int i = threadIdx.x; i < q; i += blockDim.x) chi[i] = i == 0 ? 0 : -1;
+    __syncthreads();
+    if (threadIdx.x == 0) for (int i = 1; i < q; ++i) chi[(i * i) % q] = 1;
+    __syncthreads();
+    const int j = blockIdx.y * blockDim.x + threadIdx.x;
+    if (j >= m) return;
+    float * row = x + (size_t) blockIdx.x * ldx;
+    float col[128];
+    for (int i = 0; i < p; ++i) col[i] = row[(size_t) i * m + j];
+    for (int a = 0; a < p; ++a) {
+        float acc = 0.0f;
+        for (int i = 0; i < p; ++i) {
+            const int s = i == 0 ? (a == 0 ? 0 : 1) : (a == 0 ? -1 : chi[((a - i) % q + q) % q]);
+            const int e = (i == a ? 1 : 0) + s;
+            acc = e > 0 ? __fadd_rn(acc, col[i]) : __fsub_rn(acc, col[i]);
+        }
+        row[(size_t) a * m + j] = __fmul_rn(acc, scale);
+    }
+}
+
+// The same, spread out: a block holds 64 columns of all P chunks in LDS and each of its 4 waves sums one output
+// row over i ascending, so the bits match. Row a's signs come from rq_paley_masks (bit i set: subtract term i), and
+// a subtraction is an add of the sign-flipped value (a + (-b) is exactly a - b), so a term is an XOR and an add:
+// recomputing chi((a - i) mod q) per term made this VALU-bound (17408 = 68 x 256 at 6 tokens: 26 us). Out of place:
+// other blocks still read the rows a block writes. grid (M, m / 64, P / 4), 256 threads; m a multiple of 64.
+template <int P>
+static __global__ void __launch_bounds__(256) rq_paley_rows_kernel(const float * __restrict__ x, float * __restrict__ y,
+                                                                   const uint32_t * __restrict__ masks, int ldx, int m,
+                                                                   float scale) {
+    static_assert(P % 4 == 0 && P <= 96, "four output rows per block, three mask words per row");
+    __shared__ float tile[P][64];
+    const int t = threadIdx.x;
+    const size_t off = (size_t) blockIdx.x * ldx + blockIdx.y * 64;
+    const int jl = t % 64;
+    // a constant trip count, so all P / 4 loads are in flight at once
+#pragma unroll
+    for (int r = 0; r < P / 4; ++r) tile[r * 4 + t / 64][jl] = x[off + (size_t) (r * 4 + t / 64) * m + jl];
+    __syncthreads();
+    int a = blockIdx.z * 4 + t / 64;
+#if defined(GGML_USE_HIP)
+    a = __builtin_amdgcn_readfirstlane(a); // wave-uniform, so the masks come in as scalar loads
+#endif
+    const uint32_t mw[3] = { masks[3 * a], masks[3 * a + 1], masks[3 * a + 2] };
+    float acc = 0.0f;
+#pragma unroll
+    for (int i = 0; i < P; ++i) {
+        const uint32_t flip = ((mw[i / 32] >> (i % 32)) & 1u) << 31;
+        acc = acc + __uint_as_float(__float_as_uint(tile[i][jl]) ^ flip);
+    }
+    y[off + (size_t) a * m + jl] = __fmul_rn(acc, scale);
+}
+
+// Sign masks of the Paley matrix above, three words per row (P <= 96), built once per device.
+static const uint32_t * rq_paley_masks(int p) {
+    static std::mutex mutex;
+    static std::map<std::pair<int, int>, uint32_t *> tables;
+    const int device = ggml_cuda_get_device();
+    std::lock_guard<std::mutex> lock(mutex);
+    uint32_t *& d = tables[{ device, p }];
+    if (d == nullptr) {
+        const int q = p - 1;
+        std::vector<int> chi(q, -1);
+        chi[0] = 0;
+        for (int i = 1; i < q; ++i) chi[(i * i) % q] = 1;
+        std::vector<uint32_t> h(3 * p, 0);
+        for (int a = 0; a < p; ++a) {
+            for (int i = 0; i < p; ++i) {
+                const int s = i == 0 ? (a == 0 ? 0 : 1) : (a == 0 ? -1 : chi[((a - i) % q + q) % q]);
+                if ((i == a ? 1 : 0) + s <= 0) h[3 * a + i / 32] |= 1u << (i % 32);
+            }
+        }
+        CUDA_CHECK(cudaMalloc(&d, h.size() * sizeof(uint32_t)));
+        CUDA_CHECK(cudaMemcpy(d, h.data(), h.size() * sizeof(uint32_t), cudaMemcpyHostToDevice));
+    }
+    return d;
+}
+
+// ---------------------------------------------------------------------------- activation quantization
+// one block per token, op for op as rq_quantize_row_a in ggml-quants.c: asymmetric, per group of G (256, 128 or 64)
+// a zero point z_g and a scale that is an integer multiple m_g of the token's unit u. aq: codes (q - 8), token-major
+// [M, K/8] (KA = 0) or the skinny kernel's step-major rq_act_index layout for Tp tokens (KA > 0); s_a[m] = u;
+// mz[g * Tp + m] = m_g | z_g << 8.
+static constexpr int RQ_QUANT_THREADS = 256;
+static constexpr int RQ_AG_M = 255;       // as in ggml-quants.c
+static constexpr int RQ_MAX_BLOCKS = 128; // K <= 32768
+static constexpr int RQ_MAX_GROUPS = RQ_MAX_BLOCKS * QK_W4A4 / 64;
+
+static __global__ void __launch_bounds__(RQ_QUANT_THREADS)
+rq_quantize_act_kernel(const float * __restrict__ x, int ldx, int K, int G, float clip, int32_t * __restrict__ aq,
+                       float * __restrict__ s_a, int32_t * __restrict__ mz, int Tp, int KA,
+                       int32_t * __restrict__ zero, int64_t n_zero, int M) {
+    const int m = blockIdx.x;
+    if (m >= M) { // the blocks past the tokens clear the skinny kernel's split-K sums and counters, 16 ints per thread
+        const int64_t i0 = ((int64_t) (m - M) * RQ_QUANT_THREADS + threadIdx.x) * 16;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) if (i0 + i < n_zero) zero[i0 + i] = 0;
+        return;
+    }
+    constexpr int NW = RQ_QUANT_THREADS / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE, wid = threadIdx.x / WARP_SIZE;
+    const int nb = K / QK_W4A4, L = G / 8; // lanes per group
+    const float * xr = x + (size_t) m * ldx;
+    __shared__ float s_lo[RQ_MAX_GROUPS], s_hi[RQ_MAX_GROUPS];
+    __shared__ float s_wmax[NW];
+    // a warp per block of 256, a lane per code word (8 values), L lanes per group
+    float wmax = 0.f;
+    for (int b = wid; b < nb; b += NW) {
+        const float4 * p = reinterpret_cast<const float4 *>(xr + b * QK_W4A4 + 8 * lane);
+        const float4 v0 = p[0], v1 = p[1];
+        float mn = fminf(fminf(fminf(fminf(v0.x, v0.y), fminf(v0.z, v0.w)), fminf(fminf(v1.x, v1.y), fminf(v1.z, v1.w))), 0.f);
+        float mx = fmaxf(fmaxf(fmaxf(fmaxf(v0.x, v0.y), fmaxf(v0.z, v0.w)), fmaxf(fmaxf(v1.x, v1.y), fmaxf(v1.z, v1.w))), 0.f);
+#pragma unroll
+        for (int off = WARP_SIZE / 2; off > 0; off >>= 1) {
+            if (off < L) {
+                mn = fminf(mn, __shfl_xor_sync(0xffffffff, mn, off, WARP_SIZE));
+                mx = fmaxf(mx, __shfl_xor_sync(0xffffffff, mx, off, WARP_SIZE));
+            }
+        }
+        const float lo = __fmul_rn(mn, clip), hi = __fmul_rn(mx, clip);
+        if (lane % L == 0) { s_lo[(b * QK_W4A4 + 8 * lane) / G] = lo; s_hi[(b * QK_W4A4 + 8 * lane) / G] = hi; }
+        wmax = fmaxf(wmax, __fsub_rn(hi, lo));
+    }
+    wmax = warp_reduce_max(wmax);
+    if (lane == 0) s_wmax[wid] = wmax;
+    __syncthreads();
+    float R = s_wmax[0];
+#pragma unroll
+    for (int i = 1; i < NW; ++i) R = fmaxf(R, s_wmax[i]);
+    if (R == 0.f) R = 2.f;
+    const float u = __fdiv_rn(R, 15.f * RQ_AG_M);
+    if (threadIdx.x == 0) s_a[m] = u;
+    for (int b = wid; b < nb; b += NW) {
+        const int g = (b * QK_W4A4 + 8 * lane) / G;
+        const float lo = s_lo[g], hi = s_hi[g];
+        const int mg = (int) fminf(fmaxf(ceilf(__fdiv_rn(__fmul_rn(__fsub_rn(hi, lo), (float) RQ_AG_M), R)), 1.f), (float) RQ_AG_M);
+        const float inv = __fdiv_rn(1.f, __fmul_rn((float) mg, u));
+        const float zf  = fminf(fmaxf(rintf(__fmul_rn(-lo, inv)), 0.f), 15.f);
+        if (lane % L == 0) mz[(size_t) g * Tp + m] = mg | (int) zf << 8;
+        const float4 * p = reinterpret_cast<const float4 *>(xr + b * QK_W4A4 + 8 * lane);
+        const float4 v0 = p[0], v1 = p[1];
+        const float f[8] = { v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w };
+        uint32_t word = 0;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const float q = fminf(fmaxf(__fadd_rn(rintf(__fmul_rn(f[j], inv)), zf), 0.f), 15.f);
+            word |= (uint32_t) (((int) q - 8) & 0xF) << (4 * j);
+        }
+        const int w = b * (QK_W4A4 / 8) + lane;
+        aq[KA ? rq_act_index(m, w, Tp, KA) : (size_t) m * (K / 8) + w] = (int32_t) word;
+    }
+}
+
+// ---------------------------------------------------------------------------- skinny path (gfx906; emulated dot8 on CUDA)
+// The weight is repacked in place on first use: [Wt codes, N*K/2 bytes | s_w, N floats | colsum, K/G x N int16,
+// per activation group of G | k_b, K/256 x N int16, the blocks' multipliers], which fits in the N*K/256 blocks of
+// 144 B. On that first use tensor->extra (unused for non-split buffers) gets the
+// tensor's state: whether it is repacked, and its activation clip and Hadamard length from the block headers.
+struct rq_tensor_info {
+    bool    repacked;
+    float   clip; // block 0 header pad[1]; 0 = unset
+    int32_t rot;  // block 0 header pad[0]: W4A4H's Hadamard length (the row, or a block of it)
+    bool    wg64; // weight multipliers per 64 inputs (block 0 header sum, RQ_W_MULT_G): activation groups of 64 only
+};
+
+static __global__ void rq_repack_kernel(const uint8_t * __restrict__ src, int32_t * __restrict__ wt, float * __restrict__ sw,
+                                        int N, int K) {
+    const int Kw = K / 8;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= (int64_t) N * Kw) return;
+    const int c = (int) (i / Kw), kw = (int) (i % Kw);
+    const uint8_t * row = src + (size_t) c * (K / QK_W4A4) * sizeof(block_w4a4);
+    wt[rq_wt_index(c, kw, Kw)] = *reinterpret_cast<const int32_t *>(row + (kw / 32) * sizeof(block_w4a4) + 16 + (kw % 32) * 4);
+    if (kw == 0) {
+        const block_w4a4 * h = reinterpret_cast<const block_w4a4 *>(row);
+        sw[c] = h->d;
+    }
+}
+
+// colsum[g * N + c]: the sum of row c's codes over activation group g (G inputs; |sum| <= 8 G fits int16)
+static __global__ void rq_colsum_kernel(const uint8_t * __restrict__ src, int16_t * __restrict__ colsum, int N, int K, int G) {
+    const int ng = K / G;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= (int64_t) N * ng) return;
+    const int c = (int) (i % N), g = (int) (i / N);
+    const block_w4a4 * b = reinterpret_cast<const block_w4a4 *>(src + ((size_t) c * (K / QK_W4A4) + g * G / QK_W4A4) * sizeof(block_w4a4));
+    const int w0 = (g * G % QK_W4A4) / 8;
+    int sum = 0;
+    for (int w = w0; w < w0 + G / 8; ++w)
+#pragma unroll
+        for (int j = 0; j < 8; ++j) sum += (int32_t) (((b->qs[w] >> (4 * j)) & 0xF) << 28) >> 28;
+    colsum[i] = (int16_t) sum;
+}
+
+// wk[g * N + c]: row c's scale multiplier for inputs 64 g .. 64 g + 63 (RQ_W_MULT_G; one per block of 256 in
+// files without weight groups of 64), int8 so the [K / 64][N] array still fits the blocks' slack
+static __global__ void rq_wk_kernel(const uint8_t * __restrict__ src, int8_t * __restrict__ wk, int N, int K) {
+    const int nb = K / QK_W4A4;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= (int64_t) N * (K / 64)) return;
+    const int c = (int) (i % N), g = (int) (i / N);
+    const block_w4a4 * h = reinterpret_cast<const block_w4a4 *>(src + ((size_t) c * nb + g / 4) * sizeof(block_w4a4));
+    wk[i] = (int8_t) RQ_W_MULT_G(h->sum, g % 4);
+}
+
+static int rq_skinny_tp(int64_t m) {
+    for (int p : {1, 2, 4, 8, 16, 24, 32, 48}) if (m <= p) return p;
+    return 64;
+}
+
+// launch shape of the skinny kernel for Tp tokens: R channel groups per wave, W waves, G split-K workgroups
+struct rq_skinny_shape {
+    int R, KA, W, G, kw_split, groups;
+};
+
+// N_launch: the channels of the whole launch (more than N when several weights share it, see rq_jobs). K is split
+// in whole activation groups of gsteps steps: each group's term is shifted (RQ_TERM_SHIFT), so one wave folds it.
+static rq_skinny_shape rq_skinny_plan(int tp, int N, int Kw, int N_launch, int gsteps) {
+    int R0 = 1, KA = 1;
+    switch (tp) {
+        case 1:  R0 = rq_cfg<1>::R;  KA = rq_cfg<1>::KA;  break;
+        case 2:  R0 = rq_cfg<2>::R;  KA = rq_cfg<2>::KA;  break;
+        case 4:  R0 = rq_cfg<4>::R;  KA = rq_cfg<4>::KA;  break;
+        case 8:  R0 = rq_cfg<8>::R;  KA = rq_cfg<8>::KA;  break;
+        case 16: R0 = rq_cfg<16>::R; KA = rq_cfg<16>::KA; break;
+        case 24: R0 = rq_cfg<24>::R; KA = rq_cfg<24>::KA; break;
+        case 32: R0 = rq_cfg<32>::R; KA = rq_cfg<32>::KA; break;
+        case 48: R0 = rq_cfg<48>::R; KA = rq_cfg<48>::KA; break;
+        default: R0 = rq_cfg<64>::R; KA = rq_cfg<64>::KA; break;
+    }
+    const int g64 = N / RQ_WAVE;
+    const int R = R0 >= 4 && g64 % 4 == 0 ? 4 : R0 >= 2 && g64 % 2 == 0 ? 2 : 1;
+    const int groups = g64 / R;
+    const int steps = Kw / RQ_KW;
+    static const int env_w = getenv("RQ_SKINNY_W") ? atoi(getenv("RQ_SKINNY_W")) : 0;
+    static const int env_g = getenv("RQ_SKINNY_G") ? atoi(getenv("RQ_SKINNY_G")) : 0;
+    // 8 waves with a 2-way split-K. Alone, a 4-way split was within noise of the best for every 27B shape at the verify
+    // widths (rig/results/skinny-sweep-t8.txt), but inside a forward 2-way wins: same on one MI50, and the narrower
+    // shapes under tensor parallelism get 12% (TP = 2) and 12% (TP = 4) faster T = 8 forwards
+    const int W = env_w > 0 ? std::min(env_w, 8) : 8;
+    int G = env_g > 0 ? env_g : 2;
+    // a launch with this many channel groups fills the device without splitting K, and skips the split-K fixup
+    // (MI50, T = 8: gate+up fused, 5120 x 34816, 179 -> 168 us; single weights are within noise either way)
+    if (env_g == 0 && tp <= 16 && N_launch / RQ_WAVE / R >= 4 * ggml_cuda_info().devices[ggml_cuda_get_device()].nsm) {
+        G = 1;
+    }
+    const int ngroups = steps / gsteps;
+    G = std::max(1, std::min(G, ngroups / W));
+    // whole groups per wave can make the longest wave longer than an even split of steps would; split K a little
+    // more until it is not (K = 5120 at G 64: 5 workgroups of 2 groups per wave, not 4 with up to 3)
+    const int G0 = G, even = (steps + W * G0 - 1) / (W * G0);
+    auto wave_steps = [&](int g) { return ((ngroups + g - 1) / g + W - 1) / W * gsteps; };
+    while (G > 1 && env_g == 0 && G < 2 * G0 && (G + 1) * W <= ngroups && wave_steps(G) > even) {
+        G++;
+    }
+    const int groups_per_wg = (ngroups + G - 1) / G;
+    G = (ngroups + groups_per_wg - 1) / groups_per_wg;
+    return { R, KA, W, G, groups_per_wg * gsteps * RQ_KW, groups };
+}
+
+template <int T, int R>
+static void rq_skinny_launch(const rq_skinny_shape & sh, const int32_t * ac, const rq_jobs & jobs, int Kw, cudaStream_t stream) {
+    int nblk = 0;
+    for (int i = 0; i < jobs.n; ++i) nblk += jobs.j[i].nblk;
+    rq_skinny_kernel<T, R><<<dim3(nblk, sh.G), RQ_WAVE * sh.W, rq_lds_bytes<T, R>(sh.W), stream>>>(ac, jobs, Kw, sh.kw_split);
+}
+
+template <int T>
+static void rq_skinny_launch_r(const rq_skinny_shape & sh, const int32_t * ac, const rq_jobs & jobs, int Kw, cudaStream_t stream) {
+    constexpr int R0 = rq_cfg<T>::R;
+    if (sh.R == 4)      rq_skinny_launch<T, R0 >= 4 ? 4 : 1>(sh, ac, jobs, Kw, stream);
+    else if (sh.R == 2) rq_skinny_launch<T, R0 >= 2 ? 2 : 1>(sh, ac, jobs, Kw, stream);
+    else                rq_skinny_launch<T, 1>(sh, ac, jobs, Kw, stream);
+}
+
+static void rq_skinny_dispatch(int tp, const rq_skinny_shape & sh, const int32_t * ac, const rq_jobs & jobs, int Kw, cudaStream_t stream) {
+    switch (tp) {
+        case 1:  rq_skinny_launch_r<1>(sh, ac, jobs, Kw, stream);  break;
+        case 2:  rq_skinny_launch_r<2>(sh, ac, jobs, Kw, stream);  break;
+        case 4:  rq_skinny_launch_r<4>(sh, ac, jobs, Kw, stream);  break;
+        case 8:  rq_skinny_launch_r<8>(sh, ac, jobs, Kw, stream);  break;
+        case 16: rq_skinny_launch_r<16>(sh, ac, jobs, Kw, stream); break;
+        case 24: rq_skinny_launch_r<24>(sh, ac, jobs, Kw, stream); break;
+        case 32: rq_skinny_launch_r<32>(sh, ac, jobs, Kw, stream); break;
+        case 48: rq_skinny_launch_r<48>(sh, ac, jobs, Kw, stream); break;
+        default: rq_skinny_launch_r<64>(sh, ac, jobs, Kw, stream); break;
+    }
+}
+
+// every shape ggml_cuda_rq_w4a4_supported admits (N a multiple of the wave); activation groups have no other path
+static bool rq_use_skinny(const ggml_tensor * src0) {
+    GGML_UNUSED(src0);
+    return true;
+}
+
+bool ggml_cuda_rq_w4a4_ready(const ggml_tensor * src0) {
+    return src0->extra != nullptr;
+}
+
+// ---------------------------------------------------------------------------- dispatch
+bool ggml_cuda_rq_w4a4_supported(int cc, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    int p, m;
+    const bool shapes = (src0->type == GGML_TYPE_W4A4 || src0->type == GGML_TYPE_W4A4H) &&
+           src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+           src0->ne[0] % QK_W4A4 == 0 && src0->ne[0] <= QK_W4A4 * RQ_MAX_BLOCKS && src0->ne[1] % RQ_WAVE == 0 &&
+           src0->ne[2] == 1 && src0->ne[3] == 1 &&
+           src1->ne[2] == 1 && src1->ne[3] == 1 && ggml_is_contiguous(src0) &&
+           src1->nb[0] == sizeof(float) && src1->nb[1] % 16 == 0 && dst->nb[0] == sizeof(float) &&
+           (src0->type != GGML_TYPE_W4A4H || (rq_factor(src0->ne[0], p, m) && m <= 12288)); // FWHT chunk fits in 48 KiB
+#if defined(GGML_USE_MUSA)
+    GGML_UNUSED(cc); GGML_UNUSED(shapes);
+    return false;
+#elif defined(GGML_USE_HIP)
+    return GGML_CUDA_CC_IS_AMD(cc) && shapes;
+#else
+    return GGML_CUDA_CC_IS_NVIDIA(cc) && shapes;
+#endif
+}
+
+// The quantized activation of the last one-chunk skinny call, so the next W4A4 matmul of the same input (up after
+// gate, k and v after q, the DeltaNet gate after qkv) skips the Hadamard and the quantizer. The quantized layout
+// depends on the padded token count only (rq_skinny_plan's KA), not on N. An entry lives for one graph evaluation
+// of its context (ggml_cuda_rq_graph_begin), so reused graph tensors never hit stale data.
+static constexpr int RQ_CACHE_KW = 4096; // K <= 32768
+struct rq_act_cache {
+    uint64_t gen = 1, entry_gen = 0;
+    const ggml_tensor * src1 = nullptr;
+    const void * data = nullptr;
+    ggml_type type = GGML_TYPE_COUNT;
+    float clip = 0.0f;
+    int64_t rot = 0;
+    int64_t K = 0, M = 0;
+    int32_t * aq = nullptr; // [64 * RQ_CACHE_KW]
+    float * sa = nullptr;   // [64]
+    int32_t * mul = nullptr; // [RQ_MAX_GROUPS * 64]
+};
+
+static rq_act_cache & rq_cache_for(const ggml_backend_cuda_context & ctx) {
+    static std::mutex mutex;
+    static std::unordered_map<const ggml_backend_cuda_context *, rq_act_cache> caches;
+    std::lock_guard<std::mutex> lock(mutex);
+    return caches[&ctx];
+}
+
+void ggml_cuda_rq_graph_begin(ggml_backend_cuda_context & ctx) {
+    rq_cache_for(ctx).gen++;
+}
+
+#if !defined(GGML_USE_MUSA)
+// first use (never inside a graph capture, see ggml_cuda_rq_w4a4_ready): read the tensor's clip and Hadamard length
+static rq_tensor_info * rq_info(const ggml_tensor * src0, cudaStream_t stream) {
+    rq_tensor_info * info = (rq_tensor_info *) src0->extra;
+    if (info == nullptr) {
+        int32_t hdr[3] = { 0, 0, 0 }; // sum, pad[0], pad[1]
+        CUDA_CHECK(cudaMemcpyAsync(hdr, (const char *) src0->data + offsetof(block_w4a4, sum), sizeof(hdr),
+                                   cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        float tclip;
+        memcpy(&tclip, &hdr[2], sizeof(tclip));
+        const int32_t rot = src0->type == GGML_TYPE_W4A4H ? (int32_t) ggml_rq_rot_check(hdr[1], src0->ne[0]) : 0;
+        const bool wg64 = ((uint32_t) hdr[0] >> 29) == 3u;
+        GGML_ASSERT(!wg64 || ggml_rq_act_group() == 64); // the fold takes one weight multiplier per activation group
+        info = new rq_tensor_info{ false, tclip, rot, wg64 };
+        const_cast<ggml_tensor *>(src0)->extra = info;
+    }
+    return info;
+}
+
+// the skinny layout [Wt codes | s_w | colsum], made in place on first use
+static void rq_repack_once(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, rq_tensor_info * info) {
+    if (info->repacked) {
+        return;
+    }
+    const int64_t K = src0->ne[0], N = src0->ne[1];
+    const int Kw = (int) (K / 8);
+    uint8_t * base = (uint8_t *) src0->data;
+    const size_t nbytes = ggml_nbytes(src0);
+    ggml_cuda_pool_alloc<uint8_t> tmp(ctx.pool(), nbytes);
+    CUDA_CHECK(cudaMemcpyAsync(tmp.get(), base, nbytes, cudaMemcpyDeviceToDevice, ctx.stream()));
+    const int64_t n_threads = N * Kw;
+    rq_repack_kernel<<<(n_threads + 255) / 256, 256, 0, ctx.stream()>>>(tmp.get(), (int32_t *) base, (float *) (base + N * K / 2),
+                                                                      (int) N, (int) K);
+    const int G = ggml_rq_act_group();
+    const int64_t n_sums = N * (K / G);
+    rq_colsum_kernel<<<(n_sums + 255) / 256, 256, 0, ctx.stream()>>>(tmp.get(), (int16_t *) (base + N * K / 2 + N * 4), (int) N, (int) K, G);
+    const int64_t n_wk = N * (K / 64);
+    rq_wk_kernel<<<(n_wk + 255) / 256, 256, 0, ctx.stream()>>>(tmp.get(), (int8_t *) (base + N * K / 2 + N * 4 + n_sums * 2), (int) N, (int) K);
+    CUDA_CHECK(cudaGetLastError());
+    info->repacked = true;
+}
+
+// dsts[i] = src0s[i] x src1 for n <= 3 weights of one type, K and clip (see ggml_cuda_rq_w4a4_can_fuse): one
+// activation transform and quantization, and on the skinny path one launch for all of them.
+static void rq_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * const * src0s, ggml_tensor * const * dsts, int n,
+                       const ggml_tensor * src1) {
+    const ggml_tensor * src0 = src0s[0];
+    ggml_tensor * dst = dsts[0];
+    const int64_t K = src0->ne[0], N = src0->ne[1], M = src1->ne[1];
+    cudaStream_t stream = ctx.stream();
+
+    const rq_tensor_info * info = rq_info(src0, stream);
+    const float clip = ggml_rq_act_clip_for(info->clip, src0->type == GGML_TYPE_W4A4H);
+    const int64_t n_rot = info->rot; // W4A4H: Hadamard blocks of n_rot along K
+
+    // tokens per skinny launch (a tile size of rq_skinny_tp; env RQ_CHUNK). 24, not 64: the 64-token tile spills (36
+    // VGPRs with ROCm 5.7's compiler, 77 with 7.2.4's) and 24-token launches cost less per token at every prefill
+    // shape (MI50 pp512: 219 -> 321 t/s on ROCm 5.7, 176 -> 333 on 7.2.4)
+    static const int chunk = getenv("RQ_CHUNK") ? rq_skinny_tp(atoi(getenv("RQ_CHUNK"))) : 24;
+    rq_act_cache * cache = nullptr; // set for one-chunk skinny calls, which share their quantized activation
+    bool hit = false;
+    if (rq_use_skinny(src0) && M <= chunk && K / 8 <= RQ_CACHE_KW) {
+        cache = &rq_cache_for(ctx);
+        hit = cache->entry_gen == cache->gen && cache->src1 == src1 && cache->data == src1->data &&
+              cache->type == src0->type && cache->clip == clip && cache->rot == n_rot && cache->K == K && cache->M == M;
+        if (cache->aq == nullptr) { // first use, never inside a graph capture (see ggml_cuda_rq_w4a4_ready)
+            CUDA_CHECK(cudaMalloc(&cache->aq, (size_t) 64 * RQ_CACHE_KW * sizeof(int32_t)));
+            CUDA_CHECK(cudaMalloc(&cache->sa, 64 * sizeof(float)));
+            CUDA_CHECK(cudaMalloc(&cache->mul, (size_t) RQ_MAX_GROUPS * 64 * sizeof(int32_t)));
+        }
+    }
+
+    const float * x = (const float *) src1->data;
+    int ldx = (int) (src1->nb[1] / sizeof(float));
+    ggml_cuda_pool_alloc<float> xh(ctx.pool()), xp(ctx.pool());
+    if (src0->type == GGML_TYPE_W4A4H && !hit) {
+        // block-diagonal: the M x K activation is M * (K / n_rot) rows of n_rot, each rotated as the CPU reference does
+        int p, m;
+        GGML_ASSERT(rq_factor(n_rot, p, m) && m <= 12288);
+        const int64_t Mr = M * (K / n_rot);
+        xh.alloc(M * K);
+        const float scale = 1.0f / sqrtf((float) n_rot); // same constant as the CPU reference
+        const int tf = std::min(m / 2, 512);
+        rq_fwht_kernel<<<dim3(M, K / m), std::max(tf, 32), m * sizeof(float), stream>>>(x, ldx, xh.get(), (int) K, m, p, scale);
+        if (p > 1) {
+            if (m % 64 == 0 && (p == 12 || p == 20 || p == 68)) {
+                xp.alloc(M * K);
+                const dim3 rows(Mr, m / 64, p / 4);
+                const uint32_t * masks = rq_paley_masks(p);
+                switch (p) {
+                    case 12: rq_paley_rows_kernel<12><<<rows, 256, 0, stream>>>(xh.get(), xp.get(), masks, (int) n_rot, m, scale); break;
+                    case 20: rq_paley_rows_kernel<20><<<rows, 256, 0, stream>>>(xh.get(), xp.get(), masks, (int) n_rot, m, scale); break;
+                    case 68: rq_paley_rows_kernel<68><<<rows, 256, 0, stream>>>(xh.get(), xp.get(), masks, (int) n_rot, m, scale); break;
+                }
+            } else {
+                rq_paley_kernel<<<dim3(Mr, (m + 127) / 128), 128, 0, stream>>>(xh.get(), (int) n_rot, m, p, scale);
+            }
+        }
+        x = xp.get() != nullptr ? xp.get() : xh.get();
+        ldx = (int) K;
+    }
+
+    if (rq_use_skinny(src0)) {
+        const int Kw = (int) (K / 8);
+        for (int i = 0; i < n; ++i) {
+            rq_repack_once(ctx, src0s[i], rq_info(src0s[i], stream));
+        }
+        const int G = ggml_rq_act_group();
+        // prefill widths: the tiled GEMM (rq-w4a4-gemm.cuh) over all tokens, quantized in one launch (env RQ_GEMM_MIN,
+        // 0 = skinny chunks only)
+        static const int gemm_min = getenv("RQ_GEMM_MIN") ? atoi(getenv("RQ_GEMM_MIN")) : 64;
+        bool gemm = cache == nullptr && gemm_min > 0 && M >= gemm_min;
+        for (int i = 0; i < n; ++i) {
+            gemm = gemm && src0s[i]->ne[1] % RQ_GEMM_BN == 0;
+        }
+        if (gemm) {
+            const int64_t Mp = (M + RQ_GEMM_BT - 1) / RQ_GEMM_BT * RQ_GEMM_BT;
+            const int gt = G / 64, nk = Kw / RQ_GEMM_KT;
+            // split K while the grid is under two workgroups per CU, keeping 16+ tiles per split
+            const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+            std::vector<int> kz(n), nz(n);
+            size_t n_acc = 0, n_cnt = 0;
+            for (int i = 0; i < n; ++i) {
+                const int64_t wgs = src0s[i]->ne[1] / RQ_GEMM_BN * (Mp / RQ_GEMM_BT);
+                int s = 1;
+                while (wgs * s < 2 * nsm && nk / (2 * s) >= 16) s *= 2;
+                kz[i] = ((nk + s - 1) / s + gt - 1) / gt * gt;
+                nz[i] = (nk + kz[i] - 1) / kz[i];
+                if (nz[i] > 1) {
+                    n_acc += Mp * src0s[i]->ne[1];
+                    n_cnt += wgs;
+                }
+            }
+            ggml_cuda_pool_alloc<int32_t> aq(ctx.pool(), Mp * Kw);
+            ggml_cuda_pool_alloc<float>   sa(ctx.pool(), Mp);
+            ggml_cuda_pool_alloc<int32_t> mul(ctx.pool(), Mp * (K / G));
+            ggml_cuda_pool_alloc<int32_t> acc(ctx.pool(), std::max<size_t>(n_acc + n_cnt, 1)); // split-K sums, then counters
+            const int zero_blocks = (int) ((n_acc + n_cnt + RQ_QUANT_THREADS * 16 - 1) / (RQ_QUANT_THREADS * 16));
+            rq_quantize_act_kernel<<<M + zero_blocks, RQ_QUANT_THREADS, 0, stream>>>(x, ldx, (int) K, G, clip, aq.get(), sa.get(),
+                                                                                    mul.get(), (int) Mp, 0, acc.get(),
+                                                                                    (int64_t) (n_acc + n_cnt), (int) M);
+            int32_t * acc_i = acc.get(), * cnt_i = acc.get() + n_acc;
+            for (int i = 0; i < n; ++i) {
+                const int64_t Ni = src0s[i]->ne[1];
+                const uint8_t * base = (const uint8_t *) src0s[i]->data;
+                const size_t o_sw = Ni * K / 2, o_cs = o_sw + Ni * 4, o_wk = o_cs + Ni * (K / G) * 2;
+                const dim3 grid(Ni / RQ_GEMM_BN, Mp / RQ_GEMM_BT, nz[i]);
+                auto kernel = gt == 1 ? rq_gemm_kernel<0> : gt == 2 ? rq_gemm_kernel<1> : rq_gemm_kernel<2>;
+                kernel<<<grid, RQ_GEMM_THREADS, 0, stream>>>(
+                    aq.get(), mul.get(), sa.get(), (const int32_t *) base, (const float *) (base + o_sw),
+                    (const int16_t *) (base + o_cs), (const int8_t *) (base + o_wk), (float *) dsts[i]->data,
+                    (int) (dsts[i]->nb[1] / sizeof(float)), (int) Ni, (int) M, (int) Mp, Kw, kz[i], acc_i, cnt_i);
+                if (nz[i] > 1) {
+                    acc_i += Mp * Ni;
+                    cnt_i += Ni / RQ_GEMM_BN * (Mp / RQ_GEMM_BT);
+                }
+            }
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
+        const int tp_max = rq_skinny_tp(std::min<int64_t>(M, chunk));
+        ggml_cuda_pool_alloc<int32_t> aq_pool(ctx.pool());
+        ggml_cuda_pool_alloc<float>   sa_pool(ctx.pool());
+        ggml_cuda_pool_alloc<int32_t> mul_pool(ctx.pool());
+        int32_t * aq = cache ? cache->aq : aq_pool.alloc((size_t) tp_max * Kw);
+        float   * sa = cache ? cache->sa : sa_pool.alloc(tp_max);
+        int32_t * mul = cache ? cache->mul : mul_pool.alloc((size_t) tp_max * (K / G));
+        size_t n_acc = 0;
+        for (int i = 0; i < n; ++i) {
+            n_acc += (size_t) tp_max * src0s[i]->ne[1] + src0s[i]->ne[1] / RQ_WAVE;
+        }
+        ggml_cuda_pool_alloc<int32_t> acc(ctx.pool(), n_acc); // per weight: split-K sums, then counters
+        for (int64_t m0 = 0; m0 < M; m0 += chunk) {
+            const int mc = (int) std::min<int64_t>(chunk, M - m0);
+            const int tp = rq_skinny_tp(mc);
+            int64_t N_launch = 0;
+            for (int i = 0; i < n; ++i) {
+                N_launch += src0s[i]->ne[1];
+            }
+            rq_skinny_shape sh = rq_skinny_plan(tp, (int) N, Kw, (int) N_launch, G / 32);
+            for (int i = 1; i < n; ++i) {
+                const rq_skinny_shape shi = rq_skinny_plan(tp, (int) src0s[i]->ne[1], Kw, (int) N_launch, G / 32);
+                if (shi.R < sh.R) { // one R for the launch
+                    sh = shi;
+                }
+            }
+            rq_jobs jobs = {};
+            jobs.n = n;
+            jobs.gsh = G == 64 ? 1 : G == 128 ? 2 : 3;
+            int64_t off = 0;
+            for (int i = 0; i < n; ++i) {
+                const int64_t Ni = src0s[i]->ne[1];
+                const uint8_t * base = (const uint8_t *) src0s[i]->data;
+                const int ldd = (int) (dsts[i]->nb[1] / sizeof(float));
+                const int groups = (int) (Ni / RQ_WAVE / sh.R);
+                int32_t * acc_i = acc.get() + off;
+                jobs.j[i] = { (const int32_t *) base, acc_i, (int) Ni, groups,
+                              { sa, mul, (const float *) (base + Ni * K / 2), (const int16_t *) (base + Ni * K / 2 + Ni * 4),
+                                (const int8_t *) (base + Ni * K / 2 + Ni * 4 + Ni * (K / G) * 2),
+                                (float *) dsts[i]->data + m0 * ldd, ldd, mc, acc_i + (size_t) mc * Ni } };
+                off += (int64_t) mc * Ni + groups;
+            }
+            for (int i = n; i < 3; ++i) {
+                jobs.j[i] = jobs.j[0];
+                jobs.j[i].nblk = 0;
+            }
+            const int64_t n_zero = sh.G > 1 ? off : 0;
+            const int zero_blocks = (int) ((n_zero + RQ_QUANT_THREADS * 16 - 1) / (RQ_QUANT_THREADS * 16));
+            if (!hit) {
+                rq_quantize_act_kernel<<<mc + zero_blocks, RQ_QUANT_THREADS, 0, stream>>>(x + m0 * ldx, ldx, (int) K, G, clip,
+                                                                           aq, sa, mul, tp, sh.KA, acc.get(), n_zero, mc);
+            } else if (zero_blocks > 0) { // reused activation: only clear the split-K sums and counters
+                rq_quantize_act_kernel<<<zero_blocks, RQ_QUANT_THREADS, 0, stream>>>(x, ldx, (int) K, G, clip,
+                                                                     aq, sa, mul, tp, sh.KA, acc.get(), n_zero, 0);
+            }
+            rq_skinny_dispatch(tp, sh, aq, jobs, Kw, stream);
+        }
+        if (cache && !hit) {
+            cache->entry_gen = cache->gen;
+            cache->src1 = src1;
+            cache->data = src1->data;
+            cache->type = src0->type;
+            cache->clip = clip;
+            cache->rot = n_rot;
+            cache->K = K;
+            cache->M = M;
+        }
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    GGML_ABORT("ruquant W4A4: no path for this shape");
+}
+#endif // !GGML_USE_MUSA
+
+void ggml_cuda_mul_mat_rq_w4a4(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+#if defined(GGML_USE_MUSA)
+    GGML_UNUSED(ctx); GGML_UNUSED(src0); GGML_UNUSED(src1); GGML_UNUSED(dst);
+    GGML_ABORT("ruquant W4A4 is not available on this backend");
+#else
+    rq_mul_mat(ctx, &src0, &dst, 1, src1);
+#endif
+}
+
+bool ggml_cuda_rq_w4a4_can_fuse(const ggml_tensor * a, const ggml_tensor * b) {
+#if defined(GGML_USE_MUSA)
+    GGML_UNUSED(a); GGML_UNUSED(b);
+    return false;
+#else
+    const ggml_tensor * wa = a->src[0];
+    const ggml_tensor * wb = b->src[0];
+    const ggml_tensor * x  = a->src[1];
+    if (a->op != GGML_OP_MUL_MAT || b->op != GGML_OP_MUL_MAT || b->src[1] != x ||
+        (wa->type != GGML_TYPE_W4A4 && wa->type != GGML_TYPE_W4A4H) || wb->type != wa->type || wb->ne[0] != wa->ne[0] ||
+        x->type != GGML_TYPE_F32 || ggml_nrows(x) != x->ne[1] || x->ne[1] > 16 || // verify widths (fused prefill chunks were slower)
+        a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || !rq_use_skinny(wa) || !rq_use_skinny(wb)) {
+        return false;
+    }
+    // both weights seen before: their first use reads the clip with a synchronize, so it stays unfused
+    const rq_tensor_info * ia = (const rq_tensor_info *) wa->extra;
+    const rq_tensor_info * ib = (const rq_tensor_info *) wb->extra;
+    return ia != nullptr && ib != nullptr && ia->clip == ib->clip && ia->rot == ib->rot;
+#endif
+}
+
+void ggml_cuda_mul_mat_rq_w4a4_fused(ggml_backend_cuda_context & ctx, const ggml_tensor * const * src0s, ggml_tensor * const * dsts,
+                                     int n, const ggml_tensor * src1) {
+#if defined(GGML_USE_MUSA)
+    GGML_UNUSED(ctx); GGML_UNUSED(src0s); GGML_UNUSED(dsts); GGML_UNUSED(n); GGML_UNUSED(src1);
+    GGML_ABORT("ruquant W4A4 is not available on this backend");
+#else
+    GGML_ASSERT(n >= 1 && n <= 3);
+    rq_mul_mat(ctx, src0s, dsts, n, src1);
+#endif
+}
diff --git a/ggml/src/ggml-cuda/rq-w4a4.cuh b/ggml/src/ggml-cuda/rq-w4a4.cuh
new file mode 100644
index 0000000..af559c2
--- /dev/null
+++ b/ggml/src/ggml-cuda/rq-w4a4.cuh
@@ -0,0 +1,15 @@
+#include "common.cuh"
+
+// ruquant W4A4 / W4A4H matmul: optional online Hadamard, per-token int4 activation quantization,
+// int4 x int4 GEMM with int32 accumulation, the spec epilogue. Same bits as the CPU reference.
+bool ggml_cuda_rq_w4a4_supported(int cc, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);
+// false while the weight still needs its one-time in-place repack (skinny path), which must not be captured in a graph
+bool ggml_cuda_rq_w4a4_ready(const ggml_tensor * src0);
+void ggml_cuda_mul_mat_rq_w4a4(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+// b = W_b x can run in one launch with a = W_a x (same x, type, K and clip, skinny widths)
+bool ggml_cuda_rq_w4a4_can_fuse(const ggml_tensor * a, const ggml_tensor * b);
+// n <= 3 such matmuls (all can_fuse with the first) as one
+void ggml_cuda_mul_mat_rq_w4a4_fused(ggml_backend_cuda_context & ctx, const ggml_tensor * const * src0s, ggml_tensor * const * dsts,
+                                     int n, const ggml_tensor * src1);
+// starts a new graph evaluation of ctx: drops the shared quantized activation of the previous one
+void ggml_cuda_rq_graph_begin(ggml_backend_cuda_context & ctx);
diff --git a/ggml/src/ggml-quants.c b/ggml/src/ggml-quants.c
index 3586f67..97f7984 100644
--- a/ggml/src/ggml-quants.c
+++ b/ggml/src/ggml-quants.c
@@ -5394,6 +5394,387 @@ static bool validate_e_e8m0(uint8_t e, size_t i) {
         } \
     }
 
+
+// ====================== ruquant W4A4 ======================
+
+static bool rq_is_prime(int q) {
+    if (q < 2) return false;
+    for (int d = 2; d * d <= q; ++d) if (q % d == 0) return false;
+    return true;
+}
+
+bool ggml_rq_hadamard_factor(int64_t n, int * p, int * m) {
+    for (int pp = 1; pp <= 128 && pp <= n; ++pp) {
+        if (pp > 1 && (pp % 4 != 0 || !rq_is_prime(pp - 1) || (pp - 1) % 4 != 3)) continue;
+        if (n % pp != 0) continue;
+        const int64_t mm = n / pp;
+        if (mm & (mm - 1)) continue;
+        *p = pp;
+        *m = (int) mm;
+        return true;
+    }
+    return false;
+}
+
+// Paley construction I: A = I + S, S[0][j>0] = 1, S[i>0][0] = -1, S[i][j] = chi(j - i mod q) for i, j >= 1
+static void rq_paley(int p, int8_t * A) {
+    const int q = p - 1;
+    int8_t chi[128];
+    chi[0] = 0;
+    for (int i = 1; i < q; ++i) chi[i] = -1;
+    for (int i = 1; i < q; ++i) chi[(i * i) % q] = 1;
+    for (int i = 0; i < p; ++i) {
+        for (int j = 0; j < p; ++j) {
+            int s;
+            if (i == 0)      s = j == 0 ? 0 : 1;
+            else if (j == 0) s = -1;
+            else             s = chi[((j - i) % q + q) % q];
+            A[i*p + j] = (int8_t) ((i == j ? 1 : 0) + s);
+        }
+    }
+}
+
+void ggml_rq_hadamard(float * GGML_RESTRICT x, int64_t n, bool transpose) {
+    int p, m;
+    GGML_ASSERT(ggml_rq_hadamard_factor(n, &p, &m) && "row length has no ruquant Hadamard");
+    // Sylvester (symmetric) over each chunk of m, butterflies in increasing stride
+    for (int i = 0; i < p; ++i) {
+        float * c = x + (int64_t) i * m;
+        for (int h = 1; h < m; h <<= 1) {
+            for (int j = 0; j < m; j += 2*h) {
+                for (int k = j; k < j + h; ++k) {
+                    const float a = c[k], b = c[k + h];
+                    c[k] = a + b;
+                    c[k + h] = a - b;
+                }
+            }
+        }
+    }
+    // Paley across chunks: y[a] = sum_i x[i] A[i][a] (A[a][i] when transposed), i ascending from 0
+    if (p > 1) {
+        int8_t A[128*128];
+        float col[128];
+        rq_paley(p, A);
+        for (int j = 0; j < m; ++j) {
+            for (int i = 0; i < p; ++i) col[i] = x[(int64_t) i*m + j];
+            for (int a = 0; a < p; ++a) {
+                float acc = 0.0f;
+                for (int i = 0; i < p; ++i) {
+                    const int8_t e = transpose ? A[a*p + i] : A[i*p + a];
+                    acc = e > 0 ? acc + col[i] : acc - col[i];
+                }
+                x[(int64_t) a*m + j] = acc;
+            }
+        }
+    }
+    const float scale = 1.0f / sqrtf((float) n);
+    for (int64_t i = 0; i < n; ++i) x[i] *= scale;
+}
+
+#define RQ_AG_M 255 // activation group multipliers are 1..RQ_AG_M (see rq_quantize_row_a)
+
+static inline void rq_pack(block_w4a4 * GGML_RESTRICT y, const int8_t * GGML_RESTRICT codes, int64_t k, float d, int32_t sum) {
+    for (int64_t b = 0; b < k / QK_W4A4; ++b) {
+        y[b].d = d;
+        y[b].sum = sum;
+        y[b].pad[0] = (int32_t) k;
+        y[b].pad[1] = 0;
+        for (int w = 0; w < QK_W4A4 / 8; ++w) {
+            uint32_t word = 0;
+            for (int j = 0; j < 8; ++j) word |= (uint32_t) (codes[b*QK_W4A4 + 8*w + j] & 0xF) << (4*j);
+            y[b].qs[w] = word;
+        }
+    }
+}
+
+static inline int32_t rq_code(uint32_t word, int j) {
+    return (int32_t) (((word >> (4*j)) & 0xF) << 28) >> 28;
+}
+
+// weights: symmetric codes in [-8, 7], scale = clip * amax / 7 with the clip ratio (1.0 down to 0.7 in
+// 13 steps) that minimizes the squared rounding error of the n values
+static float rq_scale_search(const float * GGML_RESTRICT x, int64_t n) {
+    float amax = 0.0f;
+    for (int64_t i = 0; i < n; ++i) amax = fmaxf(amax, fabsf(x[i]));
+    float best_s = 0.0f;
+    if (amax > 0.0f) {
+        double best_err = INFINITY;
+        for (int r = 0; r < 13; ++r) {
+            const float s = amax * (1.0f - 0.025f * r) / 7.0f;
+            double err = 0.0;
+            for (int64_t i = 0; i < n; ++i) {
+                const float q = fminf(fmaxf(rintf(x[i] / s), -8.0f), 7.0f);
+                const double e = (double) (q * s) - (double) x[i];
+                err += e * e;
+            }
+            if (err < best_err) { best_err = err; best_s = s; }
+        }
+    }
+    return best_s;
+}
+
+// weight groups (RQ_WGROUP=1 or 64, for tests; models get them from ruquant convert --wgroups [64]): a scale per
+// block (or per 64 inputs) from the search, as an integer multiple k (1..15) of the row's unit, the largest / 15
+static int rq_wgroups(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char * e = getenv("RQ_WGROUP");
+        on = e ? (atoi(e) == 64 ? 64 : atoi(e) > 0 ? QK_W4A4 : 0) : 0;
+    }
+    return on;
+}
+
+// one scale per row, or with rq_wgroups() one per block
+static void rq_quantize_row_w(const float * GGML_RESTRICT x, block_w4a4 * GGML_RESTRICT y, int64_t k) {
+    GGML_ASSERT(k % QK_W4A4 == 0);
+    const int64_t nb = k / QK_W4A4;
+    int8_t * codes = (int8_t *) malloc(k);
+    if (!rq_wgroups()) {
+        const float s = rq_scale_search(x, k);
+        int32_t sum = 0;
+        for (int64_t i = 0; i < k; ++i) {
+            codes[i] = s > 0.0f ? (int8_t) fminf(fmaxf(rintf(x[i] / s), -8.0f), 7.0f) : 0;
+            sum += codes[i];
+        }
+        rq_pack(y, codes, k, s, sum);
+        free(codes);
+        return;
+    }
+    const int gs = rq_wgroups(), ng = (int) (k / gs);
+    float * sb = (float *) malloc(ng * sizeof(float));
+    int32_t * kb = (int32_t *) malloc(ng * sizeof(int32_t));
+    float smax = 0.0f;
+    for (int g = 0; g < ng; ++g) {
+        sb[g] = rq_scale_search(x + (int64_t) g*gs, gs);
+        smax = fmaxf(smax, sb[g]);
+    }
+    const float v = smax / 15.0f;
+    for (int g = 0; g < ng; ++g) {
+        kb[g] = v > 0.0f ? (int32_t) fminf(fmaxf(rintf(sb[g] / v), 1.0f), 15.0f) : 1;
+        const float s = (float) kb[g] * v;
+        for (int i = 0; i < gs; ++i) {
+            codes[(int64_t) g*gs + i] = s > 0.0f ? (int8_t) fminf(fmaxf(rintf(x[(int64_t) g*gs + i] / s), -8.0f), 7.0f) : 0;
+        }
+    }
+    rq_pack(y, codes, k, v, 0);
+    for (int64_t b = 0; b < nb; ++b) {
+        y[b].sum = gs == QK_W4A4 ? 1 << 30 | kb[b]
+                                 : 3 << 29 | kb[4*b] | kb[4*b + 1] << 4 | kb[4*b + 2] << 8 | kb[4*b + 3] << 12;
+    }
+    free(kb);
+    free(sb);
+    free(codes);
+}
+
+// activation clip ratio: the range [min(x,0), max(x,0)] is scaled by it before quantizing (outliers
+// saturate). A weight tensor carries its own in its block headers (pad[1], a float; 0 = unset); RQ_ACT_CLIP /
+// RQ_ACT_CLIP_H (W4A4 / W4A4H inputs) override it for experiments; without either it is 1. Every backend
+// resolves it the same way.
+float ggml_rq_act_clip(bool hadamard) {
+    return ggml_rq_act_clip_for(0.0f, hadamard);
+}
+
+float ggml_rq_act_clip_for(float tensor_clip, bool hadamard) {
+    static float env[2] = { -2.0f, -2.0f }; // -1: not set
+    if (env[0] == -2.0f) {
+        const char * e = getenv("RQ_ACT_CLIP");
+        const char * eh = getenv("RQ_ACT_CLIP_H");
+        env[0] = e ? (float) atof(e) : -1.0f;
+        env[1] = eh ? (float) atof(eh) : env[0];
+    }
+    const float e = env[hadamard ? 1 : 0];
+    return e > 0.0f ? e : tensor_clip > 0.0f ? tensor_clip : 1.0f;
+}
+
+float ggml_rq_tensor_clip(const void * blocks) {
+    float c;
+    memcpy(&c, &((const block_w4a4 *) blocks)->pad[1], sizeof(c));
+    return c;
+}
+
+int64_t ggml_rq_tensor_rot(const void * blocks, int64_t k) {
+    return ggml_rq_rot_check(((const block_w4a4 *) blocks)->pad[0], k);
+}
+
+int64_t ggml_rq_rot_check(int32_t n, int64_t k) {
+    int p, m;
+    if (n <= 0 || k % n != 0 || !ggml_rq_hadamard_factor(n, &p, &m)) {
+        // a model whose online Hadamard spans the whole row, split along K (-sm tensor): reconvert with --rot-blocks
+        GGML_ABORT("W4A4H: Hadamard length %d does not divide this row slice of %lld (ruquant convert --rot-blocks)",
+                   (int) n, (long long) k);
+    }
+    return n;
+}
+
+// activation group size: 64, or 128 / 256 with RQ_ACT_GROUP for experiments. Every backend reads it here.
+int ggml_rq_act_group(void) {
+    static int g = 0;
+    if (g == 0) {
+        const char * e = getenv("RQ_ACT_GROUP");
+        const int v = e ? atoi(e) : 64;
+        g = v == 128 || v == 256 ? v : 64;
+    }
+    return g;
+}
+
+// activations: per token, asymmetric, a scale and zero point per group of G = ggml_rq_act_group() values. Group g's
+// range is [min(x,0), max(x,0)] * clip. The token's widest range R sets a unit u = R / (15 * RQ_AG_M); group g's
+// scale is the smallest integer multiple m_g * u (m_g in 1..RQ_AG_M) covering its range. A block (256 values, S =
+// 256 / G groups) stores u in d, the zero points in sum (4 bits per group, log2(S) in bits 16..17), the multipliers
+// in pad[0] (8 bits per group) and the row length in pad[1]; codes are q - 8. The dot product stays an exact
+// integer: sum_g m_g * (acc_g + (8 - z_g) * colsum_g), times u, times s_w.
+static void rq_quantize_row_a(const float * GGML_RESTRICT x, block_w4a4 * GGML_RESTRICT y, int64_t k, float clip) {
+    GGML_ASSERT(k % QK_W4A4 == 0);
+    const int G = ggml_rq_act_group(), lsub = G == 64 ? 2 : G == 128 ? 1 : 0;
+    const int64_t ng = k / G;
+    float * lo = (float *) malloc(ng * 2 * sizeof(float));
+    float * hi = lo + ng;
+    float R = 0.0f;
+    for (int64_t g = 0; g < ng; ++g) {
+        float mn = 0.0f, mx = 0.0f;
+        for (int i = 0; i < G; ++i) { mn = fminf(mn, x[g*G + i]); mx = fmaxf(mx, x[g*G + i]); }
+        lo[g] = mn * clip;
+        hi[g] = mx * clip;
+        R = fmaxf(R, hi[g] - lo[g]);
+    }
+    if (R == 0.0f) R = 2.0f;
+    const float u = R / (15.0f * RQ_AG_M);
+    for (int64_t b = 0; b < k / QK_W4A4; ++b) {
+        y[b].d = u;
+        y[b].sum = lsub << 16;
+        y[b].pad[0] = 0;
+        y[b].pad[1] = (int32_t) k;
+    }
+    for (int64_t g = 0; g < ng; ++g) {
+        const int m = (int) fminf(fmaxf(ceilf(((hi[g] - lo[g]) * (float) RQ_AG_M) / R), 1.0f), (float) RQ_AG_M);
+        const float inv = 1.0f / ((float) m * u);
+        const float zf = fminf(fmaxf(rintf(-lo[g] * inv), 0.0f), 15.0f);
+        block_w4a4 * yb = &y[g*G / QK_W4A4];
+        const int sg = (int) (g % (QK_W4A4 / G));
+        yb->sum |= (int32_t) zf << (4*sg);
+        yb->pad[0] = (int32_t) ((uint32_t) yb->pad[0] | (uint32_t) m << (8*sg));
+        for (int w = sg*G/8; w < (sg + 1)*G/8; ++w) {
+            uint32_t word = 0;
+            for (int j = 0; j < 8; ++j) {
+                const float q = fminf(fmaxf(rintf(x[(g - sg)*G + 8*w + j] * inv) + zf, 0.0f), 15.0f);
+                word |= (uint32_t) (((int) q - 8) & 0xF) << (4*j);
+            }
+            yb->qs[w] = word;
+        }
+    }
+    free(lo);
+}
+
+void quantize_row_w4a4_ref(const float * GGML_RESTRICT x, block_w4a4 * GGML_RESTRICT y, int64_t k) {
+    rq_quantize_row_w(x, y, k);
+}
+
