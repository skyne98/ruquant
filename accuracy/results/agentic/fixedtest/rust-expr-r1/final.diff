@@ -0,0 +1,247 @@
+//! Tests for the expression language in SPEC.md.
+
+use calc::{eval, Error};
+use std::collections::HashMap;
+
+fn vars(pairs: &[(&str, f64)]) -> HashMap<String, f64> {
+    pairs.iter().copied().map(|(k, v)| (k.to_string(), v)).collect()
+}
+
+fn ok(src: &str, v: &HashMap<String, f64>) -> f64 {
+    eval(src, v).unwrap_or_else(|e| panic!("{src:?} => Err({e:?}), expected a value"))
+}
+
+/// Approximate equality, tight enough for the values in this spec.
+fn check(src: &str, v: &HashMap<String, f64>, want: f64) {
+    let got = ok(src, v);
+    assert!(
+        (got - want).abs() <= 1e-9 * want.abs().max(1.0),
+        "{src:?}: got {got}, want {want}"
+    );
+}
+
+fn check_exact(src: &str, v: &HashMap<String, f64>, want: f64) {
+    assert_eq!(ok(src, v), want, "for {src:?}");
+}
+
+fn check_err(src: &str, v: &HashMap<String, f64>, want: Error) {
+    let got = match eval(src, v) {
+        Err(e) => e,
+        Ok(x) => panic!("{src:?} => Ok({x}), expected Err({want:?})"),
+    };
+    assert_eq!(got, want, "for {src:?}");
+}
+
+fn empty() -> HashMap<String, f64> {
+    HashMap::new()
+}
+
+// ---------- numbers ----------
+
+#[test]
+fn number_literals() {
+    check_exact("3", &empty(), 3.0);
+    check_exact("3.25", &empty(), 3.25);
+    check_exact(".5", &empty(), 0.5);
+    check_exact("2e3", &empty(), 2000.0);
+    check_exact("1.5E-2", &empty(), 0.015);
+    check_exact("2E3", &empty(), 2000.0);
+    check_exact("2e+3", &empty(), 2000.0);
+    check_exact(".5e2", &empty(), 50.0);
+    check_exact("1.e3", &empty(), 1000.0); // `1.` is a number, `e3` its exponent
+}
+
+// ---------- operators and precedence ----------
+
+#[test]
+fn arithmetic() {
+    check_exact("1 + 2 * 3", &empty(), 7.0);
+    check_exact("(1 + 2) * 3", &empty(), 9.0);
+    check_exact("10 - 4 - 3", &empty(), 3.0); // left associative
+    check_exact("100 / 5 / 2", &empty(), 10.0); // left associative
+    check_exact("1 + 2 * 3 - 4", &empty(), 3.0);
+    check_exact("2 + 3 * 4 ^ 2", &empty(), 50.0);
+    check_exact("2 * 3 ^ 2", &empty(), 18.0);
+    check_exact("(2 + 3) * (4 - 1)", &empty(), 15.0);
+}
+
+#[test]
+fn remainder() {
+    check_exact("7 % 3", &empty(), 1.0);
+    check_exact("-7 % 3", &empty(), -1.0); // sign of the dividend
+    check_exact("7 % -3", &empty(), 1.0);
+    check_exact("-7 % -3", &empty(), -1.0);
+    check_exact("10 % 4", &empty(), 2.0);
+    check_exact("1 + 7 % 3", &empty(), 2.0);
+}
+
+// ---------- unary and ^ ----------
+
+#[test]
+fn unary() {
+    check_exact("-2", &empty(), -2.0);
+    check_exact("+2", &empty(), 2.0);
+    check_exact("--2", &empty(), 2.0);
+    check_exact("---2", &empty(), -2.0);
+    check_exact("-+2", &empty(), -2.0);
+    check_exact("- - 2", &empty(), 2.0);
+    check_exact("2 * -3", &empty(), -6.0);
+    check_exact("-2 * 3", &empty(), -6.0);
+    check_exact("1 + + 2", &empty(), 3.0); // unary + in operand position
+}
+
+#[test]
+fn power() {
+    // ^ binds tighter than unary minus: -2^2 is -(2^2)
+    check_exact("-2^2", &empty(), -4.0);
+    check_exact("--2^2", &empty(), 4.0);
+    // the exponent of ^ is a unary expression: 2^-1 is 0.5
+    check_exact("2^-1", &empty(), 0.5);
+    // right associative: 2^3^2 is 2^(3^2)
+    check_exact("2^3^2", &empty(), 512.0);
+    check_exact("2^2^3", &empty(), 256.0);
+    check_exact("2 ^ -3 ^ 2", &empty(), 2.0f64.powf(-9.0));
+    check_exact("-2^2 * 3", &empty(), -12.0);
+    check_exact("2 * -3 ^ 2", &empty(), -18.0);
+    check_exact("(1 + 2)^2", &empty(), 9.0);
+    check_exact("sqrt(9)^2", &empty(), 9.0);
+    check("2 ^ 0.5", &empty(), 2f64.sqrt());
+}
+
+// ---------- whitespace ----------
+
+#[test]
+fn whitespace_is_ignored() {
+    let v = vars(&[("x", 2.0), ("y", 3.0)]);
+    check_exact("  x  +  y ", &v, 5.0);
+    check_exact("\t1\n+2\r", &empty(), 3.0);
+    check_exact("( 1 + 2 )", &empty(), 3.0);
+    check_exact("min( 1 ,2, 3 )", &empty(), 1.0);
+}
+
+// ---------- identifiers and variables ----------
+
+#[test]
+fn variables() {
+    let v = vars(&[("x", 2.0), ("y", 3.0), ("_a1", 4.0), ("a_b", 5.0)]);
+    check_exact("x + y", &v, 5.0);
+    check_exact("_a1 + a_b", &v, 9.0);
+    check_exact("x*2", &v, 4.0);
+    // `e` is a variable name, not the start of a number
+    let v = vars(&[("e", 7.0)]);
+    check_exact("e + 1", &v, 8.0);
+}
+
+// ---------- functions ----------
+
+#[test]
+fn functions() {
+    check_exact("abs(-5)", &empty(), 5.0);
+    check_exact("abs(3)", &empty(), 3.0);
+    check_exact("sqrt(16)", &empty(), 4.0);
+    check_exact("min(3, 1, 2)", &empty(), 1.0);
+    check_exact("max(3, 1, 2)", &empty(), 3.0);
+    check_exact("min(5)", &empty(), 5.0);
+    check_exact("max(5)", &empty(), 5.0);
+    check_exact("min(1, 2) + max(3)", &empty(), 4.0);
+    check_exact("abs(abs(-2) + 1)", &empty(), 3.0);
+    check_exact("min(max(1, 2), 3)", &empty(), 2.0);
+    check_exact("min(1, 2, 3) * max(4, 5)", &empty(), 5.0);
+    check_exact("-sqrt(16)", &empty(), -4.0);
+    check("sqrt(2) * sqrt(2)", &empty(), 2.0);
+}
+
+// ---------- errors: tokenization ----------
+
+#[test]
+fn unexpected_char() {
+    check_err("2 $ 3", &empty(), Error::UnexpectedChar(2));
+    check_err("a $ b", &empty(), Error::UnexpectedChar(2));
+    check_err("#", &empty(), Error::UnexpectedChar(0));
+    // a `.` that starts no number is an unexpected character
+    check_err("2 . 3", &empty(), Error::UnexpectedChar(2));
+    // an exponent without digits leaves `e` an identifier in the wrong place
+    check_err("2e", &empty(), Error::UnexpectedToken(1));
+}
+
+// ---------- errors: end of input ----------
+
+#[test]
+fn unexpected_end() {
+    check_err("", &empty(), Error::UnexpectedEnd);
+    check_err("2 +", &empty(), Error::UnexpectedEnd);
+    check_err("(1", &empty(), Error::UnexpectedEnd);
+    check_err("min(1,", &empty(), Error::UnexpectedEnd);
+    check_err("2 + (3", &empty(), Error::UnexpectedEnd);
+    check_err("min(1, 2", &empty(), Error::UnexpectedEnd);
+    check_err("2 -", &empty(), Error::UnexpectedEnd);
+    check_err("2 *", &empty(), Error::UnexpectedEnd);
+    check_err("2 ^", &empty(), Error::UnexpectedEnd);
+}
+
+// ---------- errors: misplaced tokens ----------
+
+#[test]
+fn unexpected_token() {
+    check_err(")", &empty(), Error::UnexpectedToken(0));
+    check_err("(1))", &empty(), Error::UnexpectedToken(3));
+    check_err("2 3", &empty(), Error::UnexpectedToken(2));
+    check_err("()", &empty(), Error::UnexpectedToken(1));
+    check_err("1 + (2 3)", &empty(), Error::UnexpectedToken(7));
+    check_err("min(1 2)", &empty(), Error::UnexpectedToken(6));
+    check_err("2 , 3", &empty(), Error::UnexpectedToken(2));
+    check_err("(1, 2)", &empty(), Error::UnexpectedToken(2));
+}
+
+// ---------- errors: evaluation ----------
+
+#[test]
+fn unknown_variable() {
+    check_err("x", &empty(), Error::UnknownVariable("x".into()));
+    let v = vars(&[("x", 1.0)]);
+    check_err("x / y", &v, Error::UnknownVariable("y".into()));
+    // evaluation errors only come after the whole input has parsed
+    check_err("1 / 0 + x", &empty(), Error::DivisionByZero);
+    check_err("x / 0", &empty(), Error::UnknownVariable("x".into()));
+    check_err("1 / 0 + x + )", &empty(), Error::UnexpectedToken(12));
+}
+
+#[test]
+fn unknown_function() {
+    check_err("foo(1)", &empty(), Error::UnknownFunction("foo".into()));
+    check_err("foo(1) / 0", &empty(), Error::UnknownFunction("foo".into()));
+    // an identifier followed by `(` is a call, even when the name is a variable
+    let v = vars(&[("foo", 4.0)]);
+    check_err("foo(1)", &v, Error::UnknownFunction("foo".into()));
+}
+
+#[test]
+fn arity() {
+    check_err("abs()", &empty(), Error::Arity("abs".into(), 0));
+    check_err("abs(1, 2)", &empty(), Error::Arity("abs".into(), 2));
+    check_err("sqrt()", &empty(), Error::Arity("sqrt".into(), 0));
+    check_err("sqrt(1, 2)", &empty(), Error::Arity("sqrt".into(), 2));
+    check_err("min()", &empty(), Error::Arity("min".into(), 0));
+    check_err("max()", &empty(), Error::Arity("max".into(), 0));
+    check_err("abs(1, 1/0)", &empty(), Error::Arity("abs".into(), 2));
+}
+
+#[test]
+fn division_by_zero() {
+    check_err("1 / 0", &empty(), Error::DivisionByZero);
+    check_err("1 % 0", &empty(), Error::DivisionByZero);
+    check_err("0 / 0", &empty(), Error::DivisionByZero);
+    check_err("1 / (2 - 2)", &empty(), Error::DivisionByZero);
+    check_err("2 ^ (1 / 0)", &empty(), Error::DivisionByZero);
+    check_err("min(1/0, 2)", &empty(), Error::DivisionByZero);
+    check_err("min(1, 2) % 0", &empty(), Error::DivisionByZero);
+}
+
