+#[derive(Debug, Clone, PartialEq)]
+enum Tok {
+    Num(f64),
+    Ident(String),
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Mod,
+    Pow,
+    LParen,
+    RParen,
+    Comma,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum AddSub {
+    Add,
+    Sub,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum MulDivMod {
+    Mul,
+    Div,
+    Mod,
+}
+
+#[derive(Debug)]
+enum Node {
+    Num(f64),
+    Var(String),
+    Call(String, Vec<Node>),
+    Neg(Box<Node>),
+    Add(Box<Node>, Box<Node>),
+    Sub(Box<Node>, Box<Node>),
+    Mul(Box<Node>, Box<Node>),
+    Div(Box<Node>, Box<Node>),
+    Mod(Box<Node>, Box<Node>),
+    Pow(Box<Node>, Box<Node>),
+}
+
+/// Evaluates `src` as one expression, looking up variables in `vars`.
 pub fn eval(src: &str, vars: &HashMap<String, f64>) -> Result<f64, Error> {
-    todo!()
+    let mut p = Parser {
+        lex: Lexer { src, pos: 0 },
+        cur: None,
+    };
+    let node = p.parse()?;
+    eval_node(&node, vars)
+}
+
+// ---------- tokenizer ----------
+
+struct Lexer<'a> {
+    src: &'a str,
+    pos: usize,
+}
+
+impl<'a> Lexer<'a> {
+    /// The character starting at byte offset `i`, if any.
+    fn ch(&self, i: usize) -> Option<char> {
+        self.src.get(i..).and_then(|s| s.chars().next())
+    }
+
+    fn skip_ws(&mut self) {
+        while matches!(self.ch(self.pos), Some(' ' | '\t' | '\n' | '\r')) {
+            self.pos += self.ch(self.pos).unwrap().len_utf8();
+        }
+    }
+
+    /// Next token, or `None` at end of input. Errors when the character at the
+    /// current position can't start any token.
+    fn next(&mut self) -> Result<Option<(Tok, usize)>, Error> {
+        self.skip_ws();
+        let c = match self.ch(self.pos) {
+            Some(c) => c,
+            None => return Ok(None),
+        };
+        let start = self.pos;
+        let single = match c as u8 {
+            b'+' => Some(Tok::Add),
+            b'-' => Some(Tok::Sub),
+            b'*' => Some(Tok::Mul),
+            b'/' => Some(Tok::Div),
+            b'%' => Some(Tok::Mod),
+            b'^' => Some(Tok::Pow),
+            b'(' => Some(Tok::LParen),
+            b')' => Some(Tok::RParen),
+            b',' => Some(Tok::Comma),
+            _ => None,
+        };
+        let t = match single {
+            Some(t) => {
+                self.pos += c.len_utf8();
+                (t, start)
+            }
+            None if c.is_ascii_digit() || c == '.' => self.number(start)?,
+            None if c.is_alphabetic() || c == '_' => self.ident(start),
+            None => return Err(Error::UnexpectedChar(start)),
+        };
+        Ok(Some(t))
+    }
+
+    /// A number: digits with an optional fraction and an optional exponent.
+    /// Needs at least one digit in the mantissa; an exponent without digits is
+    /// not consumed (the letter stays available as an identifier).
+    fn number(&mut self, start: usize) -> Result<(Tok, usize), Error> {
+        let mut digits = 0usize;
+        while self.ch(self.pos).map_or(false, |c| c.is_ascii_digit()) {
+            self.pos += 1;
+            digits += 1;
+        }
+        if self.ch(self.pos) == Some('.') {
+            self.pos += 1;
+            while self.ch(self.pos).map_or(false, |c| c.is_ascii_digit()) {
+                self.pos += 1;
+                digits += 1;
+            }
+        }
+        if matches!(self.ch(self.pos), Some('e' | 'E')) {
+            let mut i = self.pos + 1;
+            if matches!(self.ch(i), Some('+' | '-')) {
+                i += 1;
+            }
+            let mut exp = 0usize;
+            while self.ch(i).map_or(false, |c| c.is_ascii_digit()) {
+                i += 1;
+                exp += 1;
+            }
+            if exp > 0 {
+                self.pos = i;
+            }
+        }
+        if digits == 0 {
+            return Err(Error::UnexpectedChar(start));
+        }
+        let text = &self.src[start..self.pos];
+        let v = text.parse::<f64>().unwrap();
+        Ok((Tok::Num(v), start))
+    }
+
+    /// An identifier: a letter or `_`, then letters, digits or `_`.
+    fn ident(&mut self, start: usize) -> (Tok, usize) {
+        loop {
+            match self.ch(self.pos) {
+                Some(c) if c.is_alphanumeric() || c == '_' => self.pos += c.len_utf8(),
+                _ => break,
+            }
+        }
+        let name = self.src[start..self.pos].to_string();
+        (Tok::Ident(name), start)
+    }
+}
+
+// ---------- parser ----------
+
+struct Parser<'a> {
+    lex: Lexer<'a>,
+    cur: Option<(Tok, usize)>,
+}
+
+impl<'a> Parser<'a> {
+    fn peek(&mut self) -> Result<Option<(Tok, usize)>, Error> {
+        if self.cur.is_none() {
+            self.cur = self.lex.next()?;
+        }
+        Ok(self.cur.clone())
+    }
+
+    fn bump(&mut self) -> Result<Option<(Tok, usize)>, Error> {
+        if self.cur.is_none() {
+            self.cur = self.lex.next()?;
+        }
+        Ok(self.cur.take())
+    }
+
+    /// Whole input: one expression, then end.
+    fn parse(&mut self) -> Result<Node, Error> {
+        let node = self.parse_expr()?;
+        match self.peek()? {
+            None => Ok(node),
+            Some((_, pos)) => Err(Error::UnexpectedToken(pos)),
+        }
+    }
+
+    // `+ -`, left associative.
+    fn parse_expr(&mut self) -> Result<Node, Error> {
+        let mut left = self.parse_mul()?;
+        loop {
+            let op = match self.peek()? {
+                Some((Tok::Add, _)) => Some(AddSub::Add),
+                Some((Tok::Sub, _)) => Some(AddSub::Sub),
+                _ => None,
+            };
+            let Some(op) = op else { break };
+            self.bump()?;
+            let r = self.parse_mul()?;
+            left = match op {
+                AddSub::Add => Node::Add(Box::new(left), Box::new(r)),
+                AddSub::Sub => Node::Sub(Box::new(left), Box::new(r)),
+            };
+        }
+        Ok(left)
+    }
+
+    // `* / %`, left associative.
+    fn parse_mul(&mut self) -> Result<Node, Error> {
+        let mut left = self.parse_unary()?;
+        loop {
+            let op = match self.peek()? {
+                Some((Tok::Mul, _)) => Some(MulDivMod::Mul),
+                Some((Tok::Div, _)) => Some(MulDivMod::Div),
+                Some((Tok::Mod, _)) => Some(MulDivMod::Mod),
+                _ => None,
+            };
+            let Some(op) = op else { break };
+            self.bump()?;
+            let r = self.parse_unary()?;
+            left = match op {
+                MulDivMod::Mul => Node::Mul(Box::new(left), Box::new(r)),
+                MulDivMod::Div => Node::Div(Box::new(left), Box::new(r)),
+                MulDivMod::Mod => Node::Mod(Box::new(left), Box::new(r)),
+            };
+        }
+        Ok(left)
+    }
+
+    // unary `+ -`, repeatable; below `^` in precedence.
+    fn parse_unary(&mut self) -> Result<Node, Error> {
+        match self.peek()? {
+            Some((Tok::Add, _)) => {
+                self.bump()?;
+                self.parse_unary()
+            }
+            Some((Tok::Sub, _)) => {
+                self.bump()?;
+                Ok(Node::Neg(Box::new(self.parse_unary()?)))
+            }
+            _ => self.parse_power(),
+        }
+    }
+
+    // `^`, right associative, tighter than unary: the exponent is a unary
+    // expression, the base is an atom.
+    fn parse_power(&mut self) -> Result<Node, Error> {
+        let base = self.parse_atom()?;
+        if matches!(self.peek()?, Some((Tok::Pow, _))) {
+            self.bump()?;
+            let exp = self.parse_unary()?;
+            Ok(Node::Pow(Box::new(base), Box::new(exp)))
+        } else {
+            Ok(base)
+        }
+    }
+
+    // numbers, identifiers, calls, parenthesized expressions.
+    fn parse_atom(&mut self) -> Result<Node, Error> {
+        match self.bump()? {
+            None => Err(Error::UnexpectedEnd),
+            Some((Tok::Num(v), _)) => Ok(Node::Num(v)),
+            Some((Tok::Ident(name), _)) => {
+                if matches!(self.peek()?, Some((Tok::LParen, _))) {
+                    self.bump()?;
+                    // An empty argument list is a parse success; it fails later
+                    // as an arity error.
+                    let mut args = Vec::new();
+                    if !matches!(self.peek()?, Some((Tok::RParen, _))) {
+                        args.push(self.parse_expr()?);
+                    }
+                    loop {
+                        match self.peek()? {
+                            Some((Tok::Comma, _)) => {
+                                self.bump()?;
+                                args.push(self.parse_expr()?);
+                            }
+                            Some((Tok::RParen, _)) => {
+                                self.bump()?;
+                                break;
+                            }
+                            Some((_, pos)) => return Err(Error::UnexpectedToken(pos)),
+                            None => return Err(Error::UnexpectedEnd),
+                        }
+                    }
+                    Ok(Node::Call(name, args))
+                } else {
+                    Ok(Node::Var(name))
+                }
+            }
+            Some((Tok::LParen, _)) => {
+                let e = self.parse_expr()?;
+                match self.bump()? {
+                    Some((Tok::RParen, _)) => Ok(e),
+                    Some((_, pos)) => Err(Error::UnexpectedToken(pos)),
+                    None => Err(Error::UnexpectedEnd),
+                }
+            }
+            Some((_, pos)) => Err(Error::UnexpectedToken(pos)),
+        }
+    }
+}
+
+// ---------- evaluation ----------
+
+fn eval_node(node: &Node, vars: &HashMap<String, f64>) -> Result<f64, Error> {
+    match node {
+        Node::Num(v) => Ok(*v),
+        Node::Var(name) => vars
+            .get(name)
+            .copied()
+            .ok_or_else(|| Error::UnknownVariable(name.clone())),
+        Node::Neg(x) => Ok(-eval_node(x, vars)?),
+        Node::Add(l, r) => Ok(eval_node(l, vars)? + eval_node(r, vars)?),
+        Node::Sub(l, r) => Ok(eval_node(l, vars)? - eval_node(r, vars)?),
+        Node::Mul(l, r) => Ok(eval_node(l, vars)? * eval_node(r, vars)?),
+        Node::Div(l, r) => {
+            let a = eval_node(l, vars)?;
+            let b = eval_node(r, vars)?;
+            if b == 0.0 {
+                return Err(Error::DivisionByZero);
+            }
+            Ok(a / b)
+        }
+        Node::Mod(l, r) => {
+            let a = eval_node(l, vars)?;
+            let b = eval_node(r, vars)?;
+            if b == 0.0 {
+                return Err(Error::DivisionByZero);
+            }
+            Ok(a % b)
+        }
+        Node::Pow(l, r) => Ok(eval_node(l, vars)?.powf(eval_node(r, vars)?)),
+        Node::Call(name, args) => {
+            match name.as_str() {
+                "abs" => {
+                    if args.len() != 1 {
+                        return Err(Error::Arity(name.clone(), args.len()));
+                    }
+                    Ok(eval_node(&args[0], vars)?.abs())
+                }
+                "sqrt" => {
+                    if args.len() != 1 {
+                        return Err(Error::Arity(name.clone(), args.len()));
+                    }
+                    Ok(eval_node(&args[0], vars)?.sqrt())
+                }
+                "min" | "max" => {
+                    if args.is_empty() {
+                        return Err(Error::Arity(name.clone(), args.len()));
+                    }
+                    let mut it = args.iter();
+                    let mut acc = eval_node(it.next().unwrap(), vars)?;
+                    for a in it {
+                        let v = eval_node(a, vars)?;
+                        acc = if name == "min" { acc.min(v) } else { acc.max(v) };
+                    }
+                    Ok(acc)
+                }
+                _ => Err(Error::UnknownFunction(name.clone())),
+            }
+        }
+    }
 }
