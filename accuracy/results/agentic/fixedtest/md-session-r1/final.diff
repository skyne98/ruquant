+"""mdlite: a small Markdown-to-HTML converter.
+
+It converts a small subset of Markdown to HTML:
+
+* A blank line (empty or only whitespace) separates blocks.
+* A line starting with 1 to 6 ``#`` characters followed by a space is an
+  ATX heading, e.g. ``## Some title`` -> ``<h2>Some title</h2>``.  A
+  heading is always a block of its own, even without blank lines around
+  it.  ``#Title`` (no space) and seven or more ``#`` are ordinary text.
+* Lines starting with ``- `` or ``* `` are unordered list items and lines
+  starting with a number, a dot, and a space (``1. ``, ``10. ``) are
+  ordered list items.  Consecutive items of the same kind form one
+  ``<ul>`` or ``<ol>`` block; the list ends at a blank line, at an item
+  of the other kind, or at a line that is not an item (which starts a new
+  paragraph).  An item line also ends a pending paragraph.
+* A line that is ```` ``` ```` (optionally followed by a language) opens
+  a fenced code block; the next line that is exactly ```` ``` ```` closes
+  it.  The lines in between are emitted verbatim -- escaped, but not
+  formatted, indentation kept -- inside ``<pre><code>``.
+* Any other run of consecutive non-blank lines is a paragraph: each line
+  is stripped and the lines are joined with a single space.
+* Inline, inside headings, list items and paragraphs:
+  ``**bold**`` -> ``<strong>``, ``*italic*`` -> ``<em>``, and
+  `` `code` `` -> ``<code>``.  A code span is escaped but never
+  formatted; an opening ``*`` or ``**`` must be followed by a non-space
+  character and the closing marker must be preceded by one.
+* ``[text](url)`` is a link: ``<a href="url">text</a>``.  Inline
+  formatting applies to the text; in the URL ``&`` is escaped to
+  ``&amp;`` and ``"`` to ``&quot;``.  Nothing inside a code span becomes
+  a link.
+* ``&``, ``<`` and ``>`` in text are escaped to ``&amp;``, ``&lt;`` and
+  ``&gt;``.
+* The output is the block elements joined with ``\\n`` and has no
+  trailing newline; empty input gives ``""``.
+"""
+
+from __future__ import annotations
+
+import re
+
+__all__ = ["to_html"]
+
+# 1 to 6 '#' characters followed by a space; the rest is the title.
+_HEADING = re.compile(r"^(#{1,6}) (.*)$")
+
+# A line starting with '- ' or '* ' is an unordered list item.
+_UL_ITEM = re.compile(r"^[-*] (.*)$")
+
+# A line starting with one or more digits, a dot, and a space is an
+# ordered list item; the number itself is discarded.
+_OL_ITEM = re.compile(r"^[0-9]+\. (.*)$")
+
+# A fence line: three backticks, optionally followed by a language.
+_FENCE = re.compile(r"^```\s*(\S.*)?$")
+
+
+def _escape(text: str) -> str:
+    """Escape the HTML metacharacters ``&``, ``<`` and ``>``.
+
+    ``&`` is escaped first so that characters escaped later are not
+    double-escaped.
+    """
+    return (
+        text.replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+    )
+
+
+def _non_space(text: str, idx: int) -> bool:
+    """True if ``text[idx]`` exists and is not a whitespace character."""
+    return idx >= 0 and not text[idx].isspace()
+
+
+def _past_code_span(text: str, i: int) -> int:
+    """Index just past the code span opened at *i*, else *i* + 1.
+
+    ``text[i]`` is a backtick.  Code spans are paired left to right:
+    each backtick pairs with the next one.  An unpaired backtick is
+    literal text, so the result is simply *i* + 1.
+    """
+    j = text.find("`", i + 1)
+    return j + 1 if j != -1 else i + 1
+
+
+def _find_close(text: str, start: int, double: bool) -> int:
+    """Index of the first valid closing marker at or after *start*, else -1.
+
+    A closing marker is ``*`` (or ``**`` when *double*) preceded by a
+    non-space character.  Code spans are skipped, so a ``*`` inside a
+    code span can never close an emphasis span.
+    """
+    n = len(text)
+    j = start
+    while j < n:
+        if text[j] == "`":
+            j = _past_code_span(text, j)
+            continue
+        if text[j] == "*":
+            if double:
+                if (
+                    j + 1 < n
+                    and text[j + 1] == "*"
+                    and _non_space(text, j - 1)
+                ):
+                    return j
+            elif _non_space(text, j - 1):
+                return j
+        j += 1
+    return -1
+
+
+def _find_link(text: str, i: int) -> tuple[str, str, int] | None:
+    """Match a ``[text](url)`` link opened at *i*, where ``text[i] == "["``.
+
+    Returns ``(link_text, url, end)`` where *end* is the index just past
+    the closing parenthesis, or None.  Code spans are skipped while
+    scanning, so neither link markers nor brackets inside code spans can
+    take part in a link.
+    """
+    n = len(text)
+    j = i + 1
+    while j < n:
+        if text[j] == "`":
+            j = _past_code_span(text, j)
+            continue
+        if text[j] == "]" and j + 1 < n and text[j + 1] == "(":
+            k = j + 2
+            while k < n:
+                if text[k] == "`":
+                    k = _past_code_span(text, k)
+                    continue
+                if text[k] == ")":
+                    return text[i + 1:j], text[j + 2:k], k + 1
+                k += 1
+        j += 1
+    return None
+
+
+def _escape_url(url: str) -> str:
+    """Escape an ``href`` attribute: ``&`` and ``"`` only."""
+    return url.replace("&", "&amp;").replace('"', "&quot;")
+
+
+def _inline(text: str) -> str:
+    """Render the inline formatting of *text* as HTML.
+
+    Scans left to right, formatting code spans, ``[text](url)`` links,
+    ``**bold**`` and ``*italic*``.  A code span's content is escaped but
+    never formatted; the content of a link or an emphasis span is
+    processed recursively, so the syntaxes can nest.  An opening ``*``
+    or ``**`` must be followed by a non-space character and the matching
+    closing marker must be preceded by one; markers without a partner
+    are left as literal text.
+    """
+    out: list[str] = []
+    i = 0
+    n = len(text)
+    while i < n:
+        c = text[i]
+        if c == "`":
+            j = text.find("`", i + 1)
+            if j == -1:
+                out.append("`")
+                i += 1
+                continue
+            out.append(f"<code>{_escape(text[i + 1:j])}</code>")
+            i = j + 1
+            continue
+        if c == "[":
+            link = _find_link(text, i)
+            if link is not None:
+                span, url, end = link
+                out.append(
+                    f'<a href="{_escape_url(url)}">'
+                    f"{_inline(span)}</a>"
+                )
+                i = end
+                continue
+            out.append("[")
+            i += 1
+            continue
+        if c == "*" and i + 1 < n and text[i + 1] == "*":
+            if i + 2 < n and not text[i + 2].isspace():
+                j = _find_close(text, i + 2, True)
+                if j != -1:
+                    out.append(
+                        "<strong>" + _inline(text[i + 2:j]) + "</strong>"
+                    )
+                    i = j + 2
+                    continue
+            # No valid bold pair: leave one star literal and move on.
+            out.append("*")
+            i += 1
+            continue
+        if c == "*" and i + 1 < n and not text[i + 1].isspace():
+            j = _find_close(text, i + 1, False)
+            if j != -1:
+                out.append("<em>" + _inline(text[i + 1:j]) + "</em>")
+                i = j + 1
+                continue
+        out.append(_escape(c))
+        i += 1
+    return "".join(out)
+
+
+def to_html(text: str) -> str:
+    """Convert the Markdown-ish *text* to a string of HTML blocks.
+
+    Blocks are separated by ``\\n`` and the result has no trailing
+    newline.  Empty or blank-only input gives ``""``.
+    """
+    blocks: list[str] = []
+    paragraph: list[str] = []
+    list_kind: str | None = None
+    list_items: list[str] = []
+    code_block: list[str] | None = None
+    code_lang = ""
+
+    def flush_paragraph() -> None:
+        if paragraph:
+            blocks.append(f"<p>{_inline(' '.join(paragraph))}</p>")
+            paragraph.clear()
+
+    def flush_list() -> None:
+        nonlocal list_kind
+        if list_kind is not None:
+            items = "\n".join(
+                f"<li>{_inline(item)}</li>" for item in list_items
+            )
+            tag = list_kind
+            blocks.append(f"<{tag}>\n{items}\n</{tag}>")
+            list_kind = None
+            list_items.clear()
+
+    def flush_code() -> None:
+        nonlocal code_block
+        if code_block is not None:
+            content = "\n".join(_escape(line) for line in code_block)
+            if code_lang:
+                blocks.append(
+                    f'<pre><code class="language-{code_lang}">'
+                    f"{content}</code></pre>"
+                )
+            else:
+                blocks.append(f"<pre><code>{content}</code></pre>")
+            code_block = None
+
+    for raw_line in text.splitlines():
+        stripped = raw_line.strip()
+
+        # Inside a fenced code block everything is literal, blank lines
+        # included; only a line that is exactly ``` closes the block.
+        if code_block is not None:
+            if stripped == "```":
+                flush_code()
+            else:
+                code_block.append(raw_line)
+            continue
+
+        fence = _FENCE.match(stripped)
+        if fence is not None:
+            # A fence ends any pending paragraph or list and opens a
+            # code block.
+            flush_paragraph()
+            flush_list()
+            code_lang = fence.group(1) or ""
+            code_block = []
+            continue
+
+        # Heading detection is positional (the line must *start* with the
+        # hashes), so it runs on the raw line, before any stripping.
+        match = _HEADING.match(raw_line)
+        if match is not None:
+            # A heading is a block of its own and ends any pending
+            # paragraph or list.
+            flush_paragraph()
+            flush_list()
+            level = len(match.group(1))
+            title = match.group(2).strip()
+            blocks.append(f"<h{level}>{_inline(title)}</h{level}>")
+            continue
+
+        m_ul = _UL_ITEM.match(raw_line)
+        m_ol = _OL_ITEM.match(raw_line)
+        if m_ul is not None or m_ol is not None:
+            # An item line ends a pending paragraph; an item of the other
+            # kind ends the current list and starts a new one.
+            flush_paragraph()
+            kind = "ul" if m_ul is not None else "ol"
+            if list_kind != kind:
+                flush_list()
+                list_kind = kind
+            list_items.append((m_ul or m_ol).group(1).strip())
+            continue
+
+        # Any other line ends the current list, if there is one.
+        flush_list()
+        if stripped:
+            paragraph.append(stripped)
+        else:
+            # Blank line: close the current paragraph, if any.
+            flush_paragraph()
+
+    flush_paragraph()
+    flush_list()
+    flush_code()
+    return "\n".join(blocks)
