+# ---------------------------------------------------------------------------
+# Command line interface
+# ---------------------------------------------------------------------------
+
+def _run_cli(args, stdin=None):
+    return subprocess.run(
+        [sys.executable, "-m", "mdlite", *args],
+        input=stdin,
+        capture_output=True,
+        text=True,
+        cwd=REPO_ROOT,
+    )
+
+
+def test_cli_reads_file(tmp_path):
+    src = tmp_path / "doc.md"
+    src.write_text("# T\n\n* a **b**\n", encoding="utf-8")
+    proc = _run_cli([str(src)])
+    assert proc.returncode == 0
+    assert proc.stdout == to_html(src.read_text(encoding="utf-8")) + "\n"
+
+
+def test_cli_reads_stdin():
+    proc = _run_cli([], stdin="# T\n\ntext")
+    assert proc.returncode == 0
+    assert proc.stdout == to_html("# T\n\ntext") + "\n"
+
+
+def test_cli_empty_stdin_prints_only_newline():
+    proc = _run_cli([], stdin="")
+    assert proc.returncode == 0
+    assert proc.stdout == "\n"
