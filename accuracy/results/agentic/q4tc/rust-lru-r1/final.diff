 //! A least-recently-used cache with a fixed capacity.
 
+use std::collections::HashMap;
 use std::hash::Hash;
 
 /// A map that holds at most `capacity` entries. When a new key is inserted into a full cache, the least recently
 /// used entry is evicted. `get` and `put` count as uses; `peek` does not.
 ///
 /// All operations except `iter` and `resize` are O(1) on average.
+///
+/// Entries live in a `Vec` of nodes whose `prev`/`next` fields form a doubly linked list ordered from most
+/// recently used (head) to least recently used (tail). The map sends each key straight to its node, so lookups,
+/// inserts, and removals are O(1); removing a node swaps it with the vec's last element and repairs the
+/// affected links, so memory stays O(capacity).
 pub struct LruCache<K, V> {
-    _marker: std::marker::PhantomData<(K, V)>,
+    map: HashMap<K, usize>,
+    nodes: Vec<Node<K, V>>,
+    head: Option<usize>,
+    tail: Option<usize>,
+    capacity: usize,
+}
+
+struct Node<K, V> {
+    key: K,
+    value: V,
+    prev: Option<usize>,
+    next: Option<usize>,
 }
 
 impl<K: Hash + Eq + Clone, V> LruCache<K, V> {
     /// Panics if `capacity` is 0.
     pub fn new(capacity: usize) -> Self {
-        todo!()
+        assert!(capacity > 0, "capacity must be non-zero");
+        Self {
+            map: HashMap::new(),
+            nodes: Vec::new(),
+            head: None,
+            tail: None,
+            capacity,
+        }
     }
 
     /// Returns the value and marks the entry as most recently used.
     pub fn get(&mut self, key: &K) -> Option<&V> {
-        todo!()
+        let i = *self.map.get(key)?;
+        self.move_to_head(i);
+        Some(&self.nodes[i].value)
     }
 
     /// Like `get`, but returns a mutable reference.
     pub fn get_mut(&mut self, key: &K) -> Option<&mut V> {
-        todo!()
+        let i = *self.map.get(key)?;
+        self.move_to_head(i);
+        Some(&mut self.nodes[i].value)
     }
 
     /// Returns the value without changing the order.
     pub fn peek(&self, key: &K) -> Option<&V> {
-        todo!()
+        let i = *self.map.get(key)?;
+        Some(&self.nodes[i].value)
     }
 
     /// Inserts or replaces a value and marks it as most recently used. Returns the old value if the key was
     /// present. If the key is new and the cache is full, the least recently used entry is evicted first.
     pub fn put(&mut self, key: K, value: V) -> Option<V> {
-        todo!()
+        if let Some(&i) = self.map.get(&key) {
+            self.unlink(i);
+            let old = std::mem::replace(&mut self.nodes[i].value, value);
+            self.attach_head(i);
+            return Some(old);
+        }
+        if self.nodes.len() == self.capacity {
+            let t = self.tail.expect("a full cache with non-zero capacity is non-empty");
+            self.remove_node(t);
+        }
+        self.insert_head(key, value);
+        None
     }
 
     /// Removes an entry and returns its value.
     pub fn remove(&mut self, key: &K) -> Option<V> {
-        todo!()
+        let i = self.map.remove(key)?;
+        let (_, value) = self.remove_node(i);
+        Some(value)
     }
 
     /// Removes and returns the least recently used entry.
     pub fn pop_lru(&mut self) -> Option<(K, V)> {
-        todo!()
+        let t = self.tail?;
+        Some(self.remove_node(t))
     }
 
     pub fn contains(&self, key: &K) -> bool {
-        todo!()
+        self.map.contains_key(key)
     }
 
     pub fn len(&self) -> usize {
-        todo!()
+        self.nodes.len()
     }
 
     pub fn is_empty(&self) -> bool {
-        todo!()
+        self.nodes.is_empty()
     }
 
     pub fn capacity(&self) -> usize {
-        todo!()
+        self.capacity
     }
 
     /// Changes the capacity, evicting least recently used entries until `len() <= capacity`. Panics if
     /// `capacity` is 0.
     pub fn resize(&mut self, capacity: usize) {
-        todo!()
+        assert!(capacity > 0, "capacity must be non-zero");
+        self.capacity = capacity;
+        while self.nodes.len() > capacity {
+            let t = self.tail.expect("len > capacity >= 1 implies the cache is non-empty");
+            self.remove_node(t);
+        }
     }
 
     /// Removes every entry.
     pub fn clear(&mut self) {
-        todo!()
+        self.nodes.clear();
+        self.map.clear();
+        self.head = None;
+        self.tail = None;
     }
 
     /// Iterates from the most recently used entry to the least recently used one.
     pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> + '_ {
-        std::iter::empty()
+        let mut cur = self.head;
+        std::iter::from_fn(move || {
+            let i = cur?;
+            cur = self.nodes[i].next;
+            Some((&self.nodes[i].key, &self.nodes[i].value))
+        })
+    }
+
+    /// Unlinks node `i` from the list, leaving it in `nodes`.
+    fn unlink(&mut self, i: usize) {
+        let prev = self.nodes[i].prev;
+        let next = self.nodes[i].next;
+        if let Some(p) = prev {
+            self.nodes[p].next = next;
+        } else {
+            self.head = next;
+        }
+        if let Some(n) = next {
+            self.nodes[n].prev = prev;
+        } else {
+            self.tail = prev;
+        }
+        self.nodes[i].prev = None;
+        self.nodes[i].next = None;
+    }
+
+    /// Links the unlinked node `i` in front of the current head.
+    fn attach_head(&mut self, i: usize) {
+        let old_head = self.head;
+        self.nodes[i].prev = None;
+        self.nodes[i].next = old_head;
+        if let Some(h) = old_head {
+            self.nodes[h].prev = Some(i);
+        }
+        self.head = Some(i);
+        if self.tail.is_none() {
+            self.tail = Some(i);
+        }
+    }
+
+    fn move_to_head(&mut self, i: usize) {
+        if self.head == Some(i) {
+            return;
+        }
+        self.unlink(i);
+        self.attach_head(i);
+    }
+
+    /// Pushes a new node at the head of the list (most recently used).
+    fn insert_head(&mut self, key: K, value: V) {
+        let i = self.nodes.len();
+        let old_head = self.head;
+        self.nodes.push(Node { key, value, prev: None, next: old_head });
+        if let Some(h) = old_head {
+            self.nodes[h].prev = Some(i);
+        }
+        self.head = Some(i);
+        if self.tail.is_none() {
+            self.tail = Some(i);
+        }
+        self.map.insert(self.nodes[i].key.clone(), i);
+    }
+
+    /// Unlinks node `i` and removes it from `nodes`, returning its key and value.
+    fn remove_node(&mut self, i: usize) -> (K, V) {
+        self.unlink(i);
+
+        let removed = self.nodes.swap_remove(i);
+        // If a node was swapped into slot `i`, its own `prev`/`next` are still correct, but its
+        // neighbours (and `head`/`tail` if it is at an end) still point at its old index.
+        let last = self.nodes.len();
+        if last != i {
+            let prev = self.nodes[i].prev;
+            let next = self.nodes[i].next;
+            if let Some(p) = prev {
+                self.nodes[p].next = Some(i);
+            } else {
+                self.head = Some(i);
+            }
+            if let Some(n) = next {
+                self.nodes[n].prev = Some(i);
+            } else {
+                self.tail = Some(i);
+            }
+            self.map.insert(self.nodes[i].key.clone(), i);
+        }
+        self.map.remove(&removed.key);
+        (removed.key, removed.value)
+    }
+}
