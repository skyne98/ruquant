+#[cfg(test)]
+mod tests {
+    use super::LruCache;
+
+    #[test]
+    fn empty_cache() {
+        let mut c: LruCache<u32, u32> = LruCache::new(4);
+        assert_eq!(c.capacity(), 4);
+        assert_eq!(c.len(), 0);
+        assert!(c.is_empty());
+        assert!(!c.contains(&0));
+        assert_eq!(c.get(&0), None);
+        assert_eq!(c.peek(&0), None);
+        assert_eq!(c.get_mut(&0), None);
+        assert_eq!(c.remove(&0), None);
+        assert_eq!(c.pop_lru(), None);
+        assert_eq!(c.iter().count(), 0);
+    }
+
+    #[test]
+    #[should_panic]
+    fn new_zero_panics() {
+        let _ = LruCache::<u8, u8>::new(0);
+    }
+
+    #[test]
+    fn put_get_peek() {
+        let mut c = LruCache::new(2);
+        assert_eq!(c.put('a', 1), None);
+        assert_eq!(c.put('a', 10), Some(1));
+        assert_eq!(c.len(), 1);
+        assert_eq!(c.get(&'a'), Some(&10));
+        assert_eq!(c.peek(&'a'), Some(&10));
+        assert_eq!(c.peek(&'b'), None);
+        assert!(c.contains(&'a'));
+    }
+
+    #[test]
+    fn get_refreshes_order() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        c.get(&'a'); // order is now b (lru), a (mru)
+        c.put('c', 3); // evicts 'b', not 'a'
+        assert_eq!(c.get(&'a'), Some(&1));
+        assert_eq!(c.get(&'c'), Some(&3));
+        assert_eq!(c.contains(&'b'), false);
+    }
+
+    #[test]
+    fn get_mut_refreshes_order_and_mutates() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        *c.get_mut(&'a').unwrap() += 10;
+        assert_eq!(c.get(&'a'), Some(&11));
+        c.put('c', 3); // evicts 'b', not 'a'
+        assert_eq!(c.contains(&'b'), false);
+        assert_eq!(c.get_mut(&'c'), Some(&mut 3));
+        assert_eq!(c.get_mut(&'z'), None);
+    }
+
+    #[test]
+    fn peek_does_not_refresh_order() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        assert_eq!(c.peek(&'a'), Some(&1));
+        c.put('c', 3); // evicts 'a' because peek did not refresh it
+        assert_eq!(c.contains(&'a'), false);
+        assert_eq!(c.contains(&'b'), true);
+        assert_eq!(c.contains(&'c'), true);
+    }
+
+    #[test]
+    fn put_replaces_existing_without_evicting() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        assert_eq!(c.put('b', 20), Some(2));
+        assert_eq!(c.len(), 2);
+        assert_eq!(c.get(&'b'), Some(&20));
+        // 'b' is now MRU, so 'a' is LRU
+        c.put('c', 3);
+        assert_eq!(c.contains(&'a'), false);
+        assert_eq!(c.contains(&'b'), true);
+        assert_eq!(c.contains(&'c'), true);
+    }
+
+    #[test]
+    fn eviction_is_least_recently_used() {
+        let mut c: LruCache<char, u32> = LruCache::new(3);
+        c.put('a', 1);
+        c.put('b', 2);
+        c.put('c', 3);
+        c.get(&'a'); // order: a (mru), c, b (lru)
+        c.put('d', 4); // evicts 'b'
+        assert_eq!(c.contains(&'b'), false);
+        assert!(c.contains(&'a') && c.contains(&'c') && c.contains(&'d'));
+        assert_eq!(c.len(), 3);
+    }
+
+    #[test]
+    fn remove_frees_capacity() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        assert_eq!(c.remove(&'a'), Some(1));
+        assert_eq!(c.remove(&'a'), None);
+        assert_eq!(c.len(), 1);
+        c.put('c', 3); // no eviction needed: capacity was freed
+        assert_eq!(c.get(&'b'), Some(&2));
+        assert_eq!(c.get(&'c'), Some(&3));
+    }
+
+    #[test]
+    fn pop_lru() {
+        let mut c = LruCache::new(3);
+        assert_eq!(c.pop_lru(), None);
+        c.put('a', 1);
+        c.put('b', 2);
+        c.get(&'a');
+        assert_eq!(c.pop_lru(), Some(('b', 2)));
+        assert_eq!(c.pop_lru(), Some(('a', 1)));
+        assert_eq!(c.pop_lru(), None);
+        assert!(c.is_empty());
+        // works after being emptied
+        c.put('x', 9);
+        assert_eq!(c.pop_lru(), Some(('x', 9)));
+    }
+
+    #[test]
+    fn iter_mru_to_lru_and_values() {
+        let mut c = LruCache::new(3);
+        c.put(1, "one");
+        c.put(2, "two");
+        c.put(3, "three");
+        c.get(&2);
+        let v: Vec<_> = c.iter().collect();
+        assert_eq!(v, vec![(&2, &"two"), (&3, &"three"), (&1, &"one")]);
+    }
+
+    #[test]
+    fn iter_does_not_change_order() {
+        let mut c = LruCache::new(3);
+        c.put('a', 1);
+        c.put('b', 2);
+        c.put('c', 3);
+        for _ in c.iter() {}
+        assert_eq!(c.pop_lru(), Some(('a', 1)));
+    }
+
+    #[test]
+    fn capacity_one() {
+        let mut c = LruCache::new(1);
+        c.put(1, "a");
+        c.put(2, "b");
+        assert_eq!(c.get(&1), None);
+        assert_eq!(c.get(&2), Some(&"b"));
+        assert_eq!(c.len(), 1);
+        // replacing the sole entry keeps it
+        assert_eq!(c.put(2, "c"), Some("b"));
+        assert_eq!(c.get(&2), Some(&"c"));
+    }
+
+    #[test]
+    fn resize_down_evicts_lru() {
+        let mut c = LruCache::new(3);
+        c.put(1, 10);
+        c.put(2, 20);
+        c.put(3, 30);
+        c.resize(2);
+        assert_eq!(c.capacity(), 2);
+        assert_eq!(c.len(), 2);
+        assert_eq!(c.get(&1), None);
+        assert_eq!(c.get(&2), Some(&20));
+        assert_eq!(c.get(&3), Some(&30));
+        // growing the capacity evicts nothing
+        c.resize(5);
+        assert_eq!(c.capacity(), 5);
+        assert_eq!(c.len(), 2);
+        c.put(4, 40);
+        c.put(5, 50);
+        assert_eq!(c.len(), 4);
+    }
+
+    #[test]
+    #[should_panic]
+    fn resize_zero_panics() {
+        let mut c = LruCache::<u8, u8>::new(2);
+        c.resize(0);
+    }
+
+    #[test]
+    fn clear() {
+        let mut c = LruCache::new(2);
+        c.put('a', 1);
+        c.put('b', 2);
+        c.clear();
+        assert!(c.is_empty());
+        assert_eq!(c.len(), 0);
+        assert_eq!(c.iter().count(), 0);
+        assert_eq!(c.pop_lru(), None);
+        c.put('c', 3);
+        assert_eq!(c.get(&'c'), Some(&3));
+    }
+
+    #[test]
+    fn order_after_mixed_ops() {
+        let mut c = LruCache::new(4);
+        c.put(1, 1);
+        c.put(2, 2);
+        c.put(3, 3);
+        c.put(4, 4);
+        // mru..lru: 4 3 2 1
+        c.get(&2); // 2 4 3 1
+        c.remove(&4); // 2 3 1
+        c.put(5, 5); // 5 2 3 1
+        c.peek(&3); // unchanged
+        c.get_mut(&1); // 1 5 2 3
+        let v: Vec<_> = c.iter().map(|(k, _)| *k).collect();
+        assert_eq!(v, vec![1, 5, 2, 3]);
+        assert_eq!(c.pop_lru(), Some((3, 3)));
+        let v: Vec<_> = c.iter().map(|(k, _)| *k).collect();
+        assert_eq!(v, vec![1, 5, 2]);
+    }
+
+    #[test]
+    fn long_sequence_stays_consistent() {
+        // Interleave puts, gets, removals, and pops, checking invariants at every step.
+        let mut c = LruCache::new(5);
+        let mut expect: std::collections::HashMap<u32, u32> = std::collections::HashMap::new();
+        for i in 0..200u32 {
+            match i % 4 {
+                0 => {
+                    let v = i * 2;
+                    expect.insert(i, v);
+                    assert_eq!(c.put(i, v), None);
+                }
+                1 => {
+                    let k = i % 7;
+                    let got = c.get(&k);
+                    assert_eq!(got.copied(), expect.get(&k).copied());
+                }
+                2 => {
+                    let k = i % 5;
+                    let got = c.remove(&k);
+                    assert_eq!(got, expect.remove(&k));
+                }
+                _ => {
+                    let popped = c.pop_lru();
+                    if let Some((k, v)) = popped {
+                        assert_eq!(expect.get(&k).copied(), Some(v));
+                        expect.remove(&k);
+                    }
+                }
+            }
+            assert!(c.len() <= 5, "capacity violated: len = {}", c.len());
+            assert_eq!(c.len(), expect.len());
+            for (k, v) in c.iter() {
+                assert_eq!(expect.get(k).copied(), Some(*v));
+            }
+        }
     }
 }
