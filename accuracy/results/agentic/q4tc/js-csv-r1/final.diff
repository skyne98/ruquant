diff --git a/test/parse.test.js b/test/parse.test.js
index 6358150..b6576ae 100644
--- a/test/parse.test.js
+++ b/test/parse.test.js
@@ -35,3 +35,61 @@ test("round trip", () => {
 test("objects", () => {
   assert.deepEqual(parseObjects("name,age\nann,31\nbob\n"), [{ name: "ann", age: "31" }, { name: "bob", age: "" }]);
 });
+
+test("trailing record without line break", () => {
+  assert.deepEqual(parse("a,b"), [["a", "b"]]);
+});
+
+test("trailing empty fields without line break", () => {
+  assert.deepEqual(parse("a,,"), [["a", "", ""]]);
+});
+
+test("empty input", () => {
+  assert.deepEqual(parse(""), []);
+});
+
+test("single empty line is one empty record", () => {
+  assert.deepEqual(parse("\n"), [[""]]);
+});
+
+test("CRLF without trailing line break", () => {
+  assert.deepEqual(parse("a,b\r\nc,d"), [["a", "b"], ["c", "d"]]);
+});
+
+test("lone CR is literal", () => {
+  assert.deepEqual(parse("a\rb\n"), [["a\rb"]]);
+  assert.deepEqual(parse('"a\rb"\n'), [["a\rb"]]);
+});
+
+test("CRLF inside quotes is literal", () => {
+  assert.deepEqual(parse('"a\r\nb"\n'), [["a\r\nb"]]);
+});
+
+test("quote inside unquoted field is literal", () => {
+  assert.deepEqual(parse('a"b\n'), [['a"b']]);
+});
+
+test("quoted empty field", () => {
+  assert.deepEqual(parse('a,""\n'), [["a", ""]]);
+});
+
+test("custom delimiter", () => {
+  assert.deepEqual(parse("a;b\n1;2", { delimiter: ";" }), [["a", "b"], ["1", "2"]]);
+});
+
+test("unterminated quote at start of input", () => {
+  assert.throws(() => parse('"ab'), (e) => e instanceof CsvError && e.line === 1);
+});
+
+test("unterminated quote reports the line it starts on, after earlier lines", () => {
+  assert.throws(() => parse('a\nb\n"cd'), (e) => e instanceof CsvError && e.line === 3);
+});
+
+test("unterminated quoted field spanning a line break reports the start line", () => {
+  assert.throws(() => parse('x\n"a\nb'), (e) => e instanceof CsvError && e.line === 2);
+});
+
+test("parseObjects with header only or no input", () => {
+  assert.deepEqual(parseObjects("a,b\n"), []);
+  assert.deepEqual(parseObjects(""), []);
+});
