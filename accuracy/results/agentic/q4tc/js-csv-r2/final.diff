diff --git a/test/parse.test.js b/test/parse.test.js
index 6358150..72f6b49 100644
--- a/test/parse.test.js
+++ b/test/parse.test.js
@@ -35,3 +35,51 @@ test("round trip", () => {
 test("objects", () => {
   assert.deepEqual(parseObjects("name,age\nann,31\nbob\n"), [{ name: "ann", age: "31" }, { name: "bob", age: "" }]);
 });
+
+test("trailing delimiter leaves an empty final field", () => {
+  assert.deepEqual(parse("a,"), [["a", ""]]);
+});
+
+test("empty quoted field at end of input", () => {
+  assert.deepEqual(parse('a,""'), [["a", ""]]);
+});
+
+test("single empty quoted field", () => {
+  assert.deepEqual(parse('""'), [[""]]);
+});
+
+test("escaped quotes at field boundaries", () => {
+  assert.deepEqual(parse('"""a"""'), [['"a"']]);
+});
+
+test("quote inside an unquoted field is literal", () => {
+  assert.deepEqual(parse('a"b,c"d\nx'), [["a\"b", "c\"d"], ["x"]]);
+});
+
+test("CRLF separates records but a lone CR is literal", () => {
+  assert.deepEqual(parse("a\rb\r\nc\nd"), [["a\rb"], ["c"], ["d"]]);
+});
+
+test("quoted field keeps CRLF literal", () => {
+  assert.deepEqual(parse('"a\r\nb"'), [["a\r\nb"]]);
+});
+
+test("unterminated quote on the first line reports line 1", () => {
+  assert.throws(() => parse('"ab'), (e) => e instanceof CsvError && e.line === 1);
+});
+
+test("unterminated quote spanning lines reports the field's start line", () => {
+  assert.throws(() => parse('a\n"b\nc\nd'), (e) => e instanceof CsvError && e.line === 2);
+});
+
+test("empty input yields no records", () => {
+  assert.deepEqual(parse(""), []);
+});
+
+test("custom delimiter", () => {
+  assert.deepEqual(parse("a|b\n1|2", { delimiter: "|" }), [["a", "b"], ["1", "2"]]);
+});
+
+test("round trip keeps a lone CR via quoting", () => {
+  assert.deepEqual(parse(stringify([["a", "b\rc"]])), [["a", "b\rc"]]);
+});
