@@ -0,0 +1,89 @@
+"""Tests for the mdlite Markdown-to-HTML converter (basics)."""
+
+from mdlite import to_html
+
+
+def test_empty_input_returns_empty_string():
+    assert to_html("") == ""
+
+
+def test_whitespace_only_input_returns_empty_string():
+    assert to_html(" \t\n \n") == ""
+
+
+def test_single_line_paragraph():
+    assert to_html("Hello world") == "<p>Hello world</p>"
+
+
+def test_paragraph_lines_are_stripped_and_joined():
+    assert to_html("  Hello  \n\tworld\t") == "<p>Hello world</p>"
+
+
+def test_blank_lines_separate_paragraphs():
+    assert to_html("First\n\nSecond") == "<p>First</p>\n<p>Second</p>"
+
+
+def test_run_of_blank_lines_is_a_single_separator():
+    assert to_html("First\n\n\n\nSecond") == "<p>First</p>\n<p>Second</p>"
+
+
+def test_heading_level_one():
+    assert to_html("# Title") == "<h1>Title</h1>"
+
+
+def test_heading_levels_two_through_six():
+    assert to_html("## Two") == "<h2>Two</h2>"
+    assert to_html("### Three") == "<h3>Three</h3>"
+    assert to_html("#### Four") == "<h4>Four</h4>"
+    assert to_html("##### Five") == "<h5>Five</h5>"
+    assert to_html("###### Six") == "<h6>Six</h6>"
+
+
+def test_heading_without_space_is_a_paragraph():
+    assert to_html("#NoSpace") == "<p>#NoSpace</p>"
+
+
+def test_seven_or_more_hashes_is_a_paragraph():
+    assert to_html("####### Seven") == "<p>####### Seven</p>"
+
+
+def test_indented_hash_is_not_a_heading():
+    # The line does not *start* with '#', so it is ordinary text.
+    assert to_html(" # Indented") == "<p># Indented</p>"
+
+
+def test_heading_is_always_its_own_block():
+    assert to_html("A\n## H\nB") == "<p>A</p>\n<h2>H</h2>\n<p>B</p>"
+
+
+def test_heading_with_surrounding_whitespace():
+    assert to_html("##  Title  ") == "<h2>Title</h2>"
+
+
+def test_documented_example():
+    assert to_html("# Title\nSome\ntext\n\nMore") == (
+        "<h1>Title</h1>\n<p>Some text</p>\n<p>More</p>"
+    )
+
+
+def test_ampersand_is_escaped():
+    assert to_html("Fish & Chips") == "<p>Fish &amp; Chips</p>"
+
+
+def test_angle_brackets_are_escaped():
+    assert to_html("1 < 2 > 0") == "<p>1 &lt; 2 &gt; 0</p>"
+
+
+def test_entities_are_not_double_escaped():
+    # The literal text '&lt;' must become '&amp;lt;', not '&lt;lt;'.
+    assert to_html("&lt;") == "<p>&amp;lt;</p>"
+
+
+def test_output_has_no_trailing_newline():
+    result = to_html("# T\n\nP")
+    assert result == "<h1>T</h1>\n<p>P</p>"
+    assert not result.endswith("\n")
+
+
+def test_leading_and_trailing_blank_lines_add_no_blocks():
+    assert to_html("\n\n# T\n\n") == "<h1>T</h1>"
