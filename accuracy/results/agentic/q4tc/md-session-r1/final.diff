+"""Tests for inline formatting: bold, italic and code spans."""
+
+from mdlite import to_html
+
+
+def test_bold_in_paragraph():
+    assert to_html("**bold**") == "<p><strong>bold</strong></p>"
+
+
+def test_italic_in_paragraph():
+    assert to_html("*italic*") == "<p><em>italic</em></p>"
+
+
+def test_bold_in_heading():
+    assert to_html("# **B**") == "<h1><strong>B</strong></h1>"
+
+
+def test_italic_in_heading():
+    assert to_html("## *i*") == "<h2><em>i</em></h2>"
+
+
+def test_code_span():
+    assert to_html("`code`") == "<p><code>code</code></p>"
+
+
+def test_code_span_escapes_content():
+    assert to_html("`a < b > c & d`") == (
+        "<p><code>a &lt; b &gt; c &amp; d</code></p>"
+    )
+
+
+def test_no_formatting_inside_code_span():
+    assert to_html("`*not* bold`") == "<p><code>*not* bold</code></p>"
+
+
+def test_code_span_in_heading():
+    assert to_html("# `x`") == "<h1><code>x</code></h1>"
+
+
+def test_bold_and_italic_together():
+    assert to_html("*a* and **b**") == (
+        "<p><em>a</em> and <strong>b</strong></p>"
+    )
+
+
+def test_nested_emphasis():
+    assert to_html("**bold *it* bold**") == (
+        "<p><strong>bold <em>it</em> bold</strong></p>"
+    )
+
+
+def test_markers_flanked_by_spaces_stay_literal():
+    # The documented example: opening/closing '*' next to spaces.
+    assert to_html("2 * 3 * 4") == "<p>2 * 3 * 4</p>"
+
+
+def test_unpaired_opening_marker_is_literal():
+    assert to_html("*a") == "<p>*a</p>"
+
+
+def test_unpaired_closing_marker_is_literal():
+    assert to_html("a *") == "<p>a *</p>"
+
+
+def test_unpaired_bold_is_literal():
+    assert to_html("a ** b") == "<p>a ** b</p>"
+
+
+def test_emphasis_escapes_its_content():
+    assert to_html("**a & b**") == "<p><strong>a &amp; b</strong></p>"
+
+
+def test_multiple_code_spans():
+    assert to_html("`a` and `b`") == (
+        "<p><code>a</code> and <code>b</code></p>"
+    )
+
+
+def test_unpaired_backtick_is_literal():
+    assert to_html("a ` b") == "<p>a ` b</p>"
