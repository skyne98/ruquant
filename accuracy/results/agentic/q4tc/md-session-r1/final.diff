@@ -0,0 +1,289 @@
+"""mdlite: a small, readable Markdown-to-HTML converter.
+
+This module exposes :func:`to_html`, which turns a subset of Markdown
+into HTML: paragraphs, ATX headings, lists, and fenced code blocks at
+the block level, with inline code spans, bold, italic, and links.
+"""
+
+from __future__ import annotations
+
+import re
+
+__all__ = ["to_html"]
+
+# An ATX heading: one to six '#' characters, then a single space, then the
+# (possibly empty) title. '#Title' (no space) or seven or more '#' do NOT
+# match, so they fall through to ordinary text.
+_HEADING_RE = re.compile(r"^(#{1,6}) (.*)$")
+
+# An unordered list item: '- ' or '* ' followed by the item text.
+_ULIST_RE = re.compile(r"^[-*] (.*)$")
+
+# An ordered list item: one or more digits, a dot, a space (as in '1. '
+# or '10. '), followed by the item text.
+_OLIST_RE = re.compile(r"^\d+\. (.*)$")
+
+# The fence that opens and closes a code block.
+_FENCE = "```"
+
+
+def _escape(text: str) -> str:
+    """Escape the HTML-significant characters ``&``, ``<`` and ``>``.
+
+    ``&`` is escaped first so the ``&`` characters we introduce while
+    building the other entities are not escaped a second time.
+    """
+    return (
+        text.replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+    )
+
+
+def _is_space(ch: str) -> bool:
+    """Return True for a space-like character used by the inline rules."""
+    return ch in " \t"
+
+
+def _is_blank(line: str) -> bool:
+    """Return True for a blank line (empty or whitespace only)."""
+    return line.strip() == ""
+
+
+def _render_inline(raw: str) -> str:
+    """Render inline markup (code spans, bold, italic) in a piece of text.
+
+    The raw text is escaped first; ``_process`` then turns ``*``/``**`` and
+    backtick markers into HTML without formatting code-span contents.
+    """
+    return _process(_escape(raw))
+
+
+def _find_close(s: str, content_start: int, marker: str) -> int | None:
+    """Find the closing ``marker`` for content starting at ``content_start``.
+
+    A valid close is preceded by a non-space character and leaves non-empty
+    content. Returns its index, or ``None`` when no valid close exists.
+    """
+    pos = content_start
+    while True:
+        idx = s.find(marker, pos)
+        if idx == -1:
+            return None
+        if idx > content_start and not _is_space(s[idx - 1]):
+            return idx
+        pos = idx + 1
+
+
+def _link_url(url: str) -> str:
+    """Escape a link target for a double-quoted ``href`` attribute.
+
+    ``&`` is already escaped by the time the url reaches ``_process``;
+    double quotes are the only characters still needing escaping, so
+    they cannot terminate the attribute value.
+    """
+    return url.replace('"', "&quot;")
+
+
+def _process(s: str, links: bool = True) -> str:
+    """Turn already-escaped inline text into HTML.
+
+    Code spans are emitted verbatim (their content is not formatted), so
+    nothing inside a code span ever becomes emphasis or a link. An
+    opening ``*``/``**`` must be followed by a non-space character and
+    its close preceded by one; unmatched markers stay literal. A link
+    ``[text](url)`` becomes ``<a href="url">text</a>``: inline markup is
+    applied to the text, while the url is kept as-is except that double
+    quotes become ``&quot;``. A ``[`` that does not belong to a complete
+    ``[text](url)`` (a missing ``]`` or ``)``, a space before the ``(``,
+    or an empty url) stays literal, and links do not nest.
+    """
+    out = []
+    i = 0
+    n = len(s)
+    while i < n:
+        ch = s[i]
+        if ch == "`":
+            j = s.find("`", i + 1)
+            if j > i:
+                out.append("<code>" + s[i + 1 : j] + "</code>")
+                i = j + 1
+            else:
+                out.append(ch)
+                i += 1
+            continue
+        if ch == "*":
+            # Bold: '**' followed by a non-space, then a matching close.
+            if (
+                s[i + 1 : i + 2] == "*"
+                and i + 2 < n
+                and not _is_space(s[i + 2])
+            ):
+                j = _find_close(s, i + 2, "**")
+                if j is not None:
+                    out.append(
+                        "<strong>" + _process(s[i + 2 : j], links) + "</strong>"
+                    )
+                    i = j + 2
+                    continue
+            # Italic: '*' followed by a non-space, then a matching close.
+            if i + 1 < n and not _is_space(s[i + 1]):
+                j = _find_close(s, i + 1, "*")
+                if j is not None:
+                    out.append("<em>" + _process(s[i + 1 : j], links) + "</em>")
+                    i = j + 1
+                    continue
+        if ch == "[" and links:
+            # Link: '[text](url)' with a non-empty url. The text may hold
+            # any inline markup except links, which never nest.
+            close = s.find("]", i + 1)
+            paren = close + 1
+            if close != -1 and paren < n and s[paren] == "(":
+                end = s.find(")", paren + 1)
+                if end > paren + 1:
+                    out.append(
+                        '<a href="'
+                        + _link_url(s[paren + 1 : end])
+                        + '">'
+                        + _process(s[i + 1 : close], links=False)
+                        + "</a>"
+                    )
+                    i = end + 1
+                    continue
+        out.append(ch)
+        i += 1
+    return "".join(out)
+
+
+def _render_paragraph(paragraph: list[str]) -> str:
+    """Render a paragraph: its lines stripped and joined with a space."""
+    content = " ".join(line.strip() for line in paragraph)
+    return f"<p>{_render_inline(content)}</p>"
+
+
+def _render_list(tag: str, items: list[str]) -> str:
+    """Render a list block from already-collected item texts."""
+    body = "\n".join(f"<li>{_render_inline(item)}</li>" for item in items)
+    return f"<{tag}>\n{body}\n</{tag}>"
+
+
+def _render_code_block(language: str, lines: list[str]) -> str:
+    """Render a fenced code block.
+
+    The lines are escaped but not formatted, and their indentation is
+    kept; they are joined with ``\\n``.
+    """
+    body = "\n".join(_escape(line) for line in lines)
+    if language:
+        return (
+            f'<pre><code class="language-{language}">'
+            f"{body}</code></pre>"
+        )
+    return f"<pre><code>{body}</code></pre>"
+
+
+def _starts_new_block(line: str) -> bool:
+    """Return True when ``line`` starts a block of its own.
+
+    A blank line, a heading, a fence, or a list item of either kind all
+    start a new block, so they also end an open paragraph.
+    """
+    return (
+        _is_blank(line)
+        or _HEADING_RE.match(line) is not None
+        or line.startswith(_FENCE)
+        or _ULIST_RE.match(line) is not None
+        or _OLIST_RE.match(line) is not None
+    )
+
+
+def _collect_items(
+    lines: list[str], i: int, pattern: re.Pattern[str]
+) -> tuple[list[str], int]:
+    """Collect the run of items matching ``pattern`` from index ``i``.
+
+    Returns the item texts and the index of the first line that does not
+    match (the end of the input when the run runs to the end).
+    """
+    items: list[str] = []
+    n = len(lines)
+    while i < n:
+        item = pattern.match(lines[i])
+        if item is None:
+            break
+        items.append(item.group(1))
+        i += 1
+    return items, i
+
+
+def to_html(text: str) -> str:
+    """Convert a Markdown string to HTML.
+
+    Blank lines separate blocks. The recognised block kinds are ATX
+    headings (always a block of their own, even without surrounding blank
+    lines), fenced code blocks (opened by a line starting with triple
+    backticks, optionally followed by a language, and closed by the next
+    line that is exactly triple backticks), unordered lists (consecutive
+    lines starting with ``- `` or ``* ``), ordered lists (consecutive lines
+    starting with a number, a dot and a space, as in ``1. `` or ``10. ``),
+    and paragraphs (any other run of consecutive non-blank lines, whose
+    lines are stripped and joined with a single space).
+
+    Headings, list items, and paragraphs also honour inline markup:
+    code spans, bold (``**``), italic (``*``), and links
+    (``[text](url)``). Lines inside a code block are never formatted.
+
+    A paragraph or list ends at a blank line or at the first line that
+    starts a block of another kind, which begins the next block. Lines
+    inside a code block are emitted verbatim (escaped, unformatted,
+    indentation kept); blank lines do not end the block, and an unclosed
+    fence runs to the end of the input. Block elements are joined with
+    ``\\n`` and there is no trailing newline. Empty (or whitespace-only)
+    input yields ``""``.
+    """
+    blocks: list[str] = []
+    lines = text.split("\n")
+    n = len(lines)
+    i = 0
+    while i < n:
+        line = lines[i]
+        if _is_blank(line):
+            i += 1
+            continue
+        if line.startswith(_FENCE):
+            # Fenced code block: consume to the next exact fence or EOF.
+            language = line[len(_FENCE):].strip()
+            body: list[str] = []
+            i += 1
+            while i < n and lines[i] != _FENCE:
+                body.append(lines[i])
+                i += 1
+            i += 1
+            blocks.append(_render_code_block(language, body))
+            continue
+        heading = _HEADING_RE.match(line)
+        if heading is not None:
+            # A heading stands alone and ends whatever block was open.
+            level = len(heading.group(1))
+            title = heading.group(2).strip()
+            blocks.append(f"<h{level}>{_render_inline(title)}</h{level}>")
+            i += 1
+            continue
+        item = _ULIST_RE.match(line)
+        if item is None:
+            item = _OLIST_RE.match(line)
+        if item is not None:
+            # Consecutive items of the same kind form one list; the first
+            # item of the other kind starts the next block.
+            items, i = _collect_items(lines, i, item.re)
+            tag = "ul" if item.re is _ULIST_RE else "ol"
+            blocks.append(_render_list(tag, items))
+            continue
+        # Paragraph: run to the next blank line or other block starter.
+        paragraph = [line]
+        i += 1
+        while i < n and not _starts_new_block(lines[i]):
+            paragraph.append(lines[i])
+            i += 1
+        blocks.append(_render_paragraph(paragraph))
+    return "\n".join(blocks)
