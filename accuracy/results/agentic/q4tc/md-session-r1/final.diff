+"""Regression tests: headings, list items, and paragraphs are escaped.
+
+A report claimed ``# a < b`` could produce a heading containing a raw
+``<``; pin down that all three text-bearing block kinds escape ``&``,
+``<`` and ``>``.
+"""
+
+from mdlite import to_html
+
+
+def test_heading_escapes():
+    assert to_html("# a < b & c > d") == "<h1>a &lt; b &amp; c &gt; d</h1>"
+
+
+def test_unordered_list_item_escapes():
+    assert to_html("- a < b & c") == "<ul>\n<li>a &lt; b &amp; c</li>\n</ul>"
+
+
+def test_ordered_list_item_escapes():
+    assert to_html("1. a < b & c") == "<ol>\n<li>a &lt; b &amp; c</li>\n</ol>"
+
+
+def test_paragraph_escapes():
+    assert to_html("a < b & c > d") == "<p>a &lt; b &amp; c &gt; d</p>"
