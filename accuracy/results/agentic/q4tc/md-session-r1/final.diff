+"""Tests for list blocks: unordered and ordered items."""
+
+from mdlite import to_html
+
+
+def test_documented_unordered_example():
+    assert to_html("- a\n- b") == "<ul>\n<li>a</li>\n<li>b</li>\n</ul>"
+
+
+def test_documented_ordered_example():
+    assert to_html("1. a\n2. b") == "<ol>\n<li>a</li>\n<li>b</li>\n</ol>"
+
+
+def test_star_bullet_items_are_unordered():
+    assert to_html("* a\n* b") == "<ul>\n<li>a</li>\n<li>b</li>\n</ul>"
+
+
+def test_multi_digit_ordered_items():
+    assert to_html("10. a\n11. b") == "<ol>\n<li>a</li>\n<li>b</li>\n</ol>"
+
+
+def test_single_item_lists():
+    assert to_html("- a") == "<ul>\n<li>a</li>\n</ul>"
+    assert to_html("1. a") == "<ol>\n<li>a</li>\n</ol>"
+
+
+def test_inline_formatting_inside_items():
+    assert to_html("- **b** and *i*") == (
+        "<ul>\n<li><strong>b</strong> and <em>i</em></li>\n</ul>"
+    )
+
+
+def test_code_span_inside_item():
+    assert to_html("- `x`") == "<ul>\n<li><code>x</code></li>\n</ul>"
+
+
+def test_item_text_is_escaped():
+    assert to_html("- a & b < c") == "<ul>\n<li>a &amp; b &lt; c</li>\n</ul>"
+
+
+def test_item_line_ends_preceding_paragraph():
+    assert to_html("para\n- a") == "<p>para</p>\n<ul>\n<li>a</li>\n</ul>"
+
+
+def test_list_after_paragraph_with_blank_line():
+    assert to_html("p\n\n- a") == "<p>p</p>\n<ul>\n<li>a</li>\n</ul>"
+
+
+def test_heading_after_list():
+    assert to_html("- a\n# H") == "<ul>\n<li>a</li>\n</ul>\n<h1>H</h1>"
+
+
+def test_mixed_kinds_split_into_separate_lists():
+    assert to_html("- a\n1. b") == (
+        "<ul>\n<li>a</li>\n</ul>\n<ol>\n<li>b</li>\n</ol>"
+    )
+
+
+def test_mixed_kinds_reversed():
+    assert to_html("1. a\n- b") == (
+        "<ol>\n<li>a</li>\n</ol>\n<ul>\n<li>b</li>\n</ul>"
+    )
+
+
+def test_blank_line_splits_list():
+    assert to_html("- a\n\n- b") == (
+        "<ul>\n<li>a</li>\n</ul>\n<ul>\n<li>b</li>\n</ul>"
+    )
+
+
+def test_non_item_line_starts_paragraph_after_list():
+    assert to_html("- a\nb") == "<ul>\n<li>a</li>\n</ul>\n<p>b</p>"
+
+
+def test_paragraph_between_lists():
+    assert to_html("- a\n\np\n\n- b") == (
+        "<ul>\n<li>a</li>\n</ul>\n<p>p</p>\n<ul>\n<li>b</li>\n</ul>"
+    )
+
+
+def test_dash_without_space_is_a_paragraph():
+    assert to_html("-a") == "<p>-a</p>"
+
+
+def test_number_lines_without_dot_and_space_are_paragraphs():
+    assert to_html("1.a") == "<p>1.a</p>"
+    assert to_html("1 a") == "<p>1 a</p>"
+    assert to_html("1.") == "<p>1.</p>"
+
+
+def test_empty_item():
+    assert to_html("- ") == "<ul>\n<li></li>\n</ul>"
