@@ -0,0 +1,75 @@
+"""Tests for inline links: [text](url) -> <a href="url">text</a>."""
+
+from mdlite import to_html
+
+
+def test_basic_link():
+    assert to_html("[text](url)") == '<p><a href="url">text</a></p>'
+
+
+def test_link_among_other_words():
+    assert to_html("see [a](u) now") == '<p>see <a href="u">a</a> now</p>'
+
+
+def test_two_links_in_one_paragraph():
+    assert to_html("[a](u) and [b](v)") == (
+        '<p><a href="u">a</a> and <a href="v">b</a></p>'
+    )
+
+
+def test_bold_inside_link_text():
+    assert to_html("[**b**](u)") == '<p><a href="u"><strong>b</strong></a></p>'
+
+
+def test_italic_inside_link_text():
+    assert to_html("[*b*](u)") == '<p><a href="u"><em>b</em></a></p>'
+
+
+def test_mixed_formatting_inside_link_text():
+    assert to_html("[**a** and *b*](u)") == (
+        '<p><a href="u"><strong>a</strong> and <em>b</em></a></p>'
+    )
+
+
+def test_code_span_inside_link_text():
+    assert to_html("[a `b` c](u)") == '<p><a href="u">a <code>b</code> c</a></p>'
+
+
+def test_link_inside_bold():
+    assert to_html("**[a](u)**") == '<p><strong><a href="u">a</a></strong></p>'
+
+
+def test_link_in_heading():
+    assert to_html("# [a](u)") == '<h1><a href="u">a</a></h1>'
+
+
+def test_link_in_list_item():
+    assert to_html("- [a](u)") == '<ul>\n<li><a href="u">a</a></li>\n</ul>'
+
+
+def test_ampersand_escaped_in_url():
+    assert to_html("[a](u?x=1&y=2)") == '<p><a href="u?x=1&amp;y=2">a</a></p>'
+
+
+def test_double_quote_escaped_in_url():
+    assert to_html('[a]("b")') == '<p><a href="&quot;b&quot;">a</a></p>'
+
+
+def test_link_syntax_in_code_span_stays_literal():
+    assert to_html("`[a](b)`") == "<p><code>[a](b)</code></p>"
+
+
+def test_unclosed_url_stays_literal():
+    assert to_html("[a](u") == "<p>[a](u</p>"
+
+
+def test_space_before_paren_stays_literal():
+    assert to_html("[a] (u)") == "<p>[a] (u)</p>"
+
+
+def test_empty_url_stays_literal():
+    assert to_html("[a]()") == "<p>[a]()</p>"
+
+
+def test_plain_brackets_stay_literal():
+    assert to_html("[a]") == "<p>[a]</p>"
