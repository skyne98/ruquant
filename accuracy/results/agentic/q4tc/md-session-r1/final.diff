+"""Tests for fenced code blocks."""
+
+from mdlite import to_html
+
+
+def test_basic_code_block():
+    assert to_html("```\ncode\n```") == "<pre><code>code</code></pre>"
+
+
+def test_code_block_with_language():
+    assert to_html("```python\nx = 1\n```") == (
+        '<pre><code class="language-python">x = 1</code></pre>'
+    )
+
+
+def test_multiline_block_keeps_lines():
+    assert to_html("```\na\nb\n```") == "<pre><code>a\nb</code></pre>"
+
+
+def test_blank_lines_inside_block_are_kept():
+    assert to_html("```\na\n\nb\n```") == "<pre><code>a\n\nb</code></pre>"
+
+
+def test_content_is_escaped_but_not_formatted():
+    assert to_html("```\n**b** & <x>\n```") == (
+        "<pre><code>**b** &amp; &lt;x&gt;</code></pre>"
+    )
+
+
+def test_indentation_is_kept():
+    assert to_html("```\n    indented\n```") == (
+        "<pre><code>    indented</code></pre>"
+    )
+
+
+def test_unclosed_block_runs_to_end_of_input():
+    assert to_html("```\ncode") == "<pre><code>code</code></pre>"
+
+
+def test_unclosed_block_with_language():
+    assert to_html("```py\ncode") == '<pre><code class="language-py">code</code></pre>'
+
+
+def test_only_an_exact_fence_closes():
+    # A '```python' line inside the block is content, not a closing fence.
+    assert to_html("```\n```python\n```") == "<pre><code>```python</code></pre>"
+
+
+def test_block_between_paragraphs():
+    assert to_html("before\n```\nc\n```\nafter") == (
+        "<p>before</p>\n<pre><code>c</code></pre>\n<p>after</p>"
+    )
+
+
+def test_block_after_list():
+    assert to_html("- a\n```\nc\n```") == (
+        "<ul>\n<li>a</li>\n</ul>\n<pre><code>c</code></pre>"
+    )
+
+
+def test_block_after_heading():
+    assert to_html("# H\n```\nc\n```") == "<h1>H</h1>\n<pre><code>c</code></pre>"
+
+
+def test_block_at_start_of_input():
+    assert to_html("```\nc\n```\nend") == "<pre><code>c</code></pre>\n<p>end</p>"
+
+
+def test_heading_and_list_lines_inside_block_are_literal():
+    assert to_html("```\n# not a heading\n- not an item\n```") == (
+        "<pre><code># not a heading\n- not an item</code></pre>"
+    )
+
+
+def test_empty_block():
+    assert to_html("```\n```") == "<pre><code></code></pre>"
