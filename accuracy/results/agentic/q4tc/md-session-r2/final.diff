+# ---------------------------------------------------------------------------
+# Links
+# ---------------------------------------------------------------------------
+
+
+def test_link_basic():
+    assert to_html("[text](url)") == '<p><a href="url">text</a></p>'
+
+
+def test_link_in_heading():
+    assert to_html("# [a](u)") == '<h1><a href="u">a</a></h1>'
+
+
+def test_link_in_list_item():
+    assert to_html("- [a](u)") == '<ul>\n<li><a href="u">a</a></li>\n</ul>'
+
+
+def test_link_multiple_in_paragraph():
+    assert to_html("[a](1) and [b](2)") == (
+        '<p><a href="1">a</a> and <a href="2">b</a></p>'
+    )
+
+
+def test_link_url_escapes_ampersand():
+    assert to_html("[a](x&y)") == '<p><a href="x&amp;y">a</a></p>'
+
+
+def test_link_url_escapes_quote():
+    assert to_html('[a](x"y)') == '<p><a href="x&quot;y">a</a></p>'
+
+
+def test_link_url_escapes_both():
+    assert to_html('[a](x&"y)') == '<p><a href="x&amp;&quot;y">a</a></p>'
+
+
+def test_link_url_lt_gt_stay_literal():
+    # The spec lists only & and " for URLs, so < and > are left alone.
+    assert to_html("[a](x<y)") == '<p><a href="x<y">a</a></p>'
+
+
+def test_link_text_is_formatted():
+    assert to_html("[**b** and *i*](u)") == (
+        '<p><a href="u"><strong>b</strong> and <em>i</em></a></p>'
+    )
+
+
+def test_link_text_code_span():
+    assert to_html("[`x`](u)") == '<p><a href="u"><code>x</code></a></p>'
+
+
+def test_link_text_escaping():
+    assert to_html("[a & b < c](u)") == (
+        '<p><a href="u">a &amp; b &lt; c</a></p>'
+    )
+
+
+def test_link_text_unpaired_markers_stay_literal():
+    assert to_html("[a * b](u)") == '<p><a href="u">a * b</a></p>'
+
+
+def test_link_in_multiline_paragraph():
+    assert to_html("[a\nb](u)") == '<p><a href="u">a b</a></p>'
+
+
+def test_link_surrounded_by_bold():
+    assert to_html("**[a](u)**") == '<p><strong><a href="u">a</a></strong></p>'
+
+
+def test_unpaired_link_markers_stay_literal():
+    assert to_html("[a](b") == "<p>[a](b</p>"
+    assert to_html("[a]b") == "<p>[a]b</p>"
+
+
+def test_empty_link_text_and_url():
+    assert to_html("[](u)") == '<p><a href="u"></a></p>'
+    assert to_html("[a]()") == '<p><a href="">a</a></p>'
+
+
+def test_no_link_inside_code_span():
+    assert to_html("`[a](b)`") == "<p><code>[a](b)</code></p>"
+
+
+def test_nested_link_inner_wins():
+    # The inner link matches first; the outer brackets are left literal.
+    assert to_html("[a [b](u1)](u2)") == (
+        '<p>[a <a href="u1">b</a>](u2)</p>'
+    )
+
