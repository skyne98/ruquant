+"""Core conversion logic for the mdlite Markdown-to-HTML converter."""
+
+from __future__ import annotations
+
+import re
+
+_HEADING_RE = re.compile(r"^(#{1,6}) (.*)$")
+_CODE_RE = re.compile(r"`([^`]*)`")
+_LINK_RE = re.compile(r"\[([^\[\]]*)\]\(([^()]*)\)")
+_BOLD_RE = re.compile(r"\*\*(?=\S)(.*?)(?<=\S)\*\*")
+_ITALIC_RE = re.compile(r"\*(?=\S)(.*?)\*(?<=\S)")
+_FENCE_RE = re.compile(r"^```(\w*)$")
+_UL_ITEM_RE = re.compile(r"^[-*] (.*)$")
+_OL_ITEM_RE = re.compile(r"^\d+\. (.*)$")
+
+
+def _escape(text: str) -> str:
+    """Escape the HTML-significant characters ``&``, ``<`` and ``>``."""
+    return (
+        text.replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+    )
+
+
+def _format_url(url: str) -> str:
+    """Escape a link URL, which arrives as raw (unescaped) text.
+
+    The spec asks for exactly two substitutions in URLs: ``&`` becomes
+    ``&amp;`` and ``"`` becomes ``&quot;``.
+    """
+    return url.replace("&", "&amp;").replace('"', "&quot;")
+
+
+def _emphasis(text: str) -> str:
+    """Convert bold (``**``) and italic (``*``) markers in escaped text.
+
+    An opening marker must be followed by a non-space character and a
+    closing marker preceded by one; unpaired markers are left as literal
+    text.  Bold is applied before italic so ``**`` pairs are not
+    consumed as two italics.
+    """
+    text = _BOLD_RE.sub(r"<strong>\1</strong>", text)
+    text = _ITALIC_RE.sub(r"<em>\1</em>", text)
+    return text
+
+
+def _format_inline(text: str) -> str:
+    """Render code spans, links, bold and italic markup in raw text.
+
+    Code spans are stashed away first so that nothing inside them is
+    formatted (links included) and markers never pair across a code
+    span.  Links are stashed next so their text is formatted in
+    isolation and their URLs are escaped exactly as the spec requires.
+    """
+    stashed: list[str] = []
+
+    def _stash_code(match: re.Match) -> str:
+        stashed.append(f"<code>{_escape(match.group(1))}</code>")
+        return f"\x00{len(stashed) - 1}\x00"
+
+    links: list[tuple[str, str]] = []
+
+    def _stash_link(match: re.Match) -> str:
+        links.append((match.group(1), match.group(2)))
+        return f"\x01{len(links) - 1}\x01"
+
+    text = _CODE_RE.sub(_stash_code, text)
+    text = _LINK_RE.sub(_stash_link, text)
+    text = _escape(text)
+    text = _emphasis(text)
+    for index, (link_text, url) in enumerate(links):
+        anchor = (
+            f'<a href="{_format_url(url)}">'
+            f"{_format_inline(link_text)}</a>"
+        )
+        text = text.replace(f"\x01{index}\x01", anchor)
+    for index, code in enumerate(stashed):
+        text = text.replace(f"\x00{index}\x00", code)
+    return text
+
+
+def to_html(text: str) -> str:
+    """Convert a small Markdown subset to a flat HTML fragment.
+
+    Blank lines (empty or whitespace-only) separate blocks.  A line of 1
+    to 6 ``#`` characters followed by a space is a heading and is always a
+    block of its own.  A line starting with ``- `` or ``* `` or with a
+    number, a dot and a space is a list item; consecutive items of the
+    same kind form one ``<ul>`` or ``<ol>`` list.  A line of three
+    backticks, optionally followed by a language, opens a fenced code
+    block whose lines are emitted verbatim (escaped but unformatted)
+    until a line that is exactly three backticks; an unclosed block runs
+    to the end of the input.  Any other run of consecutive non-blank
+    lines forms a paragraph whose lines are stripped and joined with a
+    single space.  ``&``, ``<`` and ``>`` are escaped in all text, and
+    inline code spans, links, bold and italic markup are rendered inside
+    headings, paragraphs and list items.  A link ``[text](url)`` becomes
+    ``<a href="url">text</a>``: the text gets the same inline formatting
+    as surrounding text, and only ``&`` (as ``&amp;``) and ``"`` (as
+    ``&quot;``) are escaped in the url.  Blocks are joined with a single
+    ``\\n`` and no trailing newline is added.
+    """
+    blocks: list[str] = []
+    paragraph: list[str] = []
+    list_items: list[str] = []
+    list_kind: str | None = None
+    fence_lines: list[str] = []
+    fence_lang: str | None = None
+    in_fence = False
+
+    def flush_paragraph() -> None:
+        if paragraph:
+            joined = " ".join(line.strip() for line in paragraph)
+            blocks.append("<p>" + _format_inline(joined) + "</p>")
+        paragraph.clear()
+
+    def flush_list() -> None:
+        nonlocal list_kind
+        if list_items:
+            tag = "ul" if list_kind == "ul" else "ol"
+            items = "\n".join(
+                "<li>" + _format_inline(item) + "</li>"
+                for item in list_items
+            )
+            blocks.append(f"<{tag}>\n{items}\n</{tag}>")
+        list_items.clear()
+        list_kind = None
+
+    def flush_fence() -> None:
+        nonlocal fence_lang, in_fence
+        if in_fence:
+            content = _escape("\n".join(fence_lines))
+            if fence_lang:
+                blocks.append(
+                    f'<pre><code class="language-{fence_lang}">'
+                    f"{content}</code></pre>"
+                )
+            else:
+                blocks.append(f"<pre><code>{content}</code></pre>")
+        fence_lines.clear()
+        fence_lang = None
+        in_fence = False
+
+    for line in text.splitlines():
+        if in_fence:
+            if line == "```":
+                flush_fence()
+            else:
+                fence_lines.append(line)
+            continue
+
+        fence = _FENCE_RE.match(line)
+        if fence is not None:
+            flush_paragraph()
+            flush_list()
+            in_fence = True
+            fence_lang = fence.group(1) or None
+            fence_lines = []
+            continue
+
+        heading = _HEADING_RE.match(line)
+        if heading is not None:
+            flush_paragraph()
+            flush_list()
+            level = len(heading.group(1))
+            content = _format_inline(heading.group(2).strip())
+            blocks.append(f"<h{level}>{content}</h{level}>")
+            continue
+
+        ul_item = _UL_ITEM_RE.match(line)
+        ol_item = _OL_ITEM_RE.match(line)
+        if ul_item is not None or ol_item is not None:
+            kind = "ul" if ul_item is not None else "ol"
+            item = ul_item if ul_item is not None else ol_item
+            flush_paragraph()
+            if list_kind is not None and list_kind != kind:
+                flush_list()
+            if list_kind is None:
+                list_kind = kind
+            list_items.append(item.group(1).strip())
+            continue
+
+        if not line.strip():
+            flush_paragraph()
+            flush_list()
+            continue
+
+        flush_list()
+        paragraph.append(line)
+
+    flush_paragraph()
+    flush_list()
+    flush_fence()
+    return "\n".join(blocks)
