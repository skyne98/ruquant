+# Bug report: escaping in headings, list items and paragraphs
+# ---------------------------------------------------------------------------
+
+
+def test_bug_report_heading_lt_is_escaped():
+    # Reported: "# a < b" produced a heading with a raw "<" in it.
+    assert to_html("# a < b") == "<h1>a &lt; b</h1>"
+
+
+def test_bug_report_list_item_lt_is_escaped():
+    assert to_html("- a < b") == "<ul>\n<li>a &lt; b</li>\n</ul>"
+
+
+def test_bug_report_paragraph_lt_is_escaped():
+    assert to_html("a < b") == "<p>a &lt; b</p>"
