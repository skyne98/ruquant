+"""Command-line entry point: ``python -m mdlite [FILE]``.
+
+Prints the HTML for FILE followed by a newline.  Without FILE the input
+is read from standard input.
+"""
+
+from __future__ import annotations
+
+import sys
+
+from .core import to_html
+
+
+def main() -> None:
+    args = sys.argv[1:]
+    if len(args) > 1:
+        print("usage: python -m mdlite [FILE]", file=sys.stderr)
+        raise SystemExit(2)
+    if args:
+        with open(args[0], "r", encoding="utf-8") as handle:
+            text = handle.read()
+    else:
+        text = sys.stdin.read()
+    print(to_html(text))
+
+
+if __name__ == "__main__":
+    main()
