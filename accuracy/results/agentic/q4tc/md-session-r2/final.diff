+"""Tests for the ``python -m mdlite`` command line."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+_REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _run_cli(*args: str, stdin: str | None = None) -> str:
+    result = subprocess.run(
+        [sys.executable, "-m", "mdlite", *args],
+        cwd=_REPO_ROOT,
+        input=stdin,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return result.stdout
+
+
+def test_cli_file_argument(tmp_path):
+    doc = tmp_path / "doc.md"
+    doc.write_text("# Title\n\nText\n", encoding="utf-8")
+    assert _run_cli(str(doc)) == "<h1>Title</h1>\n<p>Text</p>\n"
+
+
+def test_cli_file_argument_followed_by_newline(tmp_path):
+    doc = tmp_path / "doc.md"
+    doc.write_text("Hello", encoding="utf-8")
+    assert _run_cli(str(doc)) == "<p>Hello</p>\n"
+
+
+def test_cli_reads_stdin_without_file():
+    assert _run_cli(stdin="# T\nText") == "<h1>T</h1>\n<p>Text</p>\n"
+
+
+def test_cli_stdin_multiline_paragraph():
+    assert _run_cli(stdin="Hello\nworld") == "<p>Hello world</p>\n"
+
+
+def test_cli_escapes_html():
+    assert _run_cli(stdin="a < b & c") == "<p>a &lt; b &amp; c</p>\n"
+
+
+def test_cli_empty_input():
+    assert _run_cli(stdin="") == "\n"
+
+
+def test_cli_empty_file(tmp_path):
+    doc = tmp_path / "empty.md"
+    doc.write_text("", encoding="utf-8")
+    assert _run_cli(str(doc)) == "\n"
+
+
+def test_cli_too_many_arguments(tmp_path):
+    first = tmp_path / "a.md"
+    second = tmp_path / "b.md"
+    first.write_text("a", encoding="utf-8")
+    second.write_text("b", encoding="utf-8")
+    result = subprocess.run(
+        [sys.executable, "-m", "mdlite", str(first), str(second)],
+        cwd=_REPO_ROOT,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 2
+    assert "usage" in result.stderr
+    assert result.stdout == ""
