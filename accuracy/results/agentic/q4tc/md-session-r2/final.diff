+"""Tests for the mdlite package."""
+
+import mdlite
+from mdlite import to_html
+
+
+def test_empty_input():
+    assert to_html("") == ""
+
+
+def test_blank_lines_only():
+    assert to_html("   \n\n\t\n  ") == ""
+
+
+def test_single_line_paragraph():
+    assert to_html("Hello world") == "<p>Hello world</p>"
+
+
+def test_multiline_paragraph_joined_with_single_space():
+    assert to_html("Hello\nworld") == "<p>Hello world</p>"
+
+
+def test_paragraph_lines_are_stripped():
+    assert to_html("  Hello  \n\tworld\t") == "<p>Hello world</p>"
+
+
+def test_blank_lines_separate_blocks():
+    assert to_html("A\n\nB") == "<p>A</p>\n<p>B</p>"
+
+
+def test_multiple_blank_lines_collapse():
+    assert to_html("A\n\n\n\nB") == "<p>A</p>\n<p>B</p>"
+
+
+def test_headings_levels_1_to_6():
+    for level in range(1, 7):
+        hashes = "#" * level
+        assert to_html(f"{hashes} Title") == f"<h{level}>Title</h{level}>"
+
+
+def test_heading_is_a_block_of_its_own():
+    assert to_html("# A\n# B") == "<h1>A</h1>\n<h1>B</h1>"
+
+
+def test_heading_and_paragraph_without_blank_line():
+    assert to_html("# Title\ntext") == "<h1>Title</h1>\n<p>text</p>"
+
+
+def test_heading_with_empty_text():
+    assert to_html("# ") == "<h1></h1>"
+
+
+def test_heading_without_space_is_text():
+    assert to_html("#Title") == "<p>#Title</p>"
+
+
+def test_seven_hashes_is_text():
+    assert to_html("####### Title") == "<p>####### Title</p>"
+
+
+def test_lone_hash_is_text():
+    assert to_html("#") == "<p>#</p>"
+
+
+def test_indented_hash_is_text():
+    assert to_html(" # Title") == "<p># Title</p>"
+
+
+def test_escape_amp_lt_gt():
+    assert to_html("a & b < c > d") == "<p>a &amp; b &lt; c &gt; d</p>"
+
+
+def test_escape_in_heading():
+    assert to_html("# a & <b>") == "<h1>a &amp; &lt;b&gt;</h1>"
+
+
+def test_escape_double_escapes_ampersand():
+    assert to_html("&lt;") == "<p>&amp;lt;</p>"
+
+
+def test_no_trailing_newline():
+    assert to_html("A") == "<p>A</p>"
+    assert to_html("A\n\nB") == "<p>A</p>\n<p>B</p>"
+    assert not to_html("# T\nText").endswith("\n")
+
+
+def test_example_from_spec():
+    assert to_html("# Title\nSome\ntext\n\nMore") == (
+        "<h1>Title</h1>\n<p>Some text</p>\n<p>More</p>"
+    )
+
+
+def test_package_exposes_to_html():
+    assert mdlite.to_html is to_html
+
+
+# ---------------------------------------------------------------------------
+# Inline formatting
+# ---------------------------------------------------------------------------
+
+
+def test_bold():
+    assert to_html("a **bold** c") == "<p>a <strong>bold</strong> c</p>"
+
+
+def test_bold_in_heading():
+    assert to_html("# **bold** title") == "<h1><strong>bold</strong> title</h1>"
+
+
+def test_italic():
+    assert to_html("a *italic* c") == "<p>a <em>italic</em> c</p>"
+
+
+def test_italic_in_heading():
+    assert to_html("## *em* title") == "<h2><em>em</em> title</h2>"
+
+
+def test_multiple_markers():
+    assert to_html("**a** and *b*") == "<p><strong>a</strong> and <em>b</em></p>"
+
+
+def test_emphasis_nested_in_bold():
+    assert to_html("**a *b* c**") == "<p><strong>a <em>b</em> c</strong></p>"
+
+
+def test_bold_nested_in_italic():
+    assert to_html("*a **b** c*") == "<p><em>a <strong>b</strong> c</em></p>"
+
+
+def test_code_span():
+    assert to_html("a `code` b") == "<p>a <code>code</code> b</p>"
+
+
+def test_code_span_in_heading():
+    assert to_html("# `code`") == "<h1><code>code</code></h1>"
+
+
+def test_code_span_escapes_text():
+    assert to_html("`a < b & c`") == "<p><code>a &lt; b &amp; c</code></p>"
+
+
+def test_no_formatting_inside_code_span():
+    assert to_html("a `b * c` d") == "<p>a <code>b * c</code> d</p>"
+    assert to_html("`**x**`") == "<p><code>**x**</code></p>"
+
+
+def test_markers_do_not_pair_across_code_span():
+    assert to_html("a `* b *` c") == "<p>a <code>* b *</code> c</p>"
+
+
+def test_bold_across_code_span():
+    assert to_html("**a `b` c**") == "<p><strong>a <code>b</code> c</strong></p>"
+
+
+def test_space_adjacent_markers_stay_literal():
+    assert to_html("2 * 3 * 4") == "<p>2 * 3 * 4</p>"
+    # The adjacent stars are non-space flanked, so they pair into empty
+    # emphasis spans; the surrounding text is left alone.
+    assert to_html("** a **") == "<p><em></em> a <em></em></p>"
+
+
+def test_unpaired_markers_stay_literal():
+    assert to_html("*a") == "<p>*a</p>"
+    assert to_html("a*") == "<p>a*</p>"
+    assert to_html("**a") == "<p><em></em>a</p>"
+
+
+def test_escaping_combined_with_formatting():
+    assert to_html("**a & b**") == "<p><strong>a &amp; b</strong></p>"
+    assert to_html("*a < b*") == "<p><em>a &lt; b</em></p>"
+
+
+def test_formatting_in_multiline_paragraph():
+    assert to_html("a *b*\nc") == "<p>a <em>b</em> c</p>"
+    assert to_html("*a\nb*") == "<p><em>a b</em></p>"
+
+
+# ---------------------------------------------------------------------------
+# Lists
+# ---------------------------------------------------------------------------
+
+
+def test_unordered_list():
+    assert to_html("- a\n- b") == "<ul>\n<li>a</li>\n<li>b</li>\n</ul>"
+
+
+def test_ordered_list():
+    assert to_html("1. a\n2. b") == "<ol>\n<li>a</li>\n<li>b</li>\n</ol>"
+
+
+def test_ordered_list_multigit_numbers():
+    assert to_html("10. x\n11. y") == "<ol>\n<li>x</li>\n<li>y</li>\n</ol>"
+
+
+def test_single_item_list():
+    assert to_html("- a") == "<ul>\n<li>a</li>\n</ul>"
+
+
+def test_list_item_text_is_stripped():
+    assert to_html("-  a  \n-  b") == "<ul>\n<li>a</li>\n<li>b</li>\n</ul>"
+
+
+def test_empty_list_item():
+    assert to_html("- ") == "<ul>\n<li></li>\n</ul>"
+
+
+def test_item_without_space_is_text():
+    assert to_html("-a") == "<p>-a</p>"
+    assert to_html("*a") == "<p>*a</p>"
+    assert to_html("1.a") == "<p>1.a</p>"
+    assert to_html("1 a") == "<p>1 a</p>"
+
+
+def test_list_item_inline_formatting():
+    assert to_html("- **b** and *i*") == (
+        "<ul>\n<li><strong>b</strong> and <em>i</em></li>\n</ul>"
+    )
+    assert to_html("- `c`") == "<ul>\n<li><code>c</code></li>\n</ul>"
+
+
+def test_list_item_escaping():
+    assert to_html("- a < b & c") == "<ul>\n<li>a &lt; b &amp; c</li>\n</ul>"
+
+
+def test_star_space_line_is_now_a_list_item():
+    # "* " at line start is a list marker, so this used-to-be paragraph
+    # is now a list; the unpaired trailing star stays literal.
+    assert to_html("* a *") == "<ul>\n<li>a *</li>\n</ul>"
+
+
+def test_blank_line_separates_lists():
+    assert to_html("- a\n\n- b") == (
+        "<ul>\n<li>a</li>\n</ul>\n<ul>\n<li>b</li>\n</ul>"
+    )
+
+
+def test_non_item_line_ends_list():
+    assert to_html("- a\ntext") == "<ul>\n<li>a</li>\n</ul>\n<p>text</p>"
+
+
+def test_item_of_other_kind_ends_list():
+    assert to_html("- a\n1. b") == (
+        "<ul>\n<li>a</li>\n</ul>\n<ol>\n<li>b</li>\n</ol>"
+    )
+
+
+def test_heading_ends_list():
+    assert to_html("- a\n# T") == "<ul>\n<li>a</li>\n</ul>\n<h1>T</h1>"
+
+
+def test_item_ends_paragraph():
+    assert to_html("text\n- item") == "<p>text</p>\n<ul>\n<li>item</li>\n</ul>"
+
+
+def test_list_between_paragraphs():
+    assert to_html("x\n\n- a\n\ny") == (
+        "<p>x</p>\n<ul>\n<li>a</li>\n</ul>\n<p>y</p>"
+    )
+
+
+# ---------------------------------------------------------------------------
+# Fenced code blocks
+# ---------------------------------------------------------------------------
+
+
+def test_simple_code_block():
+    assert to_html("```\ncode\n```") == "<pre><code>code</code></pre>"
+
+
+def test_code_block_with_language():
+    assert to_html("```python\nx = 1\n```") == (
+        '<pre><code class="language-python">x = 1</code></pre>'
+    )
+
+
+def test_code_block_multiline():
+    assert to_html("```\na\nb\n```") == "<pre><code>a\nb</code></pre>"
+
+
+def test_code_block_keeps_blank_lines_and_indentation():
+    assert to_html("```\n\n    a\n\n```") == "<pre><code>\n    a\n</code></pre>"
+
+
+def test_code_block_escapes():
+    assert to_html("```\na < b & c\n```") == "<pre><code>a &lt; b &amp; c</code></pre>"
+
+
+def test_no_formatting_inside_code_block():
+    assert to_html("```\n**b** *i* `c`\n```") == "<pre><code>**b** *i* `c`</code></pre>"
+
+
+def test_unclosed_code_block_runs_to_end():
+    assert to_html("```\na\nb") == "<pre><code>a\nb</code></pre>"
+
+
+def test_unclosed_code_block_with_trailing_newline():
+    assert to_html("```\na\n") == "<pre><code>a</code></pre>"
+
+
+def test_empty_code_block():
+    assert to_html("```\n```") == "<pre><code></code></pre>"
+
+
+def test_only_exact_fence_closes_block():
+    # Neither four backticks nor a backtick line with a language is the
+    # exact closing fence, so both stay verbatim content.
+    assert to_html("```\n````\n```") == "<pre><code>````</code></pre>"
+    assert to_html("```\n```python\n```") == "<pre><code>```python</code></pre>"
+
+
+def test_fence_with_trailing_space_is_content():
+    assert to_html("```\n``` \n```") == "<pre><code>``` </code></pre>"
+
+
+def test_fence_ends_paragraph():
+    assert to_html("para\n```\ncode\n```") == (
+        "<p>para</p>\n<pre><code>code</code></pre>"
+    )
+
+
+def test_line_after_close_starts_paragraph():
+    assert to_html("```\ncode\n```\ntext") == (
+        "<pre><code>code</code></pre>\n<p>text</p>"
+    )
+
+
+def test_fence_ends_list():
+    assert to_html("- a\n```\nc\n```") == (
+        "<ul>\n<li>a</li>\n</ul>\n<pre><code>c</code></pre>"
+    )
+
+
+def test_list_after_code_block_without_blank_line():
+    assert to_html("```\nc\n```\n- x") == (
+        "<pre><code>c</code></pre>\n<ul>\n<li>x</li>\n</ul>"
+    )
+
+
+def test_code_block_between_blocks():
+    assert to_html("a\n\n```\nc\n```\n\nb") == (
+        "<p>a</p>\n<pre><code>c</code></pre>\n<p>b</p>"
+    )
+
+
+def test_block_syntax_inside_code_is_literal():
+    assert to_html("```\n# not a heading\n- not an item\n```") == (
+        "<pre><code># not a heading\n- not an item</code></pre>"
+    )
+
+
+def test_four_backticks_is_text():
+    # Not a fence (no exact ``` line), so it is a paragraph whose four
+    # backticks pair into two empty code spans (existing inline rule).
+    assert to_html("````") == "<p><code></code><code></code></p>"
+
