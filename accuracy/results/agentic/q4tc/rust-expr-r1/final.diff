+}
+
+// ---------------------------------------------------------------------------
+// Lexer
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Op {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Rem,
+    Pow,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+enum Tok {
+    Num(f64, usize),
+    Ident(String, usize),
+    Op(Op, usize),
+    LParen(usize),
+    RParen(usize),
+    Comma(usize),
+}
+
+impl Tok {
+    fn pos(&self) -> usize {
+        match self {
+            Tok::Num(_, p)
+            | Tok::Ident(_, p)
+            | Tok::Op(_, p)
+            | Tok::LParen(p)
+            | Tok::RParen(p)
+            | Tok::Comma(p) => *p,
+        }
+    }
+}
+
+struct Lexer<'a> {
+    bytes: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Lexer<'a> {
+    fn new(src: &'a str) -> Self {
+        Lexer { bytes: src.as_bytes(), pos: 0 }
+    }
+
+    /// Produces the next token, or `None` at end of input. Only
+    /// `UnexpectedChar` can be produced here; all other errors come from
+    /// the parser, so errors surface left to right as tokens are demanded.
+    fn next_token(&mut self) -> Result<Option<Tok>, Error> {
+        let n = self.bytes.len();
+        while self.pos < n && self.bytes[self.pos].is_ascii_whitespace() {
+            self.pos += 1;
+        }
+        if self.pos >= n {
+            return Ok(None);
+        }
+        let start = self.pos;
+        let b = self.bytes[self.pos];
+        let single = |op: Option<Op>| match op {
+            Some(op) => Tok::Op(op, start),
+            None => match b {
+                b'(' => Tok::LParen(start),
+                b')' => Tok::RParen(start),
+                _ => Tok::Comma(start),
+            },
+        };
+        match b {
+            b'(' => { self.pos += 1; Ok(Some(single(None))) }
+            b')' => { self.pos += 1; Ok(Some(single(None))) }
+            b',' => { self.pos += 1; Ok(Some(single(None))) }
+            b'+' => { self.pos += 1; Ok(Some(single(Some(Op::Add)))) }
+            b'-' => { self.pos += 1; Ok(Some(single(Some(Op::Sub)))) }
+            b'*' => { self.pos += 1; Ok(Some(single(Some(Op::Mul)))) }
+            b'/' => { self.pos += 1; Ok(Some(single(Some(Op::Div)))) }
+            b'%' => { self.pos += 1; Ok(Some(single(Some(Op::Rem)))) }
+            b'^' => { self.pos += 1; Ok(Some(single(Some(Op::Pow)))) }
+            _ if b.is_ascii_digit() || b == b'.' => {
+                let (val, end) = Self::read_number(self.bytes, start)?;
+                self.pos = end;
+                Ok(Some(Tok::Num(val, start)))
+            }
+            _ if b == b'_' || b.is_ascii_alphabetic() => {
+                let start = self.pos;
+                while self.pos < n && (self.bytes[self.pos] == b'_'
+                    || self.bytes[self.pos].is_ascii_alphabetic()
+                    || self.bytes[self.pos].is_ascii_digit())
+                {
+                    self.pos += 1;
+                }
+                let name: String = self.bytes[start..self.pos].iter().map(|&c| c as char).collect();
+                Ok(Some(Tok::Ident(name, start)))
+            }
+            _ => Err(Error::UnexpectedChar(start)),
+        }
+    }
+
+    /// Reads a number starting at `at` (a digit or `.`) and returns its value
+    /// and the position just past it. A number is digits, an optional
+    /// fraction (a `.` only counts when followed by digits) and an optional
+    /// well-formed exponent (`e`/`E`, optional sign, at least one digit).
+    /// A lone `.` (no digits at all) can't start a token.
+    fn read_number(bytes: &[u8], at: usize) -> Result<(f64, usize), Error> {
+        let n = bytes.len();
+        let mut pos = at;
+        let mut seen_digit = false;
+        while pos < n && bytes[pos].is_ascii_digit() {
+            pos += 1;
+            seen_digit = true;
+        }
+        if pos < n && bytes[pos] == b'.' && pos + 1 < n && bytes[pos + 1].is_ascii_digit() {
+            pos += 1;
+            while pos < n && bytes[pos].is_ascii_digit() {
+                pos += 1;
+                seen_digit = true;
+            }
+        }
+        if pos < n && (bytes[pos] == b'e' || bytes[pos] == b'E') {
+            let mut q = pos + 1;
+            if q < n && (bytes[q] == b'+' || bytes[q] == b'-') {
+                q += 1;
+            }
+            if q < n && bytes[q].is_ascii_digit() {
+                pos = q;
+                while pos < n && bytes[pos].is_ascii_digit() {
+                    pos += 1;
+                }
+            }
+        }
+        if !seen_digit {
+            return Err(Error::UnexpectedChar(at));
+        }
+        let text: String = bytes[at..pos].iter().map(|&c| c as char).collect();
+        let val: f64 = text.parse().unwrap();
+        Ok((val, pos))
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Parser
+// ---------------------------------------------------------------------------
+
+#[derive(Debug)]
+enum Expr {
+    Num(f64),
+    Var(String),
+    Call(String, Vec<Expr>),
+    Neg(Box<Expr>),
+    Bin(Op, Box<Expr>, Box<Expr>),
+}
+
+struct Parser<'a> {
+    lexer: Lexer<'a>,
+    vars: &'a HashMap<String, f64>,
+    peeked: Option<Tok>,
+}
+
+impl<'a> Parser<'a> {
+    fn new(src: &'a str, vars: &'a HashMap<String, f64>) -> Self {
+        Parser { lexer: Lexer::new(src), vars, peeked: None }
+    }
+
+    /// Returns the next token without consuming it, lexing on demand so that
+    /// errors surface left to right.
+    fn peek(&mut self) -> Result<Option<Tok>, Error> {
+        if self.peeked.is_none() {
+            self.peeked = self.lexer.next_token()?;
+        }
+        Ok(self.peeked.clone())
+    }
+
+    fn advance(&mut self) -> Result<Option<Tok>, Error> {
+        let t = self.peek()?;
+        self.peeked = None;
+        Ok(t)
+    }
+
+    /// Parses the whole expression and rejects trailing tokens.
+    fn finish(&mut self, e: Expr) -> Result<f64, Error> {
+        match self.peek()? {
+            Some(t) => Err(Error::UnexpectedToken(t.pos())),
+            None => eval_expr(&e, self.vars),
+        }
+    }
+
+    // expr := additive
+    fn parse_expr(&mut self) -> Result<Expr, Error> {
+        self.parse_additive()
+    }
+
+    // additive := multiplicative ((+|-) multiplicative)*   (left assoc)
+    fn parse_additive(&mut self) -> Result<Expr, Error> {
+        let mut left = self.parse_multiplicative()?;
+        loop {
+            match self.peek()? {
+                Some(Tok::Op(Op::Add, _)) | Some(Tok::Op(Op::Sub, _)) => {
+                    let op = match self.advance()?.as_ref().unwrap() {
+                        Tok::Op(o, _) => *o,
+                        _ => unreachable!(),
+                    };
+                    let right = self.parse_multiplicative()?;
+                    left = Expr::Bin(op, Box::new(left), Box::new(right));
+                }
+                _ => break,
+            }
+        }
+        Ok(left)
+    }
+
+    // multiplicative := unary (('*'|'/'|'%') unary)*   (left assoc)
+    fn parse_multiplicative(&mut self) -> Result<Expr, Error> {
+        let mut left = self.parse_unary()?;
+        loop {
+            match self.peek()? {
+                Some(Tok::Op(Op::Mul, _))
+                | Some(Tok::Op(Op::Div, _))
+                | Some(Tok::Op(Op::Rem, _)) => {
+                    let op = match self.advance()?.as_ref().unwrap() {
+                        Tok::Op(o, _) => *o,
+                        _ => unreachable!(),
+                    };
+                    let right = self.parse_unary()?;
+                    left = Expr::Bin(op, Box::new(left), Box::new(right));
+                }
+                _ => break,
+            }
+        }
+        Ok(left)
+    }
+
+    // unary := ('-'|'+')* power    (signs repeat: --2 == 2)
+    fn parse_unary(&mut self) -> Result<Expr, Error> {
+        let mut negs = 0usize;
+        loop {
+            match self.peek()? {
+                Some(Tok::Op(Op::Sub, _)) => { self.advance()?; negs += 1; }
+                Some(Tok::Op(Op::Add, _)) => { self.advance()?; }
+                _ => break,
+            }
+        }
+        let base = self.parse_power()?;
+        if negs % 2 == 1 {
+            Ok(Expr::Neg(Box::new(base)))
+        } else {
+            Ok(base)
+        }
+    }
+
+    // power := primary ('^' unary)?   (right assoc; '^' binds tighter than
+    // unary minus, and the exponent is a unary expression)
+    fn parse_power(&mut self) -> Result<Expr, Error> {
+        let base = self.parse_primary()?;
+        if let Some(Tok::Op(Op::Pow, _)) = self.peek()? {
+            self.advance()?;
+            let exp = self.parse_unary()?;
+            Ok(Expr::Bin(Op::Pow, Box::new(base), Box::new(exp)))
+        } else {
+            Ok(base)
+        }
+    }
+
+    // primary := number | ident | ident '(' args ')' | '(' expr ')'
+    fn parse_primary(&mut self) -> Result<Expr, Error> {
+        match self.advance()?.ok_or(Error::UnexpectedEnd)? {
+            Tok::Num(v, _) => Ok(Expr::Num(v)),
+            Tok::Ident(name, _) => {
+                if matches!(self.peek()?, Some(Tok::LParen(_))) {
+                    self.advance()?; // '('
+                    let mut args = Vec::new();
+                    if !matches!(self.peek()?, Some(Tok::RParen(_))) {
+                        args.push(self.parse_expr()?);
+                        while matches!(self.peek()?, Some(Tok::Comma(_))) {
+                            self.advance()?; // ','
+                            args.push(self.parse_expr()?);
+                        }
+                    }
+                    match self.advance()?.ok_or(Error::UnexpectedEnd)? {
+                        Tok::RParen(_) => Ok(Expr::Call(name, args)),
+                        t => Err(Error::UnexpectedToken(t.pos())),
+                    }
+                } else {
+                    Ok(Expr::Var(name))
+                }
+            }
+            Tok::LParen(_) => {
+                let e = self.parse_expr()?;
+                match self.advance()?.ok_or(Error::UnexpectedEnd)? {
+                    Tok::RParen(_) => Ok(e),
+                    t => Err(Error::UnexpectedToken(t.pos())),
+                }
+            }
+            t => Err(Error::UnexpectedToken(t.pos())),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Evaluation
+// ---------------------------------------------------------------------------
+
+fn eval_expr(e: &Expr, vars: &HashMap<String, f64>) -> Result<f64, Error> {
+    match e {
+        Expr::Num(v) => Ok(*v),
+        Expr::Var(name) => {
+            vars.get(name).copied().ok_or_else(|| Error::UnknownVariable(name.clone()))
+        }
+        Expr::Neg(inner) => Ok(-eval_expr(inner, vars)?),
+        Expr::Bin(op, l, r) => {
+            let a = eval_expr(l, vars)?;
+            let b = eval_expr(r, vars)?;
+            match op {
+                Op::Add => Ok(a + b),
+                Op::Sub => Ok(a - b),
+                Op::Mul => Ok(a * b),
+                Op::Div => {
+                    if b == 0.0 { Err(Error::DivisionByZero) } else { Ok(a / b) }
+                }
+                Op::Rem => {
+                    if b == 0.0 { Err(Error::DivisionByZero) } else { Ok(a % b) }
+                }
+                Op::Pow => Ok(a.powf(b)),
+            }
+        }
+        Expr::Call(name, args) => eval_call(name, args, vars),
+    }
+}
+
+fn eval_call(name: &str, args: &[Expr], vars: &HashMap<String, f64>) -> Result<f64, Error> {
+    // The call site sits left of its arguments, so unknown-function and
+    // arity errors are reported before any errors inside the arguments.
+    let known = match name {
+        "abs" | "sqrt" => args.len() == 1,
+        "min" | "max" => !args.is_empty(),
+        _ => return Err(Error::UnknownFunction(name.to_owned())),
+    };
+    if !known {
+        return Err(Error::Arity(name.to_owned(), args.len()));
+    }
+    let vals: Result<Vec<f64>, Error> =
+        args.iter().map(|a| eval_expr(a, vars)).collect();
+    let vals = vals?;
+    match name {
+        "abs" => Ok(vals[0].abs()),
+        "sqrt" => Ok(vals[0].sqrt()),
+        "min" => Ok(vals.iter().copied().fold(f64::INFINITY, f64::min)),
+        "max" => Ok(vals.iter().copied().fold(f64::NEG_INFINITY, f64::max)),
+        _ => unreachable!(),
+    }
 }
