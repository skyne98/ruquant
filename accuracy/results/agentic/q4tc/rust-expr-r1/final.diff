@@ -0,0 +1,297 @@
+use calc::{eval, Error};
+use std::collections::HashMap;
+
+fn vars() -> HashMap<String, f64> {
+    HashMap::new()
+}
+
+fn with_vars(pairs: &[(&str, f64)]) -> HashMap<String, f64> {
+    pairs.iter().map(|(k, v)| (k.to_string(), *v)).collect()
+}
+
+fn ok(src: &str) -> f64 {
+    eval(src, &vars())
+        .unwrap_or_else(|e| panic!("{} failed with {:?}", src, e))
+}
+
+fn ok_vars(src: &str, vars: &HashMap<String, f64>) -> f64 {
+    eval(src, vars)
+        .unwrap_or_else(|e| panic!("{} failed with {:?}", src, e))
+}
+
+fn approx(src: &str, expected: f64) {
+    let got = ok(src);
+    assert!(
+        (got - expected).abs() < 1e-9,
+        "{}: got {}, expected {}",
+        src,
+        got,
+        expected
+    );
+}
+
+fn err(src: &str) -> Error {
+    match eval(src, &vars()) {
+        Ok(v) => panic!("{} unexpectedly succeeded with {}", src, v),
+        Err(e) => e,
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Number literals
+// ---------------------------------------------------------------------------
+
+#[test]
+fn number_literals() {
+    assert_eq!(ok("3"), 3.0);
+    assert_eq!(ok("3.25"), 3.25);
+    assert_eq!(ok(".5"), 0.5);
+    assert_eq!(ok("2e3"), 2000.0);
+    assert_eq!(ok("1.5E-2"), 0.015);
+    assert_eq!(ok("2E+3"), 2000.0);
+    assert_eq!(ok("1e2"), 100.0);
+    assert_eq!(ok("0.1"), 0.1);
+    assert_eq!(ok("10"), 10.0);
+}
+
+// ---------------------------------------------------------------------------
+// Operators, precedence and associativity
+// ---------------------------------------------------------------------------
+
+#[test]
+fn precedence_and_associativity() {
+    assert_eq!(ok("1 + 2 * 3"), 7.0);
+    assert_eq!(ok("2 + 3 * 4"), 14.0);
+    assert_eq!(ok("2 * 3 + 4"), 10.0);
+    assert_eq!(ok("8 / 4"), 2.0);
+    assert_eq!(ok("10 - 3 - 2"), 5.0); // left associative
+    assert_eq!(ok("100 / 10 / 2"), 5.0); // left associative
+    assert_eq!(ok("2 * 6 % 4"), 0.0);
+    assert_eq!(ok("9 % 4 * 3"), 3.0);
+    assert_eq!(ok("10 % 6 % 4"), 0.0);
+}
+
+#[test]
+fn remainder_sign_of_dividend() {
+    assert_eq!(ok("7 % 3"), 1.0);
+    assert_eq!(ok("-7 % 3"), -1.0);
+    assert_eq!(ok("7 % -3"), 1.0);
+    assert_eq!(ok("-7 % -3"), -1.0);
+}
+
+#[test]
+fn unary_signs() {
+    assert_eq!(ok("-2"), -2.0);
+    assert_eq!(ok("+2"), 2.0);
+    assert_eq!(ok("--2"), 2.0);
+    assert_eq!(ok("---2"), -2.0);
+    assert_eq!(ok("+-2"), -2.0);
+    assert_eq!(ok("-+2"), -2.0);
+    assert_eq!(ok("--5 * 2"), 10.0);
+    assert_eq!(ok("1 - -2"), 3.0);
+    assert_eq!(ok("1 - - 2"), 3.0);
+}
+
+#[test]
+fn power() {
+    assert_eq!(ok("-2^2"), -4.0); // ^ binds tighter than unary minus
+    assert_eq!(ok("2^-1"), 0.5); // the exponent is a unary expression
+    assert_eq!(ok("2^3^2"), 512.0); // right associative
+    assert_eq!(ok("-2^2^2"), -16.0); // -(2^(2^2)): unary minus stays outside
+    assert_eq!(ok("2^3*4"), 32.0); // ^ tighter than *
+    assert_eq!(ok("2*3^2"), 18.0);
+    assert_eq!(ok("8/2^3"), 1.0);
+    assert_eq!(ok("2^1/2"), 1.0);
+    approx("2^0.5 * 2^0.5", 2.0);
+    assert_eq!(ok("(-3)^2"), 9.0);
+    assert_eq!(ok("2^(1+1)"), 4.0);
+    approx("4^0.5", 2.0);
+    assert_eq!(ok("2^-2"), 0.25);
+}
+
+#[test]
+fn whitespace_is_ignored() {
+    assert_eq!(ok("  1+2  "), 3.0);
+    assert_eq!(ok("1\t+\n2"), 3.0);
+    assert_eq!(ok("1 - 2 * 3"), -5.0);
+    assert_eq!(ok("(( 1 ))"), 1.0);
+}
+
+// ---------------------------------------------------------------------------
+// Parentheses
+// ---------------------------------------------------------------------------
+
+#[test]
+fn parentheses() {
+    assert_eq!(ok("(1 + 2) * 3"), 9.0);
+    assert_eq!(ok("1 + (2 + 3)"), 6.0);
+    assert_eq!(ok("((1 + 2))"), 3.0);
+    assert_eq!(ok("2 * (3 - (4 - 3))"), 4.0);
+}
+
+// ---------------------------------------------------------------------------
+// Variables
+// ---------------------------------------------------------------------------
+
+#[test]
+fn variables() {
+    let v = with_vars(&[("x", 2.0), ("y", 3.0), ("x1_2", 5.0), ("_", -1.0)]);
+    assert_eq!(ok_vars("x * y", &v), 6.0);
+    assert_eq!(ok_vars("x + x", &v), 4.0);
+    assert_eq!(ok_vars("x1_2 + x", &v), 7.0);
+    assert_eq!(ok_vars("_", &v), -1.0);
+    assert_eq!(ok_vars("-x", &v), -2.0);
+    assert_eq!(ok_vars("max(x, y) * x1_2", &v), 15.0);
+    // an identifier not followed by '(' is a variable, even if it looks like a function
+    let v2 = with_vars(&[("sqrt", 9.0)]);
+    assert_eq!(ok_vars("sqrt", &v2), 9.0);
+}
+
+// ---------------------------------------------------------------------------
+// Functions
+// ---------------------------------------------------------------------------
+
+#[test]
+fn functions() {
+    assert_eq!(ok("abs(-5)"), 5.0);
+    assert_eq!(ok("abs(3 - 10)"), 7.0);
+    assert_eq!(ok("sqrt(16)"), 4.0);
+    approx("sqrt(2) * sqrt(2)", 2.0);
+    assert_eq!(ok("min(1, 2)"), 1.0);
+    assert_eq!(ok("max(1, 2)"), 2.0);
+    assert_eq!(ok("min(3)"), 3.0);
+    assert_eq!(ok("max(5)"), 5.0);
+    assert_eq!(ok("min(1, 2, 3, 4)"), 1.0);
+    assert_eq!(ok("max(4, 3, 2, 1)"), 4.0);
+    assert_eq!(ok("min(-1, -2)"), -2.0);
+    assert_eq!(ok("max(-1, -2)"), -1.0);
+    assert_eq!(ok("abs(sqrt(16))"), 4.0);
+    assert_eq!(ok("max(min(1, 2), 3)"), 3.0);
+    assert_eq!(ok("min( ( 1 ), 2 )"), 1.0);
+    assert_eq!(ok("-abs(-3)"), -3.0);
+    assert_eq!(ok("min(-1, 2)"), -1.0);
+    assert_eq!(ok_vars("max(x, 1) + y", &with_vars(&[("x", 2.0), ("y", 10.0)])), 12.0);
+}
+
+// ---------------------------------------------------------------------------
+// Errors: UnexpectedChar
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_char() {
+    assert_eq!(err("2 $ 3"), Error::UnexpectedChar(2));
+    assert_eq!(err("#5"), Error::UnexpectedChar(0));
+    assert_eq!(err("2 & 3"), Error::UnexpectedChar(2));
+    assert_eq!(err("1 @"), Error::UnexpectedChar(2));
+    assert_eq!(err("."), Error::UnexpectedChar(0));
+    // a later bad char does not shadow an earlier parse error
+    assert_eq!(err(") $"), Error::UnexpectedToken(0));
+}
+
+// ---------------------------------------------------------------------------
+// Errors: UnexpectedEnd
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_end() {
+    assert_eq!(err(""), Error::UnexpectedEnd);
+    assert_eq!(err("   "), Error::UnexpectedEnd);
+    assert_eq!(err("2 +"), Error::UnexpectedEnd);
+    assert_eq!(err("2 *"), Error::UnexpectedEnd);
+    assert_eq!(err("2 ^"), Error::UnexpectedEnd);
+    assert_eq!(err("(1"), Error::UnexpectedEnd);
+    assert_eq!(err("("), Error::UnexpectedEnd);
+    assert_eq!(err("min(1,"), Error::UnexpectedEnd);
+    assert_eq!(err("abs("), Error::UnexpectedEnd);
+    assert_eq!(err("1 + ("), Error::UnexpectedEnd);
+    assert_eq!(err("-"), Error::UnexpectedEnd);
+    assert_eq!(err("1 + 2 *"), Error::UnexpectedEnd);
+}
+
+// ---------------------------------------------------------------------------
+// Errors: UnexpectedToken
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_token() {
+    assert_eq!(err("2 3"), Error::UnexpectedToken(2));
+    assert_eq!(err(")"), Error::UnexpectedToken(0));
+    assert_eq!(err("(1))"), Error::UnexpectedToken(3));
+    assert_eq!(err(") 1"), Error::UnexpectedToken(0));
+    assert_eq!(err("1 + 2 3"), Error::UnexpectedToken(6));
+    assert_eq!(err("1 2 + 3"), Error::UnexpectedToken(2));
+    assert_eq!(err("((1)) 2"), Error::UnexpectedToken(6));
+    assert_eq!(err("1 (2)"), Error::UnexpectedToken(2));
+    assert_eq!(err("2 + 3)"), Error::UnexpectedToken(5));
+    // a trailing comma means a `)` where an expression was expected
+    assert_eq!(err("min(1,)"), Error::UnexpectedToken(6));
+    assert_eq!(err("min(1,,2)"), Error::UnexpectedToken(6));
+}
+
+// ---------------------------------------------------------------------------
+// Errors: evaluation (after the whole input has parsed)
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unknown_variable() {
+    assert_eq!(err("z"), Error::UnknownVariable("z".into()));
+    assert_eq!(err("1 + z * 2"), Error::UnknownVariable("z".into()));
+    assert_eq!(err("min(z, 1)"), Error::UnknownVariable("z".into()));
+    // a function name used without '(' is just a variable
+    assert_eq!(err("abs"), Error::UnknownVariable("abs".into()));
+}
+
+#[test]
+fn unknown_function() {
+    assert_eq!(err("foo(1)"), Error::UnknownFunction("foo".into()));
+    assert_eq!(err("foo()"), Error::UnknownFunction("foo".into()));
+    assert_eq!(err("min(1) + foo(2)"), Error::UnknownFunction("foo".into()));
+}
+
+#[test]
+fn arity() {
+    assert_eq!(err("abs()"), Error::Arity("abs".into(), 0));
+    assert_eq!(err("abs(1, 2)"), Error::Arity("abs".into(), 2));
+    assert_eq!(err("sqrt()"), Error::Arity("sqrt".into(), 0));
+    assert_eq!(err("sqrt(1, 2, 3)"), Error::Arity("sqrt".into(), 3));
+    assert_eq!(err("min()"), Error::Arity("min".into(), 0));
+    assert_eq!(err("max()"), Error::Arity("max".into(), 0));
+    assert_eq!(ok("min(1)"), 1.0); // sanity: 1 arg is fine
+}
+
+#[test]
+fn division_by_zero() {
+    assert_eq!(err("1 / 0"), Error::DivisionByZero);
+    assert_eq!(err("0 / 0"), Error::DivisionByZero);
+    assert_eq!(err("5 % 0"), Error::DivisionByZero);
+    assert_eq!(err("1 / (2 - 2)"), Error::DivisionByZero);
+    assert_eq!(ok("1 / 2.0"), 0.5); // non-zero divisor is fine
+    assert_eq!(ok("7 % 2"), 1.0);
+}
+
+// ---------------------------------------------------------------------------
+// Error ordering: parse errors first (left to right), then evaluation
+// ---------------------------------------------------------------------------
+
+#[test]
+fn error_ordering() {
+    // parse error at 0 wins over tokenization error at 2
+    assert_eq!(err(") $"), Error::UnexpectedToken(0));
+    // parse error before a later bad character
+    assert_eq!(err("2 3 $"), Error::UnexpectedToken(2));
+    // parse errors are reported before evaluation errors, even when the
+    // evaluation error textually comes first
+    assert_eq!(err("1 / 0 2"), Error::UnexpectedToken(6));
+    // `z (1` parses as the call `z(1` and ends early (like `min(1,`), so the
+    // parse error beats the `UnknownFunction("z")` that eval would report
+    assert_eq!(err("z (1"), Error::UnexpectedEnd);
+    // among evaluation errors, the leftmost is reported
+    assert_eq!(err("z + 1 / 0"), Error::UnknownVariable("z".into()));
+    assert_eq!(err("1 / 0 + z"), Error::DivisionByZero);
+    assert_eq!(err("min(1 / 0, 5)"), Error::DivisionByZero);
+    assert_eq!(err("min(1, 2) / 0"), Error::DivisionByZero);
+    // arity at the call site is left of anything inside the arguments
+    assert_eq!(err("abs(1 / 0, 2)"), Error::Arity("abs".into(), 2));
+    // unknown variable inside a well-arity'd call
+    assert_eq!(err("abs(z)"), Error::UnknownVariable("z".into()));
+}
