+    /// Allocates a node, reusing a freed one if possible, and stores the entry in it.
+    fn alloc_node(&mut self, key: K, value: V) -> usize {
+        match self.free.pop() {
+            Some(idx) => {
+                self.nodes[idx].key = Some(key);
+                self.nodes[idx].value = Some(value);
+                self.nodes[idx].prev = None;
+                self.nodes[idx].next = None;
+                idx
+            }
+            None => {
+                let idx = self.nodes.len();
+                self.nodes.push(Node {
+                    key: Some(key),
+                    value: Some(value),
+                    prev: None,
+                    next: None,
+                });
+                idx
+            }
+        }
+    }
+
+    /// Drops a node's contents and returns it to the free list.
+    fn free_node(&mut self, idx: usize) {
+        self.nodes[idx].key = None;
+        self.nodes[idx].value = None;
+        self.nodes[idx].prev = None;
+        self.nodes[idx].next = None;
+        self.free.push(idx);
+    }
+
+    /// Unlinks a node from the list, updating the head and tail as needed.
+    fn unlink(&mut self, idx: usize) {
+        let prev = self.nodes[idx].prev.take();
+        let next = self.nodes[idx].next.take();
+        if let Some(prev) = prev {
+            self.nodes[prev].next = next;
+        }
+        if let Some(next) = next {
+            self.nodes[next].prev = prev;
+        }
+        if self.head == Some(idx) {
+            self.head = next;
+        }
+        if self.tail == Some(idx) {
+            self.tail = prev;
+        }
+    }
+
+    /// Links a detached node as the new head (most recently used).
+    fn link_front(&mut self, idx: usize) {
+        let head = self.head;
+        self.nodes[idx].prev = None;
+        self.nodes[idx].next = head;
+        if let Some(head) = head {
+            self.nodes[head].prev = Some(idx);
+        }
+        self.head = Some(idx);
+        if self.tail.is_none() {
+            self.tail = Some(idx);
+        }
+    }
+
+    /// Moves a node to the front of the list, marking it as most recently used.
+    fn move_to_front(&mut self, idx: usize) {
+        if self.head != Some(idx) {
+            self.unlink(idx);
+            self.link_front(idx);
+        }
+    }
+
+    /// Removes the least recently used entry from the map and the list.
+    fn evict_lru(&mut self) {
+        let Some(tail) = self.tail else {
+            return;
+        };
+        let key = self
+            .nodes[tail]
+            .key
+            .take()
+            .expect("map and linked list stay in sync");
+        self.unlink(tail);
+        self.free_node(tail);
+        self.map.remove(&key);
+    }
+}
