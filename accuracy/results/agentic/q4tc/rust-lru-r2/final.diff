+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn new_cache_is_empty() {
+        let c: LruCache<u32, u32> = LruCache::new(4);
+        assert_eq!(c.capacity(), 4);
+        assert_eq!(c.len(), 0);
+        assert!(c.is_empty());
+        assert_eq!(c.iter().count(), 0);
+    }
+
+    #[test]
+    #[should_panic]
+    fn new_panics_on_zero_capacity() {
+        let _c: LruCache<u32, u32> = LruCache::new(0);
+    }
+
+    #[test]
+    fn put_and_get() {
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
+        assert_eq!(c.put(1, 10), None);
+        assert_eq!(c.get(&1), Some(&10));
+        assert_eq!(c.get(&2), None);
+        assert_eq!(c.len(), 1);
+        assert!(!c.is_empty());
+    }
+
+    #[test]
+    fn put_replaces_existing_value() {
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
+        c.put(1, 10);
+        assert_eq!(c.put(1, 20), Some(10));
+        assert_eq!(c.get(&1), Some(&20));
+        assert_eq!(c.len(), 1);
+    }
+
+    #[test]
+    fn put_evicts_least_recently_used() {
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
+        c.put(1, 10);
+        c.put(2, 20);
+        assert_eq!(c.put(3, 30), None);
+        assert_eq!(c.get(&1), None);
+        assert_eq!(c.get(&2), Some(&20));
+        assert_eq!(c.get(&3), Some(&30));
+        assert_eq!(c.len(), 2);
+    }
+
+    #[test]
+    fn get_refreshes_recency() {
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
+        c.put(1, 10);
+        c.put(2, 20);
+        assert_eq!(c.get(&1), Some(&10));
+        c.put(3, 30); // evicts 2, not 1
+        assert_eq!(c.get(&2), None);
+        assert_eq!(c.get(&1), Some(&10));
+        assert_eq!(c.get(&3), Some(&30));
+    }
+
+    #[test]
+    fn put_refreshes_recency_of_existing_key() {
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
