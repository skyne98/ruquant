+    #[test]
+    fn fuzz_against_reference_model() {
+        // Reference model: a Vec of (key, value) where index 0 is the least recently used entry.
+        const CAP: usize = 3;
+        let mut model: Vec<(u32, u32)> = Vec::new();
+        let mut cache: LruCache<u32, u32> = LruCache::new(CAP);
+        let mut seed: u64 = 0x9e37_79b9_7f4a_7c15;
+        let mut rnd = || {
+            seed = seed
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            (seed >> 33) as u32
+        };
+        for _ in 0..20_000 {
+            let k = rnd() % 8;
+            match rnd() % 6 {
+                0 | 1 => {
+                    // put
+                    let v = k * 7 + rnd() % 100;
+                    if let Some(pos) = model.iter().position(|(mk, _)| *mk == k) {
+                        model.remove(pos);
+                    } else if model.len() == cache.capacity() {
+                        model.remove(0);
+                    }
+                    model.push((k, v));
+                    cache.put(k, v);
+                }
+                2 => {
+                    // get
+                    if let Some(pos) = model.iter().position(|(mk, _)| *mk == k) {
+                        let entry = model.remove(pos);
+                        model.push(entry);
+                    }
+                    let want = model.last().filter(|(mk, _)| *mk == k).map(|(_, v)| *v);
+                    assert_eq!(cache.get(&k).map(|v| *v), want);
+                }
+                3 => {
+                    // peek
+                    let want = model.iter().rev().find(|(mk, _)| *mk == k).map(|(_, v)| *v);
+                    assert_eq!(cache.peek(&k).map(|v| *v), want);
+                }
+                4 => {
+                    // remove
+                    let want = model
+                        .iter()
+                        .position(|(mk, _)| *mk == k)
+                        .map(|pos| model.remove(pos).1);
+                    assert_eq!(cache.remove(&k), want);
+                }
+                5 => {
+                    if rnd() % 4 == 0 {
+                        // pop_lru
+                        let want = model.first().map(|(mk, v)| (*mk, *v)).map(|entry| {
+                            model.remove(0);
+                            entry
+                        });
+                        assert_eq!(cache.pop_lru(), want);
+                    } else {
+                        // resize
+                        let new_cap = 1 + (rnd() % 5) as usize;
+                        while model.len() > new_cap {
+                            model.remove(0);
+                        }
+                        cache.resize(new_cap);
+                    }
+                }
+                _ => unreachable!(),
+            }
+            assert_eq!(cache.len(), model.len());
+            let got: Vec<(u32, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+            let want: Vec<(u32, u32)> = model.iter().rev().cloned().collect();
+            assert_eq!(got, want);
+        }
     }
