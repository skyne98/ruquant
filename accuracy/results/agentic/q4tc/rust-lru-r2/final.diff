+        c.put(2, 20);
+        c.put(1, 11);
+        c.put(3, 30); // evicts 2
+        assert_eq!(c.get(&2), None);
+        assert_eq!(c.get(&1), Some(&11));
+    }
+
+    #[test]
+    fn get_mut_mutates_and_refreshes() {
+        let mut c: LruCache<u32, Vec<u32>> = LruCache::new(2);
+        c.put(1, vec![1]);
+        c.put(2, vec![2]);
+        c.get_mut(&1).unwrap().push(99);
+        c.put(3, vec![3]); // evicts 2
+        assert!(c.get(&2).is_none());
+        assert_eq!(c.get(&1), Some(&vec![1, 99]));
+        assert_eq!(c.get_mut(&4), None);
+    }
+
