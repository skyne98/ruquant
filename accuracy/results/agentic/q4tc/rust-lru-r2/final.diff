 //! A least-recently-used cache with a fixed capacity.
 
+use std::collections::HashMap;
 use std::hash::Hash;
 
 /// A map that holds at most `capacity` entries. When a new key is inserted into a full cache, the least recently
 /// used entry is evicted. `get` and `put` count as uses; `peek` does not.
 ///
 /// All operations except `iter` and `resize` are O(1) on average.
+///
+/// Internally this is a hash map from keys to node indices plus a doubly linked list of nodes (also indexed)
+/// that keeps entries in recency order: the head is the most recently used entry, the tail the least recently
+/// used one. Node indices are recycled through a free list, so every operation is O(1) on average without any
+/// linear scans.
 pub struct LruCache<K, V> {
-    _marker: std::marker::PhantomData<(K, V)>,
+    map: HashMap<K, usize>,
+    nodes: Vec<Node<K, V>>,
+    free: Vec<usize>,
+    head: Option<usize>,
+    tail: Option<usize>,
+    capacity: usize,
+}
+
+struct Node<K, V> {
+    key: Option<K>,
+    value: Option<V>,
+    prev: Option<usize>,
+    next: Option<usize>,
+}
+
+/// Iterator over the cache entries, from the most recently used to the least recently used one.
+struct Iter<'a, K, V> {
+    nodes: &'a [Node<K, V>],
+    cur: Option<usize>,
+}
+
+impl<'a, K, V> Iterator for Iter<'a, K, V> {
+    type Item = (&'a K, &'a V);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let idx = self.cur?;
+        let node = &self.nodes[idx];
+        let key = node.key.as_ref()?;
+        let value = node.value.as_ref()?;
+        self.cur = node.next;
+        Some((key, value))
+    }
 }
 
 impl<K: Hash + Eq + Clone, V> LruCache<K, V> {
