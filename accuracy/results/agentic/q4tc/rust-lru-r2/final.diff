+    #[test]
+    fn repeated_eviction_and_reinsertion() {
+        // Cycles of eviction, removal, and reinsertion must not corrupt the list.
+        let mut c: LruCache<u32, u32> = LruCache::new(2);
+        for i in 0..20 {
+            c.put(i % 3, i);
+            if i % 4 == 0 {
+                let _ = c.remove(&0);
+            }
+            if i % 5 == 0 {
+                let _ = c.pop_lru();
+            }
+            assert_eq!(c.iter().count(), c.len());
+            assert!(c.len() <= c.capacity());
+        }
+        let items: Vec<(u32, u32)> = c.iter().map(|(k, v)| (*k, *v)).collect();
+        // Every key maps to the same value it was last inserted with.
+        for (k, v) in &items {
+            assert_eq!(*v % 3, *k % 3);
+        }
+    }
