+def test_bulk_discount_charged_once():
+    # 12 x $2.50 = $30.00 gross; 10% bulk off = $3.00; charged $27.00.
+    o = Order("eve")
+    o.add(NOTEBOOK, 12)
+    assert total(o) == 2700
+
+
+def test_receipt_adds_up_with_bulk_discount():
+    # The bulk discount must appear exactly once, on its own line, and the
+    # line item / subtotal must be gross so line + subtotal - discount = total.
+    o = Order("eve")
+    o.add(NOTEBOOK, 12)
+    text = receipt(o)
+    assert text.count("Bulk discount") == 1
+    assert "12 x Notebook" in text
+    assert text.count("$30.00") == 2  # line item and subtotal, before discount
+    assert "-$3.00" in text
+    assert text.count("$27.00") == 1  # total, charged once
