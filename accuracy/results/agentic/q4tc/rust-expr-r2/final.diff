+// ---------------------------------------------------------------------------
+// Tokenizer
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum Tok {
+    Num(f64, usize),
+    Ident(String, usize),
+    Op(char, usize), // + - * / % ^
+    LParen(usize),
+    RParen(usize),
+    Comma(usize),
+}
+
+impl Tok {
+    fn pos(&self) -> usize {
+        match self {
+            Tok::Num(_, p)
+            | Tok::Ident(_, p)
+            | Tok::Op(_, p)
+            | Tok::LParen(p)
+            | Tok::RParen(p)
+            | Tok::Comma(p) => *p,
+        }
+    }
+}
+
+fn tokenize(src: &str) -> Result<Vec<Tok>, Error> {
+    let b = src.as_bytes();
+    let mut toks = Vec::new();
+    let mut i = 0usize;
+    while i < b.len() {
+        match b[i] {
+            b' ' | b'\t' | b'\n' | b'\r' => i += 1,
+            b'(' => {
+                toks.push(Tok::LParen(i));
+                i += 1;
+            }
+            b')' => {
+                toks.push(Tok::RParen(i));
+                i += 1;
+            }
+            b',' => {
+                toks.push(Tok::Comma(i));
+                i += 1;
+            }
+            c if c == b'+' || c == b'-' || c == b'*' || c == b'/' || c == b'%' || c == b'^' => {
+                toks.push(Tok::Op(c as char, i));
+                i += 1;
+            }
+            b'.' if i + 1 < b.len() && b[i + 1].is_ascii_digit() => {
+                // Number of the form `.5[exponent]`.
+                let end = number_end(b, i);
+                toks.push(Tok::Num(parse_num(b, i, end), i));
+                i = end;
+            }
+            c if c.is_ascii_digit() => {
+                let end = number_end(b, i);
+                toks.push(Tok::Num(parse_num(b, i, end), i));
+                i = end;
+            }
+            c if c.is_ascii_alphabetic() || c == b'_' => {
+                let start = i;
+                i += 1;
+                while i < b.len() && (b[i].is_ascii_alphanumeric() || b[i] == b'_') {
+                    i += 1;
+                }
+                let name = std::str::from_utf8(&b[start..i]).unwrap().to_string();
+                toks.push(Tok::Ident(name, start));
+            }
+            _ => return Err(Error::UnexpectedChar(i)),
+        }
+    }
+    Ok(toks)
+}
+
+/// Given a byte slice where a number starts at `start` (either a digit or a
+/// `.` followed by a digit), return the index just past the end of the number.
+fn number_end(b: &[u8], start: usize) -> usize {
+    let mut i = start;
+    if b[i] != b'.' {
+        while i < b.len() && b[i].is_ascii_digit() {
+            i += 1;
+        }
+        // A fraction needs at least one digit after the dot.
+        if i < b.len() && b[i] == b'.' && i + 1 < b.len() && b[i + 1].is_ascii_digit() {
+            i += 1;
+            while i < b.len() && b[i].is_ascii_digit() {
+                i += 1;
+            }
+        }
+    } else {
+        // `.digits`
+        i += 1;
+        while i < b.len() && b[i].is_ascii_digit() {
+            i += 1;
+        }
+    }
+    // An exponent needs at least one digit (after an optional sign).
+    if i < b.len() && (b[i] == b'e' || b[i] == b'E') {
+        let mut k = i + 1;
+        if k < b.len() && (b[k] == b'+' || b[k] == b'-') {
+            k += 1;
+        }
+        if k < b.len() && b[k].is_ascii_digit() {
+            while k < b.len() && b[k].is_ascii_digit() {
+                k += 1;
+            }
+            i = k;
+        }
+    }
+    i
+}
+
+fn parse_num(b: &[u8], start: usize, end: usize) -> f64 {
+    let s = std::str::from_utf8(&b[start..end]).unwrap();
+    s.parse::<f64>().unwrap()
+}
+
+// ---------------------------------------------------------------------------
+// Parser / evaluator
+// ---------------------------------------------------------------------------
+
+enum Expr {
+    Num(f64),
+    Var(String),
+    Add(Box<Expr>, Box<Expr>),
+    Sub(Box<Expr>, Box<Expr>),
+    Mul(Box<Expr>, Box<Expr>),
+    Div(Box<Expr>, Box<Expr>),
+    Mod(Box<Expr>, Box<Expr>),
+    Pow(Box<Expr>, Box<Expr>),
+    Neg(Box<Expr>),
+    Pos(Box<Expr>),
+    Call(String, Vec<Expr>),
+}
+
+struct Parser {
+    toks: Vec<Tok>,
+    pos: usize,
+}
+
+impl Parser {
+    fn peek(&self) -> Option<&Tok> {
+        self.toks.get(self.pos)
+    }
+
+    /// The token after the current one (used to tell function calls from
+    /// variables).
+    fn peek2(&self) -> Option<&Tok> {
+        self.toks.get(self.pos + 1)
+    }
+
+    fn advance(&mut self) -> Option<Tok> {
+        let t = self.toks.get(self.pos).cloned();
+        if t.is_some() {
+            self.pos += 1;
+        }
+        t
+    }
+
+    fn expect_rparen(&mut self) -> Result<(), Error> {
+        match self.advance() {
+            Some(Tok::RParen(_)) => Ok(()),
+            None => Err(Error::UnexpectedEnd),
+            Some(t) => Err(Error::UnexpectedToken(t.pos())),
+        }
+    }
+
+    fn parse_args(&mut self) -> Result<Vec<Expr>, Error> {
+        let mut args = Vec::new();
+        if let Some(Tok::RParen(_)) = self.peek() {
+            self.advance();
+            return Ok(args);
+        }
+        loop {
+            args.push(self.parse_additive()?);
+            match self.peek() {
+                Some(Tok::Comma(_)) => {
+                    self.advance();
+                    continue;
+                }
+                _ => break,
+            }
+        }
+        self.expect_rparen()?;
+        Ok(args)
+    }
+
+    /// `+ -` binary, left associative (lowest precedence).
+    fn parse_additive(&mut self) -> Result<Expr, Error> {
+        let mut left = self.parse_multiplicative()?;
+        while let Some(Tok::Op(op, _)) = self.peek().cloned() {
+            match op {
+                '+' | '-' => {
+                    self.advance();
+                    let right = self.parse_multiplicative()?;
+                    left = if op == '+' {
+                        Expr::Add(Box::new(left), Box::new(right))
+                    } else {
+                        Expr::Sub(Box::new(left), Box::new(right))
+                    };
+                }
+                _ => break,
+            }
+        }
+        Ok(left)
+    }
+
+    /// `* / %` left associative.
+    fn parse_multiplicative(&mut self) -> Result<Expr, Error> {
+        let mut left = self.parse_unary()?;
+        while let Some(Tok::Op(op, _)) = self.peek().cloned() {
+            match op {
+                '*' | '/' | '%' => {
+                    self.advance();
+                    let right = self.parse_unary()?;
+                    left = match op {
+                        '*' => Expr::Mul(Box::new(left), Box::new(right)),
+                        '/' => Expr::Div(Box::new(left), Box::new(right)),
+                        _ => Expr::Mod(Box::new(left), Box::new(right)),
+                    };
+                }
+                _ => break,
+            }
+        }
+        Ok(left)
+    }
+
+    /// Unary `+`/`-`, repeatable (`--2` is 2).
+    fn parse_unary(&mut self) -> Result<Expr, Error> {
+        if let Some(Tok::Op(op, _)) = self.peek().cloned() {
+            if op == '+' || op == '-' {
+                self.advance();
+                let e = self.parse_unary()?;
+                return Ok(if op == '-' {
+                    Expr::Neg(Box::new(e))
+                } else {
+                    Expr::Pos(Box::new(e))
+                });
+            }
+        }
+        self.parse_power()
+    }
+
+    /// `^`, right associative, binds tighter than unary minus.
+    /// The exponent is a unary expression (`2^-1`).
+    fn parse_power(&mut self) -> Result<Expr, Error> {
+        let base = self.parse_primary()?;
+        if matches!(self.peek(), Some(Tok::Op('^', _))) {
+            self.advance();
+            let exp = self.parse_unary()?;
+            Ok(Expr::Pow(Box::new(base), Box::new(exp)))
+        } else {
+            Ok(base)
+        }
+    }
+
+    fn parse_primary(&mut self) -> Result<Expr, Error> {
+        let tok = match self.peek() {
+            Some(t) => t.clone(),
+            None => return Err(Error::UnexpectedEnd),
+        };
+        match tok {
+            Tok::Num(v, _) => {
+                self.advance();
+                Ok(Expr::Num(v))
+            }
+            Tok::Ident(name, _) => {
+                let is_call = matches!(self.peek2(), Some(Tok::LParen(_)));
+                self.advance();
+                if is_call {
+                    self.advance(); // consume `(`
+                    let args = self.parse_args()?;
+                    Ok(Expr::Call(name, args))
+                } else {
+                    Ok(Expr::Var(name))
+                }
+            }
+            Tok::LParen(_) => {
+                self.advance();
+                let e = self.parse_additive()?;
+                self.expect_rparen()?;
+                Ok(e)
+            }
+            t => Err(Error::UnexpectedToken(t.pos())),
+        }
+    }
+}
+
+fn eval_expr(e: &Expr, vars: &HashMap<String, f64>) -> Result<f64, Error> {
+    match e {
+        Expr::Num(v) => Ok(*v),
+        Expr::Var(name) => vars
+            .get(name)
+            .copied()
+            .ok_or(Error::UnknownVariable(name.clone())),
+        Expr::Add(l, r) => Ok(eval_expr(l, vars)? + eval_expr(r, vars)?),
+        Expr::Sub(l, r) => Ok(eval_expr(l, vars)? - eval_expr(r, vars)?),
+        Expr::Mul(l, r) => Ok(eval_expr(l, vars)? * eval_expr(r, vars)?),
+        Expr::Div(l, r) => {
+            let a = eval_expr(l, vars)?;
+            let d = eval_expr(r, vars)?;
+            if d == 0.0 {
+                return Err(Error::DivisionByZero);
+            }
+            Ok(a / d)
+        }
+        Expr::Mod(l, r) => {
+            let a = eval_expr(l, vars)?;
+            let d = eval_expr(r, vars)?;
+            if d == 0.0 {
+                return Err(Error::DivisionByZero);
+            }
+            Ok(a % d)
+        }
+        Expr::Pow(l, r) => Ok(eval_expr(l, vars)?.powf(eval_expr(r, vars)?)),
+        Expr::Neg(e) => Ok(-eval_expr(e, vars)?),
+        Expr::Pos(e) => Ok(eval_expr(e, vars)?),
+        Expr::Call(name, args) => {
+            let vals: Result<Vec<f64>, Error> =
+                args.iter().map(|a| eval_expr(a, vars)).collect();
+            call_fn(name, &vals?)
+        }
+    }
+}
+
+fn call_fn(name: &str, args: &[f64]) -> Result<f64, Error> {
+    match name {
+        "abs" => {
+            if args.len() != 1 {
+                return Err(Error::Arity("abs".into(), args.len()));
+            }
+            Ok(args[0].abs())
+        }
+        "sqrt" => {
+            if args.len() != 1 {
+                return Err(Error::Arity("sqrt".into(), args.len()));
+            }
+            Ok(args[0].sqrt())
+        }
+        "min" => {
+            if args.is_empty() {
+                return Err(Error::Arity("min".into(), 0));
+            }
+            let mut m = args[0];
+            for &a in &args[1..] {
+                m = m.min(a);
+            }
+            Ok(m)
+        }
+        "max" => {
+            if args.is_empty() {
+                return Err(Error::Arity("max".into(), 0));
+            }
+            let mut m = args[0];
+            for &a in &args[1..] {
+                m = m.max(a);
+            }
+            Ok(m)
+        }
+        _ => Err(Error::UnknownFunction(name.to_string())),
+    }
+}
+
 pub fn eval(src: &str, vars: &HashMap<String, f64>) -> Result<f64, Error> {
