+use calc::eval;
+use std::collections::HashMap;
+
+fn vars(pairs: &[(&str, f64)]) -> HashMap<String, f64> {
+    pairs
+        .iter()
+        .map(|(k, v)| (k.to_string(), *v))
+        .collect()
+}
+
+fn ok(src: &str, expected: f64) {
+    let got = eval(src, &vars(&[])).unwrap_or_else(|e| panic!("{src:?} => Err({e:?}), expected {expected}"));
+    assert!(
+        (got - expected).abs() < 1e-12,
+        "{src:?} => {got}, expected {expected}"
+    );
+}
+
+fn okv(src: &str, expected: f64, v: &[(&str, f64)]) {
+    let got = eval(src, &vars(v)).unwrap_or_else(|e| panic!("{src:?} => Err({e:?}), expected {expected}"));
+    assert!(
+        (got - expected).abs() < 1e-12,
+        "{src:?} => {got}, expected {expected}"
+    );
+}
+
+fn err(src: &str, expected: calc::Error) {
+    match eval(src, &vars(&[])) {
+        Err(e) => assert_eq!(e, expected, "error for {src:?}"),
+        Ok(v) => panic!("{src:?} => Ok({v}), expected {expected:?}"),
+    }
+}
+
+fn errv(src: &str, expected: calc::Error, v: &[(&str, f64)]) {
+    match eval(src, &vars(v)) {
+        Err(e) => assert_eq!(e, expected, "error for {src:?}"),
+        Ok(val) => panic!("{src:?} => Ok({val}), expected {expected:?}"),
+    }
+}
+
+// ---------------------------------------------------------------- numbers
+
+#[test]
+fn numbers() {
+    ok("3", 3.0);
+    ok("3.25", 3.25);
+    ok(".5", 0.5);
+    ok("2e3", 2000.0);
+    ok("1.5E-2", 0.015);
+    ok(".5e2", 50.0);
+    ok("2e3 + 1", 2001.0);
+    ok(".5 + .5", 1.0);
+    // A number can't start with `e`: `e3` is an identifier.
+    err("e3", calc::Error::UnknownVariable("e3".into()));
+}
+
+// ------------------------------------------------------------ unary / signs
+
+#[test]
+fn unary() {
+    ok("+2", 2.0);
+    ok("-2", -2.0);
+    ok("--2", 2.0);
+    ok("+-2", -2.0);
+    ok("-+2", -2.0);
+    ok("-(2 + 3)", -5.0);
+    ok("2 * -3", -6.0);
+    ok("1 - -2", 3.0);
+    ok("1 - --2", -1.0);
+    ok("2 * -3 ^ 2", -18.0);
+}
+
+// ------------------------------------------------------- precedence and ^
+
+#[test]
+fn precedence() {
+    ok("1 + 2 * 3", 7.0);
+    ok("10 - 4 / 2", 8.0);
+    ok("(1 + 2) * 3", 9.0);
+    ok("100 / 10 / 2", 5.0); // left associative
+    ok("100 - 10 - 2", 88.0); // left associative
+    ok("2 + 3 * 4 ^ 2", 50.0);
+    ok("2 * 3 ^ 2", 18.0);
+    ok("2 ^ 3 * 2", 16.0);
+    ok("2 + 3", 5.0);
+}
+
+#[test]
+fn power() {
+    // `^` binds tighter than unary minus.
+    ok("-2^2", -4.0);
+    ok("(-2)^2", 4.0);
+    // The exponent of `^` is a unary expression.
+    ok("2^-1", 0.5);
+    ok("2 ^ - 1", 0.5);
+    ok("2^-1 * 4", 2.0);
+    // `^` is right associative.
+    ok("2^3^2", 512.0);
+    ok("2^2^3", 256.0);
+}
+
+#[test]
+fn remainder() {
+    ok("10 % 3", 1.0);
+    ok("10 % -3", 1.0); // sign of the dividend (Rust's f64 %)
+    ok("-10 % 3", -1.0);
+    ok("-10 % -3", -1.0);
+    ok("2.5 % 2", 0.5);
+    ok("10 / -2", -5.0);
+    ok("2 % 4", 2.0);
+}
+
+// --------------------------------------------------------------- variables
+
+#[test]
+fn variables() {
+    okv("x + 1", 6.0, &[("x", 5.0)]);
+    okv("x * y - x", 14.0, &[("x", 2.0), ("y", 8.0)]);
+    okv("_1", 1.0, &[("_1", 1.0)]);
+    okv("x2 + x", 7.0, &[("x", 1.0), ("x2", 6.0)]);
+    // A function name without `(` is just a variable.
+    okv("abs", 9.0, &[("abs", 9.0)]);
+    errv("abs", calc::Error::UnknownVariable("abs".into()), &[]);
+}
+
+// --------------------------------------------------------------- functions
+
+#[test]
+fn functions() {
+    ok("abs(-5)", 5.0);
+    ok("abs(3 - 10)", 7.0);
+    ok("abs(0)", 0.0);
+    ok("sqrt(16)", 4.0);
+    ok("sqrt(2.0)", std::f64::consts::SQRT_2);
+    ok("sqrt(abs(-16))", 4.0);
+    ok("min(1, 2, 3)", 1.0);
+    ok("min(5)", 5.0);
+    ok("max(1, 5, 3)", 5.0);
+    ok("max(3)", 3.0);
+    ok("min(max(1, 2), 0)", 0.0);
+    ok("abs(min(-1, 2))", 1.0);
+    ok("min(1, 2) * max(3, 4)", 4.0);
+    ok("min(1, 2) + 3", 4.0);
+    // Whitespace is ignored, including between the name and `(`.
+    ok("min ( 1 , 2 )", 1.0);
+    ok("min(1,2)", 1.0);
+}
+
+// ------------------------------------------------------------------ errors
+
+#[test]
+fn unexpected_char() {
+    err("2 $ 3", calc::Error::UnexpectedChar(2));
+    err("$", calc::Error::UnexpectedChar(0));
+    err("3 . 2", calc::Error::UnexpectedChar(2));
+    err("1.", calc::Error::UnexpectedChar(1));
+    err(".", calc::Error::UnexpectedChar(0));
+    err("2 @", calc::Error::UnexpectedChar(2));
+    err("2 # 3", calc::Error::UnexpectedChar(2));
+}
+
+#[test]
+fn unexpected_end() {
+    err("", calc::Error::UnexpectedEnd);
+    err("   ", calc::Error::UnexpectedEnd);
+    err("2 +", calc::Error::UnexpectedEnd);
+    err("(1", calc::Error::UnexpectedEnd);
+    err("min(1,", calc::Error::UnexpectedEnd);
+    err("min(", calc::Error::UnexpectedEnd);
+    err("2 *", calc::Error::UnexpectedEnd);
+    err("1 -", calc::Error::UnexpectedEnd);
+    err("2 ^", calc::Error::UnexpectedEnd);
+    err("2 ^ +", calc::Error::UnexpectedEnd);
+    err("-", calc::Error::UnexpectedEnd);
+    err("1 +", calc::Error::UnexpectedEnd);
+    err("(1 +", calc::Error::UnexpectedEnd);
+    err("2 / 0 +", calc::Error::UnexpectedEnd); // syntax error beats DivisionByZero
+}
+
+#[test]
+fn unexpected_token() {
+    err("2 3", calc::Error::UnexpectedToken(2));
+    err(")", calc::Error::UnexpectedToken(0));
+    err("(1))", calc::Error::UnexpectedToken(3));
+    err("* 2", calc::Error::UnexpectedToken(0));
+    err("()", calc::Error::UnexpectedToken(1));
+    err("1 / 0 y", calc::Error::UnexpectedToken(6)); // syntax error before eval
+    err("2e", calc::Error::UnexpectedToken(1));
+    err("1e+", calc::Error::UnexpectedToken(1));
+}
+
+#[test]
+fn unknown_names() {
+    err("foo", calc::Error::UnknownVariable("foo".into()));
+    err("x", calc::Error::UnknownVariable("x".into()));
+    err("foo(1)", calc::Error::UnknownFunction("foo".into()));
+    err("foo(1, 2)", calc::Error::UnknownFunction("foo".into()));
+}
+
+#[test]
+fn arity() {
+    err("abs()", calc::Error::Arity("abs".into(), 0));
+    err("abs(1, 2)", calc::Error::Arity("abs".into(), 2));
+    err("sqrt()", calc::Error::Arity("sqrt".into(), 0));
+    err("sqrt(1, 2)", calc::Error::Arity("sqrt".into(), 2));
+    err("min()", calc::Error::Arity("min".into(), 0));
+    err("max()", calc::Error::Arity("max".into(), 0));
+}
+
+#[test]
+fn division_by_zero() {
+    err("1 / 0", calc::Error::DivisionByZero);
+    err("0 / 0", calc::Error::DivisionByZero);
+    err("1 % 0", calc::Error::DivisionByZero);
+    err("5 % 0", calc::Error::DivisionByZero);
+    errv("x / 0", calc::Error::UnknownVariable("x".into()), &[]); // left operand first
+    errv("1 / 0 + y", calc::Error::DivisionByZero, &[("y", 1.0)]);
+}
+
+// ------------------------------------------------- first error, left to right
+
+#[test]
+fn first_error_left_to_right() {
+    err("1/0 + 1/0", calc::Error::DivisionByZero);
+    errv("x + y", calc::Error::UnknownVariable("x".into()), &[("y", 1.0)]);
+    // Syntax errors are found while parsing, so they win over later eval errors.
+    err("1/0 x", calc::Error::UnexpectedToken(4));
+    errv("x 1/0", calc::Error::UnexpectedToken(2), &[("x", 1.0)]);
+}
