+def test_bulk_discount_applied_once():
+    """12 notebooks at $2.50: $30.00 gross, 10% bulk = $3.00 off, total $27.00."""
+    o = Order("erin")
+    o.add(NOTEBOOK, 12)
+    assert total(o) == 2700
+
+
+def test_receipt_adds_up():
+    """The bulk discount must count exactly once: subtotal - discounts == total,
+    and the receipt keeps its discount line."""
+    o = Order("erin")
+    o.add(NOTEBOOK, 12)
+    text = receipt(o)
+    assert text.count("Bulk discount (Notebook)") == 1
+    assert "$30.00" in text and "-$3.00" in text and "$27.00" in text
+    assert subtotal(o) == 3000
+    assert total(o) == subtotal(o) - sum(a for _, a in discounts(o))
