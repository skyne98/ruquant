+//! Tests for the expression language in SPEC.md.
+
+use calc::{eval, Error};
+use std::collections::HashMap;
+
+fn v(pairs: &[(&str, f64)]) -> HashMap<String, f64> {
+    pairs.iter().map(|(k, v)| (k.to_string(), *v)).collect()
+}
+
+macro_rules! ok {
+    ($src:literal, $want:expr) => {
+        assert_eq!(eval($src, &HashMap::new()), Ok($want), "eval({:?})", $src);
+    };
+    ($src:literal, $vars:expr, $want:expr) => {
+        assert_eq!(eval($src, &$vars), Ok($want), "eval({:?})", $src);
+    };
+}
+
+macro_rules! err {
+    ($src:literal, $e:expr) => {
+        assert_eq!(
+            eval($src, &HashMap::new()),
+            Err($e),
+            "eval({:?})",
+            $src
+        );
+    };
+    ($src:literal, $vars:expr, $e:expr) => {
+        assert_eq!(eval($src, &$vars), Err($e), "eval({:?})", $src);
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Numbers
+// ---------------------------------------------------------------------------
+
+#[test]
+fn numbers() {
+    ok!("3", 3.0);
+    ok!("3.25", 3.25);
+    ok!(".5", 0.5);
+    ok!("2e3", 2000.0);
+    ok!("1.5E-2", 0.015);
+    ok!("2e-3", 0.002);
+    ok!("2E+3", 2000.0);
+    ok!(".5e1", 5.0);
+    ok!("2.5e2", 250.0);
+    ok!("1E2", 100.0);
+}
+
+// ---------------------------------------------------------------------------
+// Whitespace
+// ---------------------------------------------------------------------------
+
+#[test]
+fn whitespace_is_ignored() {
+    ok!("1 + 2", 3.0);
+    ok!("  1+2  ", 3.0);
+    ok!("1\t+\n2", 3.0);
+    ok!("( 1 + 2 ) * 3", 9.0);
+}
+
+// ---------------------------------------------------------------------------
+// Precedence and associativity
+// ---------------------------------------------------------------------------
+
+#[test]
+fn precedence() {
+    ok!("1 + 2 * 3", 7.0);
+    ok!("2 * 3 + 4", 10.0);
+    ok!("1 + 2 * 3 ^ 2", 19.0);
+    ok!("2 + 3 * 4 - 6 / 2", 11.0);
+    ok!("2 * 3 ^ 2", 18.0);
+    ok!("2 ^ 3 * 2", 16.0);
+    ok!("100 / 10 / 5", 2.0); // left assoc
+    ok!("10 - 2 - 3", 5.0); // left assoc
+    ok!("8 / 4 / 2", 1.0); // left assoc
+}
+
+#[test]
+fn mod_sign_of_dividend() {
+    ok!("100 % 7", 2.0);
+    ok!("7.5 % 2", 1.5);
+    ok!("-7 % 5", -2.0);
+    ok!("7 % -5", 2.0);
+    ok!("-7.5 % 2", -1.5);
+}
+
+// ---------------------------------------------------------------------------
+// Unary
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unary() {
+    ok!("-2", -2.0);
+    ok!("+2", 2.0);
+    ok!("--2", 2.0);
+    ok!("---2", -2.0);
+    ok!("- - 2", 2.0);
+    ok!("2 * -3", -6.0);
+    ok!("-2 * 3", -6.0);
+    ok!("-(1 + 2)", -3.0);
+    ok!("+(-2)", -2.0);
+}
+
+// ---------------------------------------------------------------------------
+// Power
+// ---------------------------------------------------------------------------
+
+#[test]
+fn power() {
+    ok!("-2^2", -4.0);
+    ok!("2^-1", 0.5);
+    ok!("2^3^2", 512.0);
+    ok!("2^2^3", 256.0);
+    ok!("-4^2", -16.0);
+    ok!("(-2)^2", 4.0);
+    ok!("4^0.5", 2.0);
+    ok!("2^-2", 0.25);
+    ok!("2^-1^2", 0.5);
+    ok!("-2^2 * 3", -12.0);
+    ok!("2 - 2^2", -2.0);
+}
+
+// ---------------------------------------------------------------------------
+// Parentheses
+// ---------------------------------------------------------------------------
+
+#[test]
+fn parens() {
+    ok!("(1 + 2) * 3", 9.0);
+    ok!("((1))", 1.0);
+    ok!("(2)", 2.0);
+    ok!("(1 + 2) * (3 + 4)", 21.0);
+}
+
+// ---------------------------------------------------------------------------
+// Variables
+// ---------------------------------------------------------------------------
+
+#[test]
+fn variables() {
+    let vars = v(&[("x", 2.0), ("y", 3.0), ("_x", 10.0), ("a1", 7.0)]);
+    ok!("x + y", &vars, 5.0);
+    ok!("x * y", &vars, 6.0);
+    ok!("_x + a1", &vars, 17.0);
+    ok!("x^y", &vars, 8.0);
+    err!("z", &vars, Error::UnknownVariable("z".into()));
+    err!("x + z", &vars, Error::UnknownVariable("z".into()));
+}
+
+// ---------------------------------------------------------------------------
+// Functions
+// ---------------------------------------------------------------------------
+
+#[test]
+fn functions() {
+    ok!("abs(-3)", 3.0);
+    ok!("abs(3 - 10)", 7.0);
+    ok!("sqrt(4)", 2.0);
+    ok!("sqrt(2)", 2.0_f64.sqrt());
+    ok!("min(3, 1, 2)", 1.0);
+    ok!("max(3, 1, 2)", 3.0);
+    ok!("min(5)", 5.0);
+    ok!("max(5)", 5.0);
+    ok!("min(1, 2)", 1.0);
+    ok!("min(1 + 1, 2 * 2)", 2.0);
+    ok!("min(max(1, 2), 3)", 2.0);
+    ok!("max(min(9, 8), 7)", 8.0);
+    ok!("abs(-x)", v(&[("x", 5.0)]), 5.0);
+    ok!("min(x, x * 2)", v(&[("x", 3.0)]), 3.0);
+}
+
+#[test]
+fn unknown_function() {
+    err!("foo(1)", Error::UnknownFunction("foo".into()));
+    err!("foo()", Error::UnknownFunction("foo".into()));
+    // No `(` follows, so `foo` parses as a variable, not a function call.
+    err!("foo + 1", Error::UnknownVariable("foo".into()));
+}
+
+#[test]
+fn arity() {
+    err!("abs()", Error::Arity("abs".into(), 0));
+    err!("abs(1, 2)", Error::Arity("abs".into(), 2));
+    err!("sqrt(1, 2)", Error::Arity("sqrt".into(), 2));
+    err!("min()", Error::Arity("min".into(), 0));
+    err!("max()", Error::Arity("max".into(), 0));
+    // min/max with one or more args are fine:
+    ok!("min(1)", 1.0);
+    ok!("min(1, 2, 3, 4, 5)", 1.0);
+}
+
+// ---------------------------------------------------------------------------
+// Division by zero
+// ---------------------------------------------------------------------------
+
+#[test]
+fn division_by_zero() {
+    err!("1/0", Error::DivisionByZero);
+    err!("5%0", Error::DivisionByZero);
+    err!("0/0", Error::DivisionByZero);
+    err!("1/(2-2)", Error::DivisionByZero);
+    err!("1/(0.1 - 0.1)", Error::DivisionByZero);
+    // non-zero denominator is fine, even tiny:
+    ok!("1/0.1", 10.0);
+    // left-to-right: the division error is found before the unknown variable
+    err!("1/0 + x", v(&[("x", 1.0)]), Error::DivisionByZero);
+    // left-to-right: the unknown variable is found before the division error
+    err!("x + 1/0", Error::UnknownVariable("x".into()));
+}
+
+// ---------------------------------------------------------------------------
+// Tokenizer errors
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_char() {
+    err!("2 $ 3", Error::UnexpectedChar(2));
+    err!("2 @ 3", Error::UnexpectedChar(2));
+    err!("$", Error::UnexpectedChar(0));
+    err!("3.", Error::UnexpectedChar(1)); // `.` not followed by a digit
+    err!(".", Error::UnexpectedChar(0));
+    err!("3..4", Error::UnexpectedChar(1));
+    err!("1 - = 2", Error::UnexpectedChar(4));
+}
+
+// ---------------------------------------------------------------------------
+// Parser: end of input
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_end() {
+    err!("", Error::UnexpectedEnd);
+    err!("   ", Error::UnexpectedEnd);
+    err!("2 +", Error::UnexpectedEnd);
+    err!("2 *", Error::UnexpectedEnd);
+    err!("(1", Error::UnexpectedEnd);
+    err!("min(1,", Error::UnexpectedEnd);
+    err!("1 + (2", Error::UnexpectedEnd);
+    err!("2 ^", Error::UnexpectedEnd);
+    err!("-", Error::UnexpectedEnd);
+    err!("min(1, 2", Error::UnexpectedEnd);
+}
+
+// ---------------------------------------------------------------------------
+// Parser: misplaced tokens
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unexpected_token() {
+    err!("2 3", Error::UnexpectedToken(2));
+    err!(")", Error::UnexpectedToken(0));
+    err!("(1))", Error::UnexpectedToken(3));
+    err!("1 + 2 3", Error::UnexpectedToken(6));
+    err!("2e", Error::UnexpectedToken(1)); // `2` then identifier `e`
+    err!("1.5.5", Error::UnexpectedToken(3)); // `1.5` then `.5`
+    err!("(1) (2)", Error::UnexpectedToken(4));
+    err!("min(1 2)", Error::UnexpectedToken(6));
+    err!("min(1,)", Error::UnexpectedToken(6));
+    err!("1 2 + 3", Error::UnexpectedToken(2));
+    err!(", 1", Error::UnexpectedToken(0));
+    err!("* 1", Error::UnexpectedToken(0));
+}
+
+// ---------------------------------------------------------------------------
+// Error ordering: parse errors win over evaluation errors
+// ---------------------------------------------------------------------------
+
+#[test]
+fn parse_errors_come_first() {
+    // `x` is unknown, but the trailing token is a parse error that comes
+    // first, because it is detected while parsing.
+    err!("x 1/0", Error::UnexpectedToken(2));
+    err!("1/0 2", Error::UnexpectedToken(4));
+}
+
+// ---------------------------------------------------------------------------
+// Evaluation order within function calls
+// ---------------------------------------------------------------------------
+
+#[test]
+fn call_evaluation_order() {
+    // Unknown function name is reported before its arguments are evaluated.
+    err!("foo(1/0)", Error::UnknownFunction("foo".into()));
+    // Arity is reported before the argument error to its right.
+    err!("abs(1, 1/0)", Error::Arity("abs".into(), 2));
+    // Args are evaluated left to right.
+    err!("min(1/0, 2)", Error::DivisionByZero);
+    err!("min(2, x)", Error::UnknownVariable("x".into()));
+}
+
+// ---------------------------------------------------------------------------
+// Mixed
+// ---------------------------------------------------------------------------
+
+#[test]
