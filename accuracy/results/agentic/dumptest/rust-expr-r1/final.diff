+// ---------------------------------------------------------------------------
+// Tokens
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum Tok {
+    Num(f64),
+    Ident(String),
+    Op(char),
+}
+
+#[derive(Debug, Clone)]
+struct Token {
+    tok: Tok,
+    pos: usize,
+}
+
+fn is_ident_start(c: char) -> bool {
+    c.is_ascii_alphabetic() || c == '_'
+}
+
+fn is_ident_part(c: char) -> bool {
+    c.is_ascii_alphabetic() || c.is_ascii_digit() || c == '_'
+}
+
+/// Tokenizes `src`, or returns `UnexpectedChar` at the first bad byte offset.
+fn tokenize(src: &str) -> Result<Vec<Token>, Error> {
+    let cs: Vec<(usize, char)> = src.char_indices().collect();
+    let mut toks = Vec::new();
+    let mut i = 0;
+    while i < cs.len() {
+        let (pos, c) = cs[i];
+        if c.is_whitespace() {
+            i += 1;
+            continue;
+        }
+        match c {
+            '+' | '-' | '*' | '/' | '%' | '^' | '(' | ')' | ',' => {
+                toks.push(Token { tok: Tok::Op(c), pos });
+                i += 1;
+            }
+            _ if c.is_ascii_digit() => {
+                let (val, ni) = parse_number(&cs, i);
+                toks.push(Token { tok: Tok::Num(val), pos });
+                i = ni;
+            }
+            _ if c == '.' && i + 1 < cs.len() && cs[i + 1].1.is_ascii_digit() => {
+                let (val, ni) = parse_number(&cs, i);
+                toks.push(Token { tok: Tok::Num(val), pos });
+                i = ni;
+            }
+            _ if is_ident_start(c) => {
+                let mut j = i + 1;
+                while j < cs.len() && is_ident_part(cs[j].1) {
+                    j += 1;
+                }
+                let name: String = cs[i..j].iter().map(|&(_, ch)| ch).collect();
+                toks.push(Token { tok: Tok::Ident(name), pos });
+                i = j;
+            }
+            _ => return Err(Error::UnexpectedChar(pos)),
+        }
+    }
+    Ok(toks)
+}
+
+/// Parses a number starting at `i` (a digit, or `.` followed by a digit).
+/// Returns the value and the index just past the number.
+fn parse_number(cs: &[(usize, char)], mut i: usize) -> (f64, usize) {
+    let start = i;
+    if cs[i].1 == '.' {
+        i += 1;
+        while i < cs.len() && cs[i].1.is_ascii_digit() {
+            i += 1;
+        }
+    } else {
+        while i < cs.len() && cs[i].1.is_ascii_digit() {
+            i += 1;
+        }
+        // Fraction part: '.' followed by at least one digit.
+        if i < cs.len() && cs[i].1 == '.' && i + 1 < cs.len() && cs[i + 1].1.is_ascii_digit() {
+            i += 1;
+            while i < cs.len() && cs[i].1.is_ascii_digit() {
+                i += 1;
+            }
+        }
+    }
+    // Exponent part: `e`/`E`, optional sign, at least one digit.
+    if i < cs.len() && (cs[i].1 == 'e' || cs[i].1 == 'E') {
+        let mut j = i + 1;
+        if j < cs.len() && (cs[j].1 == '+' || cs[j].1 == '-') {
+            j += 1;
+        }
+        if j < cs.len() && cs[j].1.is_ascii_digit() {
+            i = j;
+            while i < cs.len() && cs[i].1.is_ascii_digit() {
+                i += 1;
+            }
+        }
+    }
+    let text: String = cs[start..i].iter().map(|&(_, ch)| ch).collect();
+    (text.parse().unwrap(), i)
+}
+
+// ---------------------------------------------------------------------------
+// AST
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum BinOp {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Mod,
+    Pow,
+}
+
+#[derive(Debug)]
+enum Expr {
+    Num(f64),
+    Var(String),
+    Call { name: String, args: Vec<Expr> },
+    Neg(Box<Expr>),
+    Bin { op: BinOp, l: Box<Expr>, r: Box<Expr> },
+}
+
+// ---------------------------------------------------------------------------
+// Parser
+// ---------------------------------------------------------------------------
+//
+// Grammar (lowest to highest precedence):
+//
+//   expr      := additive
+//   additive  := multiplicative (('+') | ('-')) multiplicative
+//   mult      := unary (('*') | ('/') | ('%')) unary
+//   unary     := ('+' | '-') unary | power
+//   power     := primary ('^' unary)?          (right associative)
+//   primary   := number | ident | ident '(' args ')' | '(' expr ')'
+//   args      := (expr (',' expr)*)?
+
+struct Parser {
+    toks: Vec<Token>,
+    i: usize,
+}
+
+impl Parser {
+    fn new(toks: Vec<Token>) -> Self {
+        Parser { toks, i: 0 }
+    }
+
+    fn peek(&self) -> Option<&Tok> {
+        self.toks.get(self.i).map(|t| &t.tok)
+    }
+
+    fn peek_pos(&self) -> usize {
+        self.toks[self.i].pos
+    }
+
+    fn peek_at(&self, k: usize) -> Option<&Tok> {
+        self.toks.get(self.i + k).map(|t| &t.tok)
+    }
+
+    fn bump(&mut self) {
+        self.i += 1;
+    }
+
+    fn at_end(&self) -> bool {
+        self.i >= self.toks.len()
+    }
+
+    fn parse_expr(&mut self) -> Result<Expr, Error> {
+        self.additive()
+    }
+
+    fn additive(&mut self) -> Result<Expr, Error> {
+        let mut l = self.mult()?;
+        loop {
+            match self.peek() {
+                Some(Tok::Op('+')) => {
+                    self.bump();
+                    let r = self.mult()?;
+                    l = Expr::Bin { op: BinOp::Add, l: Box::new(l), r: Box::new(r) };
+                }
+                Some(Tok::Op('-')) => {
+                    self.bump();
+                    let r = self.mult()?;
+                    l = Expr::Bin { op: BinOp::Sub, l: Box::new(l), r: Box::new(r) };
+                }
+                _ => return Ok(l),
+            }
+        }
+    }
+
+    fn mult(&mut self) -> Result<Expr, Error> {
+        let mut l = self.unary()?;
+        loop {
+            match self.peek() {
+                Some(Tok::Op('*')) => {
+                    self.bump();
+                    let r = self.unary()?;
+                    l = Expr::Bin { op: BinOp::Mul, l: Box::new(l), r: Box::new(r) };
+                }
+                Some(Tok::Op('/')) => {
+                    self.bump();
+                    let r = self.unary()?;
+                    l = Expr::Bin { op: BinOp::Div, l: Box::new(l), r: Box::new(r) };
+                }
+                Some(Tok::Op('%')) => {
+                    self.bump();
+                    let r = self.unary()?;
+                    l = Expr::Bin { op: BinOp::Mod, l: Box::new(l), r: Box::new(r) };
+                }
+                _ => return Ok(l),
+            }
+        }
+    }
+
+    fn unary(&mut self) -> Result<Expr, Error> {
+        match self.peek() {
+            Some(Tok::Op('+')) => {
+                self.bump();
+                self.unary()
+            }
+            Some(Tok::Op('-')) => {
+                self.bump();
+                let e = self.unary()?;
+                Ok(Expr::Neg(Box::new(e)))
+            }
+            _ => self.power(),
+        }
+    }
+
+    fn power(&mut self) -> Result<Expr, Error> {
+        let base = self.primary()?;
+        if matches!(self.peek(), Some(Tok::Op('^'))) {
+            self.bump();
+            let e = self.unary()?;
+            Ok(Expr::Bin { op: BinOp::Pow, l: Box::new(base), r: Box::new(e) })
+        } else {
+            Ok(base)
+        }
+    }
+
+    fn primary(&mut self) -> Result<Expr, Error> {
+        match self.peek() {
+            Some(Tok::Num(v)) => {
+                let v = *v;
+                self.bump();
+                Ok(Expr::Num(v))
+            }
+            Some(Tok::Ident(name)) => {
+                let name = name.clone();
+                self.bump();
+                if matches!(self.peek(), Some(Tok::Op('('))) {
+                    self.bump();
+                    let args = self.args()?;
+                    Ok(Expr::Call { name, args })
+                } else {
+                    Ok(Expr::Var(name))
+                }
+            }
+            Some(Tok::Op('(')) => {
+                self.bump();
+                let e = self.additive()?;
+                match self.peek() {
+                    Some(Tok::Op(')')) => {
+                        self.bump();
+                        Ok(e)
+                    }
+                    None => Err(Error::UnexpectedEnd),
+                    Some(_) => Err(Error::UnexpectedToken(self.peek_pos())),
+                }
+            }
+            None => Err(Error::UnexpectedEnd),
+            Some(_) => Err(Error::UnexpectedToken(self.peek_pos())),
+        }
+    }
+
+    fn args(&mut self) -> Result<Vec<Expr>, Error> {
+        let mut out = Vec::new();
+        if matches!(self.peek(), Some(Tok::Op(')'))) {
+            self.bump();
+            return Ok(out);
+        }
+        loop {
+            out.push(self.additive()?);
+            match self.peek() {
+                Some(Tok::Op(',')) => self.bump(),
+                Some(Tok::Op(')')) => {
+                    self.bump();
+                    return Ok(out);
+                }
+                None => return Err(Error::UnexpectedEnd),
+                Some(_) => return Err(Error::UnexpectedToken(self.peek_pos())),
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Evaluation
+// ---------------------------------------------------------------------------
+
 pub fn eval(src: &str, vars: &HashMap<String, f64>) -> Result<f64, Error> {
-    todo!()
+    let toks = tokenize(src)?;
+    let mut p = Parser::new(toks);
+    let ast = p.parse_expr()?;
+    if !p.at_end() {
+        return Err(Error::UnexpectedToken(p.peek_pos()));
+    }
+    eval_ast(&ast, vars)
+}
+
+fn eval_ast(e: &Expr, vars: &HashMap<String, f64>) -> Result<f64, Error> {
+    match e {
+        Expr::Num(v) => Ok(*v),
+        Expr::Var(name) => vars
+            .get(name)
+            .copied()
+            .ok_or_else(|| Error::UnknownVariable(name.clone())),
+        Expr::Call { name, args } => {
+            if !matches!(name.as_str(), "abs" | "sqrt" | "min" | "max") {
+                return Err(Error::UnknownFunction(name.clone()));
+            }
+            match name.as_str() {
+                "abs" | "sqrt" => {
+                    if args.len() != 1 {
+                        return Err(Error::Arity(name.clone(), args.len()));
+                    }
+                }
+                "min" | "max" => {
+                    if args.is_empty() {
+                        return Err(Error::Arity(name.clone(), 0));
+                    }
+                }
+                _ => unreachable!(),
+            }
+            let mut vals = Vec::with_capacity(args.len());
+            for a in args {
+                vals.push(eval_ast(a, vars)?);
+            }
+            match name.as_str() {
+                "abs" => Ok(vals[0].abs()),
+                "sqrt" => Ok(vals[0].sqrt()),
+                "min" => Ok(vals.iter().copied().fold(f64::INFINITY, f64::min)),
+                "max" => Ok(vals.iter().copied().fold(f64::NEG_INFINITY, f64::max)),
+                _ => unreachable!(),
+            }
+        }
+        Expr::Neg(inner) => {
+            let v = eval_ast(inner, vars)?;
+            Ok(-v)
+        }
+        Expr::Bin { op, l, r } => {
+            let lv = eval_ast(l, vars)?;
+            let rv = eval_ast(r, vars)?;
+            match op {
+                BinOp::Add => Ok(lv + rv),
+                BinOp::Sub => Ok(lv - rv),
+                BinOp::Mul => Ok(lv * rv),
+                BinOp::Div => {
+                    if rv == 0.0 {
+                        Err(Error::DivisionByZero)
+                    } else {
+                        Ok(lv / rv)
+                    }
+                }
+                BinOp::Mod => {
+                    if rv == 0.0 {
+                        Err(Error::DivisionByZero)
+                    } else {
+                        Ok(lv % rv)
+                    }
+                }
+                BinOp::Pow => Ok(lv.powf(rv)),
+            }
+        }
+    }
 }
